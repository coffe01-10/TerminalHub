<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures\grok-build-1.0.46-startup.vt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TerminalHub.Core\TerminalHub.Core.csproj" />
    <ProjectReference Include="..\..\src\TerminalHub.Pty\TerminalHub.Pty.csproj" />
    <ProjectReference Include="..\..\src\TerminalHub.App\TerminalHub.App.csproj" />
    <ProjectReference Include="..\..\examples\plugins\Minimal\Minimal.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\examples\plugins\CompactSidebar\CompactSidebar.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\examples\plugins\SessionPanel\SessionPanel.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyAcceptancePlugins" AfterTargets="Build">
    <ItemGroup>
      <AcceptancePlugin Include="..\..\examples\plugins\**\bin\$(Configuration)\net8.0\TerminalHub.Example.*.dll;..\..\examples\plugins\**\bin\$(Configuration)\net8.0\plugin.json" />
    </ItemGroup>
    <Copy SourceFiles="@(AcceptancePlugin)" DestinationFolder="$(OutDir)AcceptancePlugins\%(AcceptancePlugin.RecursiveDir)" />
  </Target>

</Project>
