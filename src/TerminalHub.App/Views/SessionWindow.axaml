<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:TerminalHub.App.Localization"
        xmlns:vm="using:TerminalHub.App.ViewModels"
        xmlns:ctl="using:TerminalHub.App.Controls"
        x:Class="TerminalHub.App.Views.SessionWindow"
        x:DataType="vm:SessionWindowViewModel"
        Title="{loc:Translate {Binding Title}}"
        Icon="avares://TerminalHub/Assets/terminal-hub-icon.ico"
        Width="860" Height="540" MinWidth="420" MinHeight="260"
        WindowStartupLocation="Manual"
        Background="{DynamicResource UiCanvas}"
        >

  <Grid RowDefinitions="42,*" Margin="8,6,8,8">

    <!-- Header: status dot + name + tag + return-to-main -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="4,0,4,4">
      <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource UiInk}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
        <TextBlock Text="{Binding Model.WorkingDirectory}" FontSize="10" Foreground="{DynamicResource UiMuted}"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Model.WorkingDirectory}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="{loc:Text M0784}" FontSize="10" Padding="10,2" CornerRadius="6"
                Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiAccent}" BorderThickness="1"
                Foreground="{DynamicResource UiInk}" VerticalAlignment="Center"
                Click="OnReturnClick"
                ToolTip.Tip="{loc:Text M0785}"/>
      </StackPanel>
    </Grid>

    <!-- Terminal viewport -->
    <Border Grid.Row="1" CornerRadius="8" Background="{DynamicResource UiCanvas}"
            BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" Padding="10,8" ClipToBounds="True">
      <Panel>
        <ctl:TerminalView x:Name="PopoutTerminal"
                          Emulator="{Binding Emulator}"
                          WorkingDirectory="{Binding Model.WorkingDirectory}" ShellCommand="{Binding Model.Shell}" IsRemote="{Binding Model.IsRemote}"
                          TerminalFontSize="{Binding FontSize}"
                          TerminalFontFamily="{Binding FontFamily}"/>
        <Button Content="{loc:Text M0496}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,6,6" Padding="10,4" CornerRadius="8" FontSize="10"
                Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiAccent}" BorderThickness="1"
                Foreground="{DynamicResource UiAccent}" Click="OnScrollToBottomClick"
                IsVisible="{Binding #PopoutTerminal.IsScrolledUp}"/>
        <ScrollBar Orientation="Vertical" Width="8" Opacity="0.5" Margin="0,0,1,0"
                   HorizontalAlignment="Right" VerticalAlignment="Stretch"
                   Minimum="0" Maximum="{Binding #PopoutTerminal.ScrollbackSize}"
                   ViewportSize="{Binding #PopoutTerminal.ViewportRows}"
                   Value="{Binding #PopoutTerminal.ScrollPosition, Mode=TwoWay}"
                   Visibility="{Binding #PopoutTerminal.OverlayScrollBarVisibility}"/>
      </Panel>
    </Border>
  </Grid>
</Window>
