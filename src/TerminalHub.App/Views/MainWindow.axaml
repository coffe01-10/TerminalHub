<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TerminalHub.App.ViewModels"
        xmlns:ctl="using:TerminalHub.App.Controls"
        xmlns:mon="using:TerminalHub.Core.Monitoring"
        xmlns:files="using:TerminalHub.Core.Files"
        xmlns:ssh="using:TerminalHub.Core.Ssh"
        xmlns:corepty="using:TerminalHub.Core.Pty"
        xmlns:settings="using:TerminalHub.Core.Settings"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="TerminalHub.App.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Title="Terminal Hub · 终端控制中心"
        Icon="avares://TerminalHub/Assets/terminal-hub-icon.ico"
        Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        Background="{DynamicResource UiCanvas}" FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="64">

  <Window.Resources>
    <StreamGeometry x:Key="ToolAdd">M7,2 H9 V7 H14 V9 H9 V14 H7 V9 H2 V7 H7 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolClose">M3,2 L8,7 L13,2 L14,3 L9,8 L14,13 L13,14 L8,9 L3,14 L2,13 L7,8 L2,3 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolBack">M7,2 L8.5,3.5 L5,7 H14 V9 H5 L8.5,12.5 L7,14 L1,8 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolForward">M9,2 L7.5,3.5 L11,7 H2 V9 H11 L7.5,12.5 L9,14 L15,8 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolRefresh">M13,2 V7 H8 L10,5 A4,4 0 1 0 12,9 H14 A6,6 0 1 1 11.5,3.5 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolSplit">M1,2 H15 V14 H1 Z M3,4 V12 H7 V4 Z M9,4 V12 H13 V4 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolPopout">M9,1 H15 V7 H13 V4.5 L7.5,10 L6,8.5 L11.5,3 H9 Z M1,4 H6 V6 H3 V13 H10 V10 H12 V15 H1 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolMore">M2,7 H4 V9 H2 Z M7,7 H9 V9 H7 Z M12,7 H14 V9 H12 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolOutput">M1,2 H15 V14 H1 Z M3,4 V9 H13 V4 Z M3,11 V12 H13 V11 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolSearch">M7,1 A6,6 0 1 0 7,13 A6,6 0 1 0 7,1 M7,3 A4,4 0 1 1 7,11 A4,4 0 1 1 7,3 M11,10 L16,15 L14.5,16.5 L9.5,11.5 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolTools">M5,1 H11 V4 H15 V14 H1 V4 H5 Z M6.5,2.5 V4 H9.5 V2.5 Z M2.5,5.5 V8 H6.5 V7 H9.5 V8 H13.5 V5.5 Z M2.5,9.5 V12.5 H13.5 V9.5 H9.5 V11 H6.5 V9.5 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolSettings">M6,1 H10 V3 L12,4 L14,3 L16,6 L14,8 L14,10 L16,12 L14,15 L12,14 L10,15 H6 L4,14 L2,15 L0,12 L2,10 V8 L0,6 L2,3 L4,4 L6,3 Z M8,5 A3,3 0 1 0 8,11 A3,3 0 1 0 8,5 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolWindow">M1,2 H15 V14 H1 Z M3,4 V12 H13 V4 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolMinimize">M2,7 H14 V9 H2 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolMonitor">M1,11 H4 V15 H1 Z M6,6 H9 V15 H6 Z M11,1 H14 V15 H11 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolSsh">M1,3 L6,8 L1,13 L2.5,14.5 L9,8 L2.5,1.5 Z M9,12 H15 V14 H9 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolLogs">M1,2 H15 V14 H1 Z M3,4 V5 H13 V4 Z M3,7 V8 H13 V7 Z M3,10 V12 H10 V10 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolDeploy">M1,8 L8,1 L15,8 L13.5,9.5 L9,5 V13 H7 V5 L2.5,9.5 Z M2,13 H4 V15 H12 V13 H14 V17 H2 Z</StreamGeometry>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button.terminal-tool">
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.terminal-tool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource UiRaised}"/>
      <Setter Property="Foreground" Value="{DynamicResource UiInk}"/>
    </Style>
    <Style Selector="Button.terminal-tool:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource UiInset}"/>
    </Style>
    <Style Selector="Button.terminal-tool:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="Button.terminal-tool.selected">
      <Setter Property="Background" Value="{DynamicResource UiRaised}"/>
      <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
    </Style>
    <Style Selector="Button.terminal-tool PathIcon">
      <Setter Property="Width" Value="14"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
    </Style>
    <Style Selector="Button.terminal-tool.selected PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
    </Style>
    <Style Selector="Button.terminal-tool:pointerover PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource UiInk}"/>
    </Style>
    <Style Selector="Button.dock PathIcon">
      <Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/>
      <Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
    </Style>
    <Style Selector="Button.dock.dock-active PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
    </Style>
    <Style Selector="TabControl#SettingsTabs TabItem">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style Selector="Border.settings-group">
      <Setter Property="Background" Value="{DynamicResource UiSurface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style Selector="TextBlock.settings-heading">
      <Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="5,6,0,0"/>
    </Style>
    <Style Selector="Border#SettingsPanel TextBox, Border#SettingsPanel ComboBox">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
  </Window.Styles>

  <Window.KeyBindings>
    <!-- Session shortcuts live in OnSessionShortcutKeyDown (tunnel handler) so bare
         Ctrl+letter control bytes keep reaching the PTY: app chords are Ctrl+Shift+*. -->
  </Window.KeyBindings>

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Panel>
    <ctl:WorkspaceBackdrop/>
    <Grid RowDefinitions="64,*,Auto,32">

      <!-- ============ Title bar ============ -->
      <Border Grid.Row="0" Background="Transparent" Padding="26,0" PointerPressed="OnTitleBarPointerPressed">
        <Grid ColumnDefinitions="Auto,*">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Image Source="avares://TerminalHub/Assets/terminal-hub-icon.png" Width="32" Height="32"/>
            <TextBlock Text="Terminal Hub" FontFamily="{DynamicResource HeadingFont}" Foreground="{DynamicResource UiInk}" FontSize="17"
                       FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="/   前台调度" Foreground="{DynamicResource UiMuted}" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                      Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="{Binding OsLabel}" Foreground="{DynamicResource UiFaint}" FontSize="11" VerticalAlignment="Center"/>
            <Button x:Name="PaletteButton" Classes="terminal-tool" Click="OnOpenPalette" ToolTip.Tip="命令面板 · 在快捷键设置中修改按键">
              <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource ToolSearch}"/><TextBlock Text="查找" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button Classes="terminal-tool" Classes.selected="{Binding OutputVisible}" Command="{Binding ToggleOutputCommand}" ToolTip.Tip="显示 / 隐藏输出 · Ctrl+Shift+J">
              <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource ToolOutput}"/><TextBlock Text="输出" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button Classes="terminal-tool" Classes.selected="{Binding InspectorVisible}" Command="{Binding ToggleInspectorCommand}" ToolTip.Tip="显示 / 隐藏右栏 · Ctrl+Shift+B">
              <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource ToolTools}"/><TextBlock Text="工具" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button Classes="terminal-tool" Classes.selected="{Binding SettingsOpen}" Command="{Binding DockSelectCommand}" CommandParameter="5" ToolTip.Tip="设置" AutomationProperties.Name="设置">
              <PathIcon Data="{StaticResource ToolSettings}"/>
            </Button>
            <Button Classes="terminal-tool" Click="OnMinimizeClick" ToolTip.Tip="最小化" AutomationProperties.Name="最小化"><PathIcon Data="{StaticResource ToolMinimize}"/></Button>
            <Button Classes="terminal-tool" Click="OnMaximizeClick" ToolTip.Tip="最大化 / 还原" AutomationProperties.Name="最大化 / 还原"><PathIcon Data="{StaticResource ToolWindow}"/></Button>
            <Button Classes="terminal-tool" Click="OnCloseClick" ToolTip.Tip="关闭应用" AutomationProperties.Name="关闭应用"><PathIcon Data="{StaticResource ToolClose}"/></Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============ Main three-rail ============ -->
      <Grid Grid.Row="1" x:Name="StageLayout" ColumnDefinitions="280,18,*,0,0" Margin="18,10,24,14">

        <!-- ===== LEFT: perspective session shelf ===== -->
        <Grid Grid.Column="0" RowDefinitions="30,*,52">
          <Grid ColumnDefinitions="*,Auto" Margin="20,0,20,0">
            <TextBlock Text="会话空间" Foreground="{DynamicResource UiMuted}" FontSize="11" LetterSpacing="2"/>
            <TextBlock Grid.Column="1" Text="{Binding TerminalCount, StringFormat='{}{0:00}'}"
                       Foreground="{DynamicResource UiMuted}" FontSize="11"/>
          </Grid>
          <ListBox x:Name="SessionShelf" Grid.Row="1" ItemsSource="{Binding ShelfItems}"
                   SelectedItem="{Binding ActiveCard, Mode=OneWay}" Background="Transparent" BorderThickness="0"
                   Padding="14,14,10,16" ClipToBounds="False"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="16"/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerTheme>
              <!-- A complete theme: no Fluent pointer/selection rectangle behind the tilted card. -->
              <ControlTheme TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="ClipToBounds" Value="False"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusAdorner" Value="{x:Null}"/>
                <Setter Property="Template">
                  <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Stretch"/>
                  </ControlTemplate>
                </Setter>
              </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.DataTemplates>
              <DataTemplate x:DataType="vm:SessionCardViewModel">
                <ctl:StageCard IsActive="{Binding IsActive}" StageDistance="{Binding StageDistance}"
                               Classes.active="{Binding IsActive}" Height="{Binding #Root.ThumbnailHeight}"
                               ToolTip.Tip="{Binding WorkingDirectory}" DoubleTapped="OnRenameCard">
                  <ctl:StageCard.Styles>
                    <Style Selector="ctl|StageCard > Border">
                      <Setter Property="Background" Value="{DynamicResource UiSurface}"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/>
                      <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/>
                    </Style>
                    <Style Selector="ctl|StageCard:pointerover > Border">
                      <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
                      <Setter Property="Background" Value="{DynamicResource UiRaised}"/>
                      <Setter Property="BoxShadow" Value="{DynamicResource ActiveCardShadow}"/>
                    </Style>
                    <Style Selector="ctl|StageCard.active > Border">
                      <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
                      <Setter Property="BorderThickness" Value="1.5"/>
                      <Setter Property="Background" Value="{DynamicResource UiRaised}"/>
                      <Setter Property="BoxShadow" Value="{DynamicResource ActiveCardShadow}"/>
                    </Style>
                  </ctl:StageCard.Styles>
                  <Border CornerRadius="{DynamicResource CardCorner}" Padding="9" BorderThickness="1">
                  <Border.Transitions>
                    <Transitions>
                      <BrushTransition Property="Background" Duration="0:0:0.22"/>
                      <BrushTransition Property="BorderBrush" Duration="0:0:0.22"/>
                    </Transitions>
                  </Border.Transitions>
                  <Grid RowDefinitions="24,*,Auto">
                    <Grid ColumnDefinitions="*,Auto" Margin="3,0,3,4">
                      <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="0,0,7,0">
                        <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" Margin="0,0,7,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource UiInk}"/>
                      </Grid>
                      <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                 FontSize="9" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Grid.Row="1" CornerRadius="{DynamicResource TerminalCorner}" Background="{DynamicResource UiInset}" Padding="3" ClipToBounds="True">
                      <ctl:StagePreview Emulator="{Binding Model.Emulator}"/>
                    </Border>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="3,6,3,0">
                      <TextBlock Text="{Binding ShelfCaption}" FontSize="9" Foreground="{DynamicResource UiMuted}"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding WorkingDirectory}"/>
                      <TextBlock Grid.Column="1" Text="当前终端" IsVisible="{Binding IsActive}" FontSize="9" Foreground="{DynamicResource UiAccent}"/>
                    </Grid>
                    <ctl:StageCardFinish Grid.RowSpan="3" Margin="-9" IsVisible="{Binding !IsActive}" IsHitTestVisible="False"/>
                  </Grid>
                  </Border>
                </ctl:StageCard>
              </DataTemplate>
              <DataTemplate x:DataType="vm:SessionGroupHeader">
                <Border Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="10,6" Margin="6,0" Cursor="Hand">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource UiInk}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Activity}" FontSize="10" Foreground="{DynamicResource UiAccent}"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.DataTemplates>
          </ListBox>
          <Button Grid.Row="2" CornerRadius="12" Margin="14,8,10,0" Padding="14,9"
                  Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding NewSessionCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Text="＋" Foreground="{DynamicResource UiAccent}" FontSize="17"/>
              <TextBlock Grid.Column="1" Text="新建终端" Foreground="{DynamicResource UiInk}" Margin="8,2,0,0" FontSize="12"/>
              <TextBlock Grid.Column="2" Text="Ctrl ⇧ N" Foreground="{DynamicResource UiMuted}" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
          </Button>
        </Grid>

        <!-- ===== CENTER ===== -->
        <ctl:StageSurface x:Name="StageWindow" Grid.Column="2" CornerRadius="{DynamicResource SurfaceCorner}"
                Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1"
                BoxShadow="{DynamicResource SurfaceShadow}">
          <Grid RowDefinitions="44,40,*,Auto" Margin="8">

            <!-- The active window has one title; other sessions live on the shelf. -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="8,0,4,4">
              <Border Width="27" Height="27" CornerRadius="7" Background="{DynamicResource UiRaised}" Margin="0,0,10,0">
                <TextBlock Text="›_" FontFamily="Consolas" FontSize="14" Foreground="{DynamicResource UiAccent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding ActiveCard.Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontFamily="{DynamicResource HeadingFont}" DoubleTapped="OnRenameActive" ToolTip.Tip="双击重命名 · 会话列表聚焦时按 F2" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
                <Border Grid.Column="1" Background="{DynamicResource UiRaised}" CornerRadius="6" Padding="8,4" Margin="12,0,0,0"
                        IsVisible="{Binding ActiveCard, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                  <StackPanel Spacing="2"><TextBlock Text="{Binding ActiveCard.StatusText}" FontSize="10" Foreground="{Binding ActiveCard.StatusBrush}"/><TextBlock Text="{Binding ActiveCard.CommandStatusText}" FontSize="9" Foreground="{DynamicResource UiMuted}" IsVisible="{Binding ActiveCard.CommandStatusText, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/></StackPanel>
                </Border>
              </Grid>
              <Button Grid.Column="2" Classes="terminal-tool" Command="{Binding NewSessionCommand}" ToolTip.Tip="新建终端 · Ctrl+Shift+N" AutomationProperties.Name="新建终端">
                <PathIcon Data="{StaticResource ToolAdd}"/>
              </Button>
              <Button Grid.Column="3" Classes="terminal-tool" Command="{Binding CloseActiveSessionCommand}" ToolTip.Tip="关闭当前终端 · Ctrl+Shift+W" AutomationProperties.Name="关闭当前终端">
                <PathIcon Data="{StaticResource ToolClose}"/>
              </Button>
            </Grid>

            <!-- Toolbar: ← back / ⟳ refresh CWD / → forward + path -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" Margin="4,0">
              <Button Classes="terminal-tool"
                      Command="{Binding CwdBackCommand}" IsEnabled="{Binding CanCwdBack}"
                      ToolTip.Tip="后退目录历史" AutomationProperties.Name="后退目录历史">
                <PathIcon Data="{StaticResource ToolBack}"/>
              </Button>
              <Button Grid.Column="1" Classes="terminal-tool"
                      Command="{Binding RefreshCwdCommand}" ToolTip.Tip="刷新当前目录" AutomationProperties.Name="刷新当前目录">
                <PathIcon Data="{StaticResource ToolRefresh}"/>
              </Button>
              <Button Grid.Column="2" Classes="terminal-tool"
                      Command="{Binding CwdForwardCommand}" IsEnabled="{Binding CanCwdForward}"
                      ToolTip.Tip="前进目录历史" AutomationProperties.Name="前进目录历史">
                <PathIcon Data="{StaticResource ToolForward}"/>
              </Button>
              <Button Grid.Column="3" Classes="terminal-tool" Command="{Binding ShowWorkspaceCommand}"
                      HorizontalContentAlignment="Left" Margin="6,0,10,0" ToolTip.Tip="{Binding ActiveWorkingDirectory}">
                <TextBlock Text="{Binding ActiveWorkingDirectory}" TextTrimming="CharacterEllipsis" FontSize="11"/>
              </Button>
              <Button Grid.Column="4" Classes="terminal-tool" Classes.selected="{Binding IsSplit}" Margin="0,0,4,0"
                      Command="{Binding ToggleSplitCommand}"
                      ToolTip.Tip="并排显示两个会话;点击窗格聚焦,点会话卡分配到该窗格。再点退出。">
                <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource ToolSplit}"/><TextBlock Text="分屏" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <Button Grid.Column="5" Classes="terminal-tool" Margin="0,0,4,0"
                      Command="{Binding OpenInNewWindowCommand}"
                      ToolTip.Tip="把当前会话弹出为独立窗口（关闭子窗即收回）">
                <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource ToolPopout}"/><TextBlock Text="弹出" VerticalAlignment="Center"/></StackPanel>
              </Button>
              <Button x:Name="SessionMenuButton" Grid.Column="6" Classes="terminal-tool" ToolTip.Tip="会话操作" AutomationProperties.Name="会话操作">
                <PathIcon Data="{StaticResource ToolMore}"/>
                <Button.Flyout>
                  <MenuFlyout Opening="OnSessionMenuOpening">
                    <MenuItem Header="重命名会话       F2" Click="OnRenameActive"/>
                    <MenuItem x:Name="PinSessionItem" Header="置顶" Command="{Binding TogglePinActiveCommand}"/>
                    <MenuItem Header="移出分组" Command="{Binding RemoveActiveFromGroupCommand}"/>
                    <MenuItem x:Name="MoveToGroupMenu" Header="移入分组"/>
                    <MenuItem Header="新建分组" Click="OnCreateGroupForActive"/>
                    <MenuItem Header="重命名当前分组" Click="OnRenameActiveGroup"/>
                    <MenuItem x:Name="ToggleGroupItem" Header="折叠当前分组" Command="{Binding ToggleActiveGroupCommand}"/>
                    <MenuItem Header="查看当前工作区" Command="{Binding ShowWorkspaceCommand}"/>
                    <MenuItem x:Name="TerminalColorsMenu" Header="终端配色"/>
                    <MenuItem Header="关闭会话        Ctrl+Shift+W" Command="{Binding CloseActiveSessionCommand}"/>
                    <MenuItem Header="{Binding NextSessionMenuText}" Command="{Binding CycleSessionNextCommand}"/>
                    <MenuItem Header="{Binding PreviousSessionMenuText}" Command="{Binding CycleSessionPrevCommand}"/>
                    <Separator/>
                    <MenuItem Header="复制 CWD" Command="{Binding CopyActiveCwdCommand}"/>
                    <Separator/>
                    <MenuItem Header="复制当前屏幕" Click="OnCopyScreen" ToolTip.Tip="复制当前可见的终端文字；浏览历史时复制当前视口"/>
                    <MenuItem Header="复制全部输出" Click="OnCopyAllOutput" ToolTip.Tip="复制缓冲中仍保留的历史与屏幕；已裁剪的旧输出不在其中"/>
                    <MenuItem x:Name="SaveSelectionItem" Header="保存选区为文本" Click="OnSaveSelection"/>
                    <MenuItem Header="保存全部输出" Click="OnSaveAllOutput"/>
                    <Separator/>
                    <MenuItem Header="添加书签" Click="OnAddBookmark" ToolTip.Tip="有选区时保存选区文字并定位到选区起点；否则以视口首行定位并保存预览"/>
                    <MenuItem Header="书签列表" Click="OnShowBookmarks"/>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </Grid>

            <!-- Terminal viewport -->
            <Border Grid.Row="2" x:Name="TerminalViewport" CornerRadius="{DynamicResource TerminalCorner}" Background="{DynamicResource UiInset}" Padding="10,8" Margin="2,6" ClipToBounds="True">
              <Panel>
                <!-- empty stage: no sessions left -->
                <StackPanel IsVisible="{Binding ActiveCard, Converter={x:Static conv:ObjectConverters.IsNull}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                  <TextBlock Text="›_" FontFamily="Consolas" FontSize="26" Foreground="{DynamicResource UiFaint}"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="没有活动终端" FontSize="13" Foreground="{DynamicResource UiMuted}"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="Ctrl+Shift+N 或点击左侧「新建终端」" FontSize="11" Foreground="{DynamicResource UiFaint}"
                             HorizontalAlignment="Center"/>
                </StackPanel>
                <!-- single view -->
                <Panel IsVisible="{Binding !IsSplit}">
                  <ctl:TerminalView x:Name="MainTerminal"
                                    Emulator="{Binding ActiveSession.Emulator}"
                                    WorkingDirectory="{Binding ActiveWorkingDirectory}" ShellCommand="{Binding ActiveSession.Shell}" IsRemote="{Binding ActiveSession.IsRemote}"
                                    TerminalFontSize="{Binding FontSize}"
                                    TerminalFontFamily="{Binding TerminalFont}"
                                    SearchQuery="{Binding Dashboard.SearchQuery}"/>
                  <Button Content="⬇ 回到底部" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,6,6" Padding="10,4" CornerRadius="8" FontSize="10"
                          Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiAccent}" BorderThickness="1"
                          Foreground="{DynamicResource UiAccent}" Click="OnScrollToBottomClick"
                          IsVisible="{Binding #MainTerminal.IsScrolledUp}"
                          ToolTip.Tip="回到实时输出底部"/>
                </Panel>
                <!-- split view: two independent sessions + draggable divider -->
                <Grid IsVisible="{Binding IsSplit}" ColumnDefinitions="*,5,*">
                  <Border x:Name="LeftPaneBox" BorderThickness="1.5" CornerRadius="6" Margin="0,0,3,0"
                          Classes.pane-focus="{Binding FocusedPane, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=0}">
                    <Border.Styles>
                      <Style Selector="Border"><Setter Property="BorderBrush" Value="Transparent"/></Style>
                      <Style Selector="Border.pane-focus"><Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/></Style>
                    </Border.Styles>
                    <Grid RowDefinitions="32,*">
                      <Border Background="{DynamicResource UiRaised}" CornerRadius="5,5,0,0" Padding="10,0">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock x:Name="LeftPaneTitle" Text="{Binding LeftPaneName}" FontSize="11" FontWeight="SemiBold"
                                     Foreground="{DynamicResource UiInk}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="1" Text="当前窗格" FontSize="9" Foreground="{DynamicResource UiAccent}" VerticalAlignment="Center"
                                     IsVisible="{Binding FocusedPane, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=0}"/>
                        </Grid>
                      </Border>
                      <Panel Grid.Row="1" Margin="6,7,6,4">
                      <ctl:TerminalView x:Name="LeftTerminal" Emulator="{Binding LeftPane.Emulator}"
                                        WorkingDirectory="{Binding LeftPane.WorkingDirectory}" ShellCommand="{Binding LeftPane.Shell}" IsRemote="{Binding LeftPane.IsRemote}"
                                        TerminalFontSize="{Binding FontSize}"
                                        TerminalFontFamily="{Binding TerminalFont}"
                                        SearchQuery="{Binding Dashboard.SearchQuery}"/>
                      <Button Content="⬇" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Margin="0,0,6,6" Padding="8,3" CornerRadius="8" FontSize="10"
                              Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiAccent}" BorderThickness="1"
                              Foreground="{DynamicResource UiAccent}" Click="OnScrollToBottomClick"
                              IsVisible="{Binding #LeftTerminal.IsScrolledUp}"
                              ToolTip.Tip="回到实时输出底部"/>
                    </Panel>
                    </Grid>
                  </Border>
                  <GridSplitter Grid.Column="1" Width="5" Background="{DynamicResource UiRaised}"
                                ResizeBehavior="BasedOnAlignment"/>
                  <Border x:Name="RightPaneBox" Grid.Column="2" BorderThickness="1.5" CornerRadius="6" Margin="3,0,0,0"
                          Classes.pane-focus="{Binding FocusedPane, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=1}">
                    <Border.Styles>
                      <Style Selector="Border"><Setter Property="BorderBrush" Value="Transparent"/></Style>
                      <Style Selector="Border.pane-focus"><Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/></Style>
                    </Border.Styles>
                    <Grid RowDefinitions="32,*">
                      <Border Background="{DynamicResource UiRaised}" CornerRadius="5,5,0,0" Padding="10,0">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock x:Name="RightPaneTitle" Text="{Binding RightPaneName}" FontSize="11" FontWeight="SemiBold"
                                     Foreground="{DynamicResource UiInk}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="1" Text="当前窗格" FontSize="9" Foreground="{DynamicResource UiAccent}" VerticalAlignment="Center"
                                     IsVisible="{Binding FocusedPane, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=1}"/>
                        </Grid>
                      </Border>
                      <Panel Grid.Row="1" Margin="6,7,6,4" Background="Transparent">
                      <ctl:TerminalView x:Name="RightTerminal" Emulator="{Binding RightPane.Emulator}"
                                        WorkingDirectory="{Binding RightPane.WorkingDirectory}" ShellCommand="{Binding RightPane.Shell}" IsRemote="{Binding RightPane.IsRemote}"
                                        TerminalFontSize="{Binding FontSize}"
                                        TerminalFontFamily="{Binding TerminalFont}"
                                        SearchQuery="{Binding Dashboard.SearchQuery}"
                                        IsVisible="{Binding RightPane, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
                      <TextBlock Text="右栏暂无会话 — 点击左侧会话卡分配到这里"
                                 Foreground="{DynamicResource UiFaint}" FontSize="11" TextWrapping="Wrap"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                                 IsVisible="{Binding RightPane, Converter={x:Static conv:ObjectConverters.IsNull}}"/>
                      <Button Content="⬇" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Margin="0,0,6,6" Padding="8,3" CornerRadius="8" FontSize="10"
                              Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiAccent}" BorderThickness="1"
                              Foreground="{DynamicResource UiAccent}" Click="OnScrollToBottomClick"
                              IsVisible="{Binding #RightTerminal.IsScrolledUp}"
                              ToolTip.Tip="回到实时输出底部"/>
                    </Panel>
                    </Grid>
                  </Border>
                </Grid>
              </Panel>
            </Border>

            <!-- Bottom panel: Output / Debug / Problems / Search -->
            <Border x:Name="OutputPanel" Grid.Row="3" Height="170" Margin="0,6,0,0"
                    IsVisible="{Binding OutputVisible}" CornerRadius="8" Background="{DynamicResource UiSurface}"
                    BorderBrush="{DynamicResource UiBorder}" BorderThickness="1">
              <Grid RowDefinitions="30,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0">
                  <ListBox SelectedIndex="{Binding Dashboard.SelectedBottomTab}"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ScrollViewer.VerticalScrollBarVisibility="Disabled"
                           Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="12,4"/>
                        <Setter Property="Margin" Value="0,3"/>
                        <Setter Property="CornerRadius" Value="6"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
                        <Setter Property="Background" Value="Transparent"/>
                      </Style>
                      <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="{DynamicResource UiAccent}"/>
                        <Setter Property="Foreground" Value="{DynamicResource UiInk}"/>
                      </Style>
                    </ListBox.Styles>
                    <ListBoxItem>Output</ListBoxItem>
                    <ListBoxItem>Debug</ListBoxItem>
                    <ListBoxItem>
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Problems"/>
                        <Border IsVisible="{Binding Dashboard.HasProblems}" CornerRadius="8"
                                Background="{DynamicResource UiBad}" Padding="5,1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Dashboard.ProblemCount}" FontSize="9" Foreground="{DynamicResource UiOnAccent}"/>
                        </Border>
                      </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>Search</ListBoxItem>
                  </ListBox>
                  <Button Grid.Column="1" Content="⧉ Clear" FontSize="10" Padding="8,2"
                          Background="{DynamicResource UiRaised}" CornerRadius="6" BorderBrush="{DynamicResource UiBorder}"
                          Foreground="{DynamicResource UiMuted}" VerticalAlignment="Center"
                          Command="{Binding Dashboard.ClearOutputCommand}"/>
                </Grid>

                <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource UiBorder}">
                  <Panel>
                    <!-- Output -->
                    <ListBox IsVisible="{Binding Dashboard.SelectedBottomTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=0}"
                             ItemsSource="{Binding Dashboard.OutputLog}"
                             Background="Transparent" BorderThickness="0" Padding="6">
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                          <Setter Property="Padding" Value="2,1"/>
                          <Setter Property="Background" Value="Transparent"/>
                          <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                          <Setter Property="FontSize" Value="10"/>
                        </Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntry">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}" Foreground="{DynamicResource UiFaint}"/>
                            <TextBlock Text="{Binding Level, StringFormat='[{0}]'}"
                                       Foreground="{Binding Level, Converter={x:Static vm:LogLevelConverter.Instance}}"/>
                            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource UiMuted}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Debug: raw session lines (pre-ANSI-strip, control bytes escaped) -->
                    <ListBox IsVisible="{Binding Dashboard.SelectedBottomTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=1}"
                             ItemsSource="{Binding Dashboard.DebugLog}"
                             Background="Transparent" BorderThickness="0" Padding="6">
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                          <Setter Property="Padding" Value="2,1"/>
                          <Setter Property="Background" Value="Transparent"/>
                          <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                          <Setter Property="FontSize" Value="10"/>
                        </Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntry">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss.fff}'}" Foreground="{DynamicResource UiFaint}"/>
                            <TextBlock IsVisible="{Binding Source, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"
                                       Text="{Binding Source, StringFormat='({0})'}" Foreground="{DynamicResource UiFaint}"/>
                            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource UiInk}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Problems: real errors from session output; clearable -->
                    <DockPanel IsVisible="{Binding Dashboard.SelectedBottomTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=2}">
                      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="8,4,8,0">
                        <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource UiFaint}"
                                   Text="{Binding Dashboard.ProblemCount, StringFormat='会话输出中的 error / exception / 非零退出:{0} 条'}"/>
                        <Button Grid.Column="1" Content="清空" FontSize="10" Padding="10,2"
                                Background="{DynamicResource UiRaised}" Foreground="{DynamicResource UiMuted}" CornerRadius="6" BorderThickness="0"
                                IsVisible="{Binding Dashboard.HasProblems}"
                                Command="{Binding Dashboard.ClearProblemsCommand}"/>
                      </Grid>
                      <TextBlock DockPanel.Dock="Top" Margin="8,4,8,0" FontSize="10" Foreground="{DynamicResource UiFaint}"
                                 IsVisible="{Binding !Dashboard.HasProblems}"
                                 Text="暂无问题 —— 会话输出中的错误会出现在这里"/>
                    <ListBox ItemsSource="{Binding Dashboard.Problems}"
                             Background="Transparent" BorderThickness="0" Padding="6">
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                          <Setter Property="Padding" Value="2,1"/>
                          <Setter Property="Background" Value="Transparent"/>
                          <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                          <Setter Property="FontSize" Value="10"/>
                        </Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntry">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Level, StringFormat='[{0}]'}"
                                       Foreground="{Binding Level, Converter={x:Static vm:LogLevelConverter.Instance}}"/>
                            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource UiMuted}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    </DockPanel>

                    <!-- Search: filter active-session scrollback+screen, matched terms highlighted -->
                    <Grid IsVisible="{Binding Dashboard.SelectedBottomTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=3}"
                          RowDefinitions="Auto,Auto,*">
                      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="8,6,8,0">
                        <TextBox Text="{Binding Dashboard.SearchQuery}"
                                 Watermark="在当前会话中搜索…" FontSize="11"
                                 Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiInk}"
                                 CornerRadius="6" Padding="8,4"/>
                        <Button Grid.Column="1" Content="▲" Padding="8,2" Margin="6,0,0,0" FontSize="10"
                                Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}"
                                Foreground="{DynamicResource UiMuted}" CornerRadius="6" VerticalAlignment="Center"
                                Click="OnSearchPrevMatch" ToolTip.Tip="上一处匹配（终端视口跟随）"/>
                        <Button Grid.Column="2" Content="▼" Padding="8,2" Margin="4,0,0,0" FontSize="10"
                                Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}"
                                Foreground="{DynamicResource UiMuted}" CornerRadius="6" VerticalAlignment="Center"
                                Click="OnSearchNextMatch" ToolTip.Tip="下一处匹配（终端视口跟随）"/>
                        <TextBlock Grid.Column="3" Text="{Binding Dashboard.SearchStatus}"
                                   Foreground="{DynamicResource UiFaint}" FontSize="10" Margin="10,0"
                                   VerticalAlignment="Center" MinWidth="70"/>
                      </Grid>
                      <TextBlock Grid.Row="1" Text="作用域: 当前活动会话 scrollback + 屏幕 · 双击结果行定位到终端"
                                 Foreground="{DynamicResource UiFaint}" FontSize="9" Margin="10,4,0,2"/>
                      <ListBox Grid.Row="2" ItemsSource="{Binding Dashboard.SearchHits}"
                               DoubleTapped="OnSearchHitDoubleTapped"
                               Background="Transparent" BorderThickness="0" Padding="6">
                        <ListBox.Styles>
                          <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="2,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                            <Setter Property="FontSize" Value="10"/>
                          </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding Line, StringFormat='L{0}'}" Foreground="{DynamicResource UiFaint}" MinWidth="40"/>
                              <ctl:HighlightTextBlock LineText="{Binding Text}" Foreground="{DynamicResource UiMuted}"
                                                    Query="{Binding $parent[ListBox].DataContext.Dashboard.SearchQuery}"/>
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </Grid>
                  </Panel>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </ctl:StageSurface>

        <!-- ===== RIGHT: Processes/Files/Logs/SSH ===== -->
        <Border Grid.Column="4" CornerRadius="{DynamicResource SurfaceCorner}" IsVisible="{Binding InspectorVisible}"
                Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1"
                BoxShadow="{DynamicResource SurfaceShadow}">
          <Grid RowDefinitions="42,*" Margin="9">

            <ListBox Grid.Row="0" SelectedIndex="{Binding SelectedRightTab}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="10,4"/>
                  <Setter Property="Margin" Value="0,3"/>
                  <Setter Property="CornerRadius" Value="6"/>
                  <Setter Property="FontSize" Value="11"/>
                  <Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
                  <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem:selected">
                  <Setter Property="Background" Value="{DynamicResource UiAccent}"/>
                  <Setter Property="Foreground" Value="{DynamicResource UiInk}"/>
                </Style>
              </ListBox.Styles>
              <ListBoxItem>Processes</ListBoxItem>
              <ListBoxItem>Files</ListBoxItem>
              <ListBoxItem>Logs</ListBoxItem>
              <ListBoxItem>SSH</ListBoxItem>
              <ListBoxItem>命令</ListBoxItem>
            </ListBox>

            <Panel Grid.Row="1" Margin="0,4,0,0">
              <!-- ===== Processes + System Monitor ===== -->
              <Grid IsVisible="{Binding SelectedRightTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=0}"
                    RowDefinitions="*,Auto">
                <Grid RowDefinitions="Auto,*">
                  <Grid ColumnDefinitions="50,*,70,70" Margin="6,4">
                    <TextBlock Text="PID" FontSize="10" Foreground="{DynamicResource UiFaint}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="NAME" FontSize="10" Foreground="{DynamicResource UiFaint}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="CPU" FontSize="10" Foreground="{DynamicResource UiFaint}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="MEM" FontSize="10" Foreground="{DynamicResource UiFaint}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                  </Grid>
                  <ListBox Grid.Row="1" ItemsSource="{Binding Dashboard.Processes}"
                           Background="Transparent" BorderThickness="0">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="6,3"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="CornerRadius" Value="6"/>
                        <Setter Property="Background" Value="{DynamicResource UiSurface}"/>
                        <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                        <Setter Property="FontSize" Value="10.5"/>
                      </Style>
                      <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="{DynamicResource UiSurface}"/>
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="mon:ProcessInfo">
                        <Grid ColumnDefinitions="50,*,70,70">
                          <TextBlock Text="{Binding Pid}" Foreground="{DynamicResource UiMuted}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource UiInk}"/>
                          <TextBlock Grid.Column="2" Text="{Binding CpuPercent, StringFormat='{}{0:0.0}%'}"
                                     Foreground="{DynamicResource UiGood}" HorizontalAlignment="Right"/>
                          <TextBlock Grid.Column="3" Text="{Binding MemoryBytes, Converter={x:Static vm:BytesConverter.Instance}}"
                                     Foreground="{DynamicResource UiMuted}" HorizontalAlignment="Right"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>

                <!-- System Monitor widgets -->
                <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource UiSurface}"
                        BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" Padding="8" Margin="0,6,0,0">
                  <StackPanel Spacing="8">
                    <TextBlock Text="System Monitor" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource UiMuted}"/>
                    <Grid ColumnDefinitions="*,10,*">
                      <Border CornerRadius="8" Background="{DynamicResource UiSurface}" Padding="8">
                        <Grid RowDefinitions="Auto,Auto,*">
                          <TextBlock Text="CPU" FontSize="10" Foreground="{DynamicResource UiFaint}"/>
                          <TextBlock Grid.Row="1" Text="{Binding Dashboard.CpuPercent}" FontSize="18"
                                     FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
                          <ctl:SparklineControl Grid.Row="2" Values="{Binding Dashboard.CpuSpark}"
                                                Stroke="{DynamicResource UiAccent}" Fill="{DynamicResource UiAccent}" Height="34" Margin="0,4,0,0"/>
                        </Grid>
                      </Border>
                      <Border Grid.Column="2" CornerRadius="8" Background="{DynamicResource UiSurface}" Padding="8">
                        <Grid RowDefinitions="Auto,Auto,*">
                          <TextBlock Text="Memory" FontSize="10" Foreground="{DynamicResource UiFaint}"/>
                          <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding Dashboard.MemUsage}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
                            <TextBlock Text="{Binding Dashboard.MemTotal}" FontSize="10" Foreground="{DynamicResource UiFaint}"
                                       VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                          </StackPanel>
                          <ctl:SparklineControl Grid.Row="2" Values="{Binding Dashboard.MemSpark}"
                                                Stroke="{DynamicResource UiViolet}" Fill="{DynamicResource UiViolet}" Height="34" Margin="0,4,0,0"/>
                        </Grid>
                      </Border>
                    </Grid>
                    <Grid ColumnDefinitions="*,10,*">
                      <Border CornerRadius="8" Background="{DynamicResource UiSurface}" Padding="8">
                        <StackPanel Spacing="4">
                          <TextBlock Text="Disk" FontSize="10" Foreground="{DynamicResource UiFaint}"/>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Dashboard.DiskUsage}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
                          </StackPanel>
                          <ProgressBar Value="{Binding Dashboard.DiskFraction}" Minimum="0" Maximum="1"
                                       MinWidth="0" Height="6" CornerRadius="3" Foreground="{DynamicResource UiGood}" Background="{DynamicResource UiRaised}"/>
                          <TextBlock Text="{Binding Dashboard.DiskPercent}" FontSize="9" Foreground="{DynamicResource UiFaint}" HorizontalAlignment="Right"/>
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="2" CornerRadius="8" Background="{DynamicResource UiSurface}" Padding="8">
                        <Grid RowDefinitions="Auto,*,*">
                          <TextBlock Text="Network" FontSize="10" Foreground="{DynamicResource UiFaint}"/>
                          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Dashboard.NetDown}" FontSize="11" Foreground="{DynamicResource UiGood}"/>
                            <ctl:SparklineControl Values="{Binding Dashboard.NetDownSpark}" Stroke="{DynamicResource UiGood}"
                                                  Width="60" Height="16" VerticalAlignment="Center" MaxValue="20"/>
                          </StackPanel>
                          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Dashboard.NetUp}" FontSize="11" Foreground="{DynamicResource UiAccent}"/>
                            <ctl:SparklineControl Values="{Binding Dashboard.NetUpSpark}" Stroke="{DynamicResource UiAccent}"
                                                  Width="60" Height="16" VerticalAlignment="Center" MaxValue="20"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- ===== Files ===== -->
              <Grid IsVisible="{Binding SelectedRightTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=1}"
                    RowDefinitions="Auto,Auto,5*,Auto,4*">
                <!-- toolbar: up + breadcrumb + open-in-terminal + copy-path + refresh + session dir -->
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="0,2,0,4">
                  <Button Content="↑" Padding="8,2" CornerRadius="6" Background="{DynamicResource UiRaised}"
                          Foreground="{DynamicResource UiMuted}" BorderBrush="{DynamicResource UiBorder}"
                          IsEnabled="{Binding Files.CanGoUp}"
                          Command="{Binding Files.UpCommand}" ToolTip.Tip="上一级"/>
                  <ScrollViewer x:Name="CrumbScroll" Grid.Column="1" Margin="6,0" VerticalAlignment="Center"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Files.Breadcrumbs}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilesViewModel+Crumb">
                          <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Content="{Binding Label}" Padding="4,1" FontSize="10"
                                    Background="Transparent" Foreground="{DynamicResource UiMuted}" BorderThickness="0"
                                    FontFamily="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Files.NavigateCrumbCommand}"
                                    CommandParameter="{Binding}">
                              <Button.Styles>
                                <Style Selector="Button:pointerover">
                                  <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
                                </Style>
                              </Button.Styles>
                            </Button>
                            <TextBlock Text="›" Foreground="{DynamicResource UiFaint}" FontSize="10" VerticalAlignment="Center"/>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <Button Grid.Column="2" Content="⇥" Padding="8,2" Margin="0,0,6,0" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" Foreground="{DynamicResource UiMuted}" BorderBrush="{DynamicResource UiBorder}"
                          Command="{Binding Files.OpenInTerminalCommand}"
                          ToolTip.Tip="在此打开终端：目录→活动终端 cd 进入；文件→cd 所在目录"/>
                  <Button Grid.Column="3" Content="⧉" Padding="8,2" Margin="0,0,6,0" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" Foreground="{DynamicResource UiMuted}" BorderBrush="{DynamicResource UiBorder}"
                          Command="{Binding Files.CopyPathCommand}"
                          ToolTip.Tip="复制路径"/>
                  <Button Grid.Column="4" Content="⟳" Padding="8,2" Margin="0,0,6,0" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" Foreground="{DynamicResource UiMuted}" BorderBrush="{DynamicResource UiBorder}"
                          Command="{Binding Files.RefreshCommand}" ToolTip.Tip="刷新"/>
                  <Button Grid.Column="5" Content="⌂" Padding="8,2" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" Foreground="{DynamicResource UiAccent}" BorderBrush="{DynamicResource UiBorder}"
                          Command="{Binding Files.GoToSessionDirCommand}" ToolTip.Tip="会话目录"/>
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding Files.StatusText}" Foreground="{DynamicResource UiBad}"
                           FontSize="9.5" Margin="2,0,0,2"
                           IsVisible="{Binding Files.StatusText, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>

                <!-- directory listing -->
                <Border Grid.Row="2" CornerRadius="8" Background="{DynamicResource UiSurface}"
                        BorderBrush="{DynamicResource UiBorder}" BorderThickness="1">
                  <ListBox x:Name="FilesList" ItemsSource="{Binding Files.Entries}"
                           SelectedItem="{Binding Files.SelectedEntry}"
                           Background="Transparent" BorderThickness="0" Padding="4"
                           DoubleTapped="OnFileEntryDoubleTapped"
                           KeyDown="OnFilesListKeyDown">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="6,3"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="CornerRadius" Value="5"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="FontSize" Value="10.5"/>
                      </Style>
                      <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Background" Value="{DynamicResource UiSurface}"/>
                      </Style>
                      <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="{DynamicResource UiSurface}"/>
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="files:FileEntry">
                        <Grid ColumnDefinitions="14,*,Auto">
                          <Grid.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="在此打开终端"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Files.OpenInTerminalCommand}"
                                        CommandParameter="{Binding}"/>
                              <MenuItem Header="复制路径"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Files.CopyPathCommand}"
                                        CommandParameter="{Binding}"/>
                            </ContextMenu>
                          </Grid.ContextMenu>
                          <TextBlock Text="▸" Foreground="{DynamicResource UiAccent}" IsVisible="{Binding IsDirectory}"/>
                          <TextBlock Text="·" Foreground="{DynamicResource UiFaint}" IsVisible="{Binding !IsDirectory}"/>
                          <TextBlock Grid.Column="1" Margin="2,0,0,0" Text="{Binding Name}"
                                     Foreground="{Binding IsDirectory, Converter={x:Static vm:DirNameConverter.Instance}}"/>
                          <TextBlock Grid.Column="2" Text="{Binding SizeBytes, Converter={x:Static vm:BytesConverter.Instance}}"
                                     Foreground="{DynamicResource UiFaint}" FontSize="9.5" HorizontalAlignment="Right"
                                     IsVisible="{Binding !IsDirectory}"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>

                <!-- preview header -->
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="2,6,2,2"
                      IsVisible="{Binding Files.HasPreview}">
                  <TextBlock Text="{Binding Files.PreviewTitle}" FontSize="10.5" FontWeight="SemiBold"
                             Foreground="{DynamicResource UiInk}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Files.PreviewMeta}" FontSize="9"
                             Foreground="{DynamicResource UiFaint}" VerticalAlignment="Center"/>
                </Grid>

                <!-- preview pane -->
                <Border Grid.Row="4" CornerRadius="8" Background="{DynamicResource UiCanvas}"
                        BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" Padding="4"
                        IsVisible="{Binding Files.HasPreview}">
                  <TextBox Text="{Binding Files.PreviewText}" IsReadOnly="True"
                           AcceptsReturn="True" TextWrapping="NoWrap" BorderThickness="0"
                           Background="Transparent" Foreground="{DynamicResource UiMuted}" FontSize="9.5"
                           FontFamily="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Border>
                <Border Grid.Row="4" CornerRadius="8" Background="{DynamicResource UiSurface}"
                        BorderBrush="{DynamicResource UiBorder}" BorderThickness="1"
                        IsVisible="{Binding !Files.HasPreview}">
                  <TextBlock Text="双击文件查看预览" Foreground="{DynamicResource UiFaint}" FontSize="10"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>

              <!-- ===== Logs ===== -->
              <Grid IsVisible="{Binding SelectedRightTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=2}"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
                <Grid.Styles>
                  <!-- exclusive level chips: same dark chip look as the toggles above -->
                  <Style Selector="ToggleButton.levelchip">
                    <Setter Property="Padding" Value="10,3"/>
                    <Setter Property="MinWidth" Value="44"/>
                    <Setter Property="CornerRadius" Value="6"/>
                    <Setter Property="Background" Value="{DynamicResource UiRaised}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/>
                    <Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
                    <Setter Property="FontSize" Value="10"/>
                  </Style>
                  <Style Selector="ToggleButton.levelchip:checked">
                    <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
                  </Style>
                  <Style Selector="ToggleButton.timechip">
                    <Setter Property="Padding" Value="10,3"/>
                    <Setter Property="MinWidth" Value="44"/>
                    <Setter Property="CornerRadius" Value="6"/>
                    <Setter Property="Background" Value="{DynamicResource UiRaised}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/>
                    <Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
                    <Setter Property="FontSize" Value="10"/>
                  </Style>
                  <Style Selector="ToggleButton.timechip:checked">
                    <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
                  </Style>
                  <Style Selector="ToggleButton.capchip">
                    <Setter Property="Padding" Value="10,3"/>
                    <Setter Property="MinWidth" Value="44"/>
                    <Setter Property="CornerRadius" Value="6"/>
                    <Setter Property="Background" Value="{DynamicResource UiRaised}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/>
                    <Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
                    <Setter Property="FontSize" Value="10"/>
                  </Style>
                  <Style Selector="ToggleButton.capchip:checked">
                    <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
                  </Style>
                </Grid.Styles>
                <!-- filter row: text + regex toggle + file sink -->
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2,0,4">
                  <TextBox Text="{Binding Logs.FilterText}" Watermark="过滤日志…"
                           Background="{DynamicResource UiRaised}" CornerRadius="6" BorderBrush="{DynamicResource UiBorder}"
                           Foreground="{DynamicResource UiInk}" Padding="8,3" FontSize="10.5"/>
                  <ToggleButton Grid.Column="1" Content=".*" Margin="4,0,0,0" Padding="6,3" MinWidth="30"
                                CornerRadius="6" Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}"
                                Foreground="{DynamicResource UiMuted}" FontSize="10"
                                FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                                IsChecked="{Binding Logs.UseRegex}"
                                ToolTip.Tip="把过滤框内容当作正则表达式（忽略大小写）">
                    <ToggleButton.Styles>
                      <Style Selector="ToggleButton:checked">
                        <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
                      </Style>
                    </ToggleButton.Styles>
                  </ToggleButton>
                  <ToggleButton Grid.Column="2" Content="⬇ 写文件" Margin="6,0,0,0" Padding="8,3"
                                CornerRadius="6" Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}"
                                Foreground="{DynamicResource UiMuted}" FontSize="10"
                                IsChecked="{Binding Logs.FileLogging}"
                                ToolTip.Tip="将会话输出写入本地日志文件">
                    <ToggleButton.Styles>
                      <Style Selector="ToggleButton:checked">
                        <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
                      </Style>
                    </ToggleButton.Styles>
                  </ToggleButton>
                </Grid>
                <!-- level filter: exclusive chip bar (全部/info/warn/error + live ring-buffer counts) + timestamp / wrap / compact / 容量 -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                  <ToggleButton Classes="levelchip" Content="{Binding Logs.LevelAllChipLabel}"
                                IsChecked="{Binding Logs.LevelAllSelected}"
                                ToolTip.Tip="显示所有级别 / show all levels（数字=环形缓冲总条数）"/>
                  <ToggleButton Classes="levelchip" Content="{Binding Logs.LevelInfoChipLabel}" Margin="4,0,0,0"
                                IsChecked="{Binding Logs.LevelInfoSelected}"
                                ToolTip.Tip="只看 info 级行（数字=缓冲内 info 条数，不受当前筛选影响）"/>
                  <ToggleButton Classes="levelchip" Content="{Binding Logs.LevelWarnChipLabel}" Margin="4,0,0,0"
                                IsChecked="{Binding Logs.LevelWarnSelected}"
                                ToolTip.Tip="只看 warn 级行（数字=缓冲内 warn 条数，不受当前筛选影响）"/>
                  <ToggleButton Classes="levelchip" Content="{Binding Logs.LevelErrorChipLabel}" Margin="4,0,0,0"
                                IsChecked="{Binding Logs.LevelErrorSelected}"
                                ToolTip.Tip="只看 error 级行（数字=缓冲内 error 条数，不受当前筛选影响）"/>
                  <!-- timestamp mode: off=绝对 HH:mm:ss · on=相对「距现在」刚刚/12s/3m/1h/昨天 -->
                  <ToggleButton Classes="timechip" Content="相对" Margin="10,0,0,0"
                                IsChecked="{Binding Logs.UseRelativeTimestamps}"
                                ToolTip.Tip="时间戳：关=绝对 HH:mm:ss；开=相对距现在（刚刚 / 12s / 3m / 1h / 昨天 HH:mm；更早回退绝对）。导出始终用绝对时间。"/>
                  <!-- line wrap: on(default)=Wrap · off=NoWrap + horizontal scroll for dense scanning -->
                  <ToggleButton Classes="timechip" Content="换行" Margin="4,0,0,0"
                                IsChecked="{Binding Logs.WrapLines}"
                                ToolTip.Tip="换行：开（默认）=长消息自动折行；关=单行显示并允许横向滚动，便于密扫。"/>
                  <!-- compact density: off(default)=FontSize 9.5 / Padding 4,1 · on≈8.5 / 2,0 -->
                  <ToggleButton Classes="timechip" Content="紧凑" Margin="4,0,0,0"
                                IsChecked="{Binding Logs.CompactDensity}"
                                ToolTip.Tip="紧凑密度：关（默认）=字号 9.5 / 内边距 4,1；开=字号约 8.5 / 内边距约 2,0，便于密扫更多行。"/>
                  <!-- ring-buffer capacity presets (exclusive chips; default 2000) -->
                  <TextBlock Text="容量" FontSize="10" Foreground="{DynamicResource UiFaint}"
                             VerticalAlignment="Center" Margin="10,0,4,0"
                             ToolTip.Tip="Logs 环形缓冲容量（条）。缩小会丢弃最旧行。"/>
                  <ToggleButton Classes="capchip" Content="500"
                                IsChecked="{Binding Logs.Capacity500Selected}"
                                ToolTip.Tip="缓冲 500 行（浅）"/>
                  <ToggleButton Classes="capchip" Content="2000" Margin="4,0,0,0"
                                IsChecked="{Binding Logs.Capacity2000Selected}"
                                ToolTip.Tip="缓冲 2000 行（默认）"/>
                  <ToggleButton Classes="capchip" Content="5000" Margin="4,0,0,0"
                                IsChecked="{Binding Logs.Capacity5000Selected}"
                                ToolTip.Tip="缓冲 5000 行（深）"/>
                </WrapPanel>
                <!-- session filter -->
                <ComboBox Grid.Row="2" ItemsSource="{Binding Logs.SessionNames}"
                          SelectedIndex="{Binding Logs.SessionFilterIndex}"
                          Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" FontSize="10"
                          CornerRadius="6" Padding="8,2" Margin="0,0,0,4"
                          VerticalAlignment="Center"/>
                <!-- actions: match nav / copy visible / export / clear results / retain history -->
                <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,4">
                  <Button Content="▲ 上一条" Padding="8,3" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiMuted}"
                          FontSize="10" Command="{Binding Logs.GoPrevMatchCommand}"
                          IsEnabled="{Binding Logs.CanGoPrevMatch}"
                          ToolTip.Tip="选中上一条匹配行（需要过滤词；到头即停，不循环）"/>
                  <Button Content="▼ 下一条" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiMuted}"
                          FontSize="10" Command="{Binding Logs.GoNextMatchCommand}"
                          IsEnabled="{Binding Logs.CanGoNextMatch}"
                          ToolTip.Tip="选中下一条匹配行并滚动到它（暂停跟随尾部）；到头即停，不循环"/>
                  <Button Content="▲ error" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiBad}"
                          FontSize="10" Command="{Binding Logs.GoPrevErrorCommand}"
                          IsEnabled="{Binding Logs.CanGoPrevError}"
                          ToolTip.Tip="选中上一条 error 级别行（当前可见列表；到头即停，不循环；暂停跟随尾部）"/>
                  <Button Content="▼ error" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiBad}"
                          FontSize="10" Command="{Binding Logs.GoNextErrorCommand}"
                          IsEnabled="{Binding Logs.CanGoNextError}"
                          ToolTip.Tip="选中下一条 error 级别行并滚动到它（当前可见列表；暂停跟随尾部；到头即停，不循环）"/>
                  <Button Content="↗ 跳到会话" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiMuted}"
                          FontSize="10" Command="{Binding Logs.JumpToSessionCommand}"
                          ToolTip.Tip="激活选中日志行来源对应的终端会话（Logs 页保持打开；也可双击该行）"/>
                  <Button Content="⧉ 复制可见行" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiMuted}"
                          FontSize="10" Command="{Binding Logs.CopyVisibleCommand}"
                          ToolTip.Tip="复制当前过滤结果到剪贴板"/>
                  <Button Content="⧉ 复制选中" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiMuted}"
                          FontSize="10" Command="{Binding Logs.CopySelectedCommand}"
                          IsEnabled="{Binding Logs.HasSelectedEntry}"
                          ToolTip.Tip="复制当前选中的日志行到剪贴板（Logs 列表聚焦时 Ctrl+C）"/>
                  <Button Content="⬇ 导出" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiMuted}"
                          FontSize="10" Command="{Binding Logs.ExportVisibleCommand}"
                          ToolTip.Tip="把当前过滤后的可见行一次性导出为 .log / .txt 文件（与「⬇ 写文件」实时写入无关）"/>
                  <Button Content="✕ 清空结果" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiMuted}"
                          FontSize="10" Command="{Binding Logs.ClearVisibleCommand}"
                          ToolTip.Tip="清除当前过滤结果（从缓冲中移除，不再出现）"/>
                  <ToggleButton Content="📌 保留历史" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                                Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiMuted}"
                                FontSize="10" IsChecked="{Binding Logs.RetainHistoryOnClear}"
                                ToolTip.Tip="开启后：底部 Output 清空时 Logs 保留已缓冲历史；默认跟随清空">
                    <ToggleButton.Styles>
                      <Style Selector="ToggleButton:checked">
                        <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
                      </Style>
                    </ToggleButton.Styles>
                  </ToggleButton>
                </WrapPanel>
                <!-- invalid-regex hint -->
                <TextBlock Grid.Row="4" Text="{Binding Logs.FilterError}" Foreground="{DynamicResource UiBad}"
                           FontSize="9.5" Margin="2,0,2,3" TextWrapping="Wrap"
                           IsVisible="{Binding Logs.FilterError, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>

                <!-- log lines -->
                <Border Grid.Row="5" CornerRadius="8" Background="{DynamicResource UiSurface}"
                        BorderBrush="{DynamicResource UiBorder}" BorderThickness="1">
                  <Panel>
                    <ListBox x:Name="LogsList" ItemsSource="{Binding Logs.Entries}"
                             SelectedIndex="{Binding Logs.SelectedIndex, Mode=TwoWay}"
                             DoubleTapped="OnLogsEntryDoubleTapped"
                             KeyDown="OnLogsListKeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             Background="Transparent" BorderThickness="0" Padding="4"
                             Classes.compact="{Binding Logs.CompactDensity}">
                      <ListBox.Styles>
                        <!-- density: Classes.compact bound to Logs.CompactDensity refreshes Padding/FontSize -->
                        <Style Selector="ListBoxItem">
                          <Setter Property="Padding" Value="4,1"/>
                          <Setter Property="Background" Value="Transparent"/>
                          <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                          <Setter Property="FontSize" Value="9.5"/>
                        </Style>
                        <Style Selector="ListBox.compact ListBoxItem">
                          <Setter Property="Padding" Value="2,0"/>
                          <Setter Property="FontSize" Value="8.5"/>
                        </Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntry">
                          <!-- Message and Source reuse the Search tab's highlighter:
                               literal case-insensitive, or regex when the .* toggle is on. -->
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Foreground="{DynamicResource UiFaint}"
                                       FontSize="{Binding $parent[ListBox].DataContext.Logs.CompactDensity, Converter={x:Static vm:BoolToLogsFontSizeConverter.Instance}}">
                              <TextBlock.Text>
                                <MultiBinding Converter="{x:Static vm:LogTimestampConverter.Instance}">
                                  <Binding Path="Time"/>
                                  <Binding Path="$parent[ListBox].DataContext.Logs.UseRelativeTimestamps"/>
                                </MultiBinding>
                              </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="{Binding Level, StringFormat='[{0}]'}"
                                       FontSize="{Binding $parent[ListBox].DataContext.Logs.CompactDensity, Converter={x:Static vm:BoolToLogsFontSizeConverter.Instance}}"
                                       Foreground="{Binding Level, Converter={x:Static vm:LogLevelConverter.Instance}}"/>
                            <ctl:HighlightTextBlock LineText="{Binding Source, StringFormat='({0})'}" Foreground="{DynamicResource UiFaint}"
                                                    FontSize="{Binding $parent[ListBox].DataContext.Logs.CompactDensity, Converter={x:Static vm:BoolToLogsFontSizeConverter.Instance}}"
                                                    Query="{Binding $parent[ListBox].DataContext.Logs.FilterText}"
                                                    UseRegex="{Binding $parent[ListBox].DataContext.Logs.UseRegex}"
                                                    IsVisible="{Binding Source, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
                            <ctl:HighlightTextBlock LineText="{Binding Message}" Foreground="{DynamicResource UiMuted}"
                                                    FontSize="{Binding $parent[ListBox].DataContext.Logs.CompactDensity, Converter={x:Static vm:BoolToLogsFontSizeConverter.Instance}}"
                                                    TextWrapping="{Binding $parent[ListBox].DataContext.Logs.WrapLines, Converter={x:Static vm:BoolToTextWrappingConverter.Instance}}"
                                                    Query="{Binding $parent[ListBox].DataContext.Logs.FilterText}"
                                                    UseRegex="{Binding $parent[ListBox].DataContext.Logs.UseRegex}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- follow paused: floats over the list until resumed -->
                    <Button Content="⬇ 跟随" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,10,10" Padding="10,4" CornerRadius="8"
                            Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiAccent}" BorderThickness="1"
                            Foreground="{DynamicResource UiAccent}" FontSize="10"
                            Command="{Binding Logs.ResumeFollowCommand}"
                            IsVisible="{Binding Logs.FollowPaused}"
                            ToolTip.Tip="新行不再自动滚动；点击恢复跟随（或滚回底部）"/>
                  </Panel>
                </Border>

                <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="10" Margin="2,4,2,0">
                  <TextBlock Text="{Binding Logs.FileStatus}" Foreground="{DynamicResource UiGood}"
                             FontSize="9" TextWrapping="Wrap"
                             IsVisible="{Binding Logs.FileStatus, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
                  <TextBlock Text="{Binding Logs.StatusText}" Foreground="{DynamicResource UiMuted}"
                             FontSize="9" TextWrapping="Wrap"
                             IsVisible="{Binding Logs.StatusText, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
                </StackPanel>
              </Grid>

              <!-- ===== SSH ===== -->
              <Grid IsVisible="{Binding SelectedRightTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=3}"
                    RowDefinitions="Auto,*,Auto">
                <!-- edit form -->
                <Border CornerRadius="8" Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}"
                        BorderThickness="1" Padding="8" Margin="0,2,0,6">
                  <StackPanel Spacing="6">
                    <TextBlock Text="新建 / 编辑连接" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource UiMuted}"/>
                    <Grid ColumnDefinitions="*,*">
                      <TextBox Text="{Binding Ssh.EditName}" Watermark="名称 (可选)"
                               Background="{DynamicResource UiRaised}" CornerRadius="6" BorderBrush="{DynamicResource UiBorder}"
                               Foreground="{DynamicResource UiInk}" Padding="8,3" FontSize="10.5"/>
                      <TextBox Grid.Column="1" Text="{Binding Ssh.EditUser}" Watermark="用户"
                               Background="{DynamicResource UiRaised}" CornerRadius="6" BorderBrush="{DynamicResource UiBorder}"
                               Foreground="{DynamicResource UiInk}" Padding="8,3" FontSize="10.5" Margin="6,0,0,0"/>
                    </Grid>
                    <TextBox Text="{Binding Ssh.EditHost}" Watermark="主机 host / IP"
                             Background="{DynamicResource UiRaised}" CornerRadius="6" BorderBrush="{DynamicResource UiBorder}"
                             Foreground="{DynamicResource UiInk}" Padding="8,3" FontSize="10.5"
                             FontFamily="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox Text="{Binding Ssh.EditPort}" Watermark="端口"
                               Background="{DynamicResource UiRaised}" CornerRadius="6" BorderBrush="{DynamicResource UiBorder}"
                               Foreground="{DynamicResource UiInk}" Padding="8,3" FontSize="10.5"/>
                      <Button Grid.Column="1" Content="＋ 添加/更新" Margin="6,0,0,0" Padding="10,3"
                              CornerRadius="6" Background="{DynamicResource UiAccent}" Foreground="{DynamicResource UiOnAccent}" FontSize="10"
                              Command="{Binding Ssh.AddOrUpdateCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding Ssh.StatusText}" FontSize="9.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource UiWarm}"
                               IsVisible="{Binding Ssh.StatusText, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
                  </StackPanel>
                </Border>

                <!-- saved hosts -->
                <Border Grid.Row="1" CornerRadius="8" Background="{DynamicResource UiSurface}"
                        BorderBrush="{DynamicResource UiBorder}" BorderThickness="1">
                  <ListBox ItemsSource="{Binding Ssh.Hosts}" SelectedItem="{Binding Ssh.Selected}"
                           Background="Transparent" BorderThickness="0" Padding="4">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="CornerRadius" Value="6"/>
                        <Setter Property="Background" Value="Transparent"/>
                      </Style>
                      <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Background" Value="{DynamicResource UiSurface}"/>
                      </Style>
                      <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="{DynamicResource UiSurface}"/>
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="ssh:SshHost">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
                            <TextBlock Text="{Binding CommandLine}" FontSize="9" Foreground="{DynamicResource UiFaint}"
                                       FontFamily="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                          </StackPanel>
                          <Button Grid.Column="1" Content="连接" Padding="8,2" Margin="6,0,0,0"
                                  CornerRadius="5" Background="{DynamicResource UiRaised}" Foreground="{DynamicResource UiAccent}"
                                  BorderBrush="{DynamicResource UiBorder}" FontSize="10"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Ssh.ConnectCommand}"
                                  CommandParameter="{Binding}"/>
                          <Button Grid.Column="2" Content="✕" Padding="6,2" Margin="4,0,0,0"
                                  CornerRadius="5" Background="Transparent" Foreground="{DynamicResource UiFaint}"
                                  BorderThickness="0" FontSize="10"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Ssh.RemoveCommand}"
                                  CommandParameter="{Binding}"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>

                <TextBlock Grid.Row="2" FontSize="9" Foreground="{DynamicResource UiFaint}" Margin="2,6,2,0"
                           TextWrapping="Wrap"
                           Text="连接使用本机 ssh 命令:密码 / 密钥确认直接在终端会话中完成;密钥建议用 ssh-agent 或 ~/.ssh/config。"/>
              </Grid>

              <Grid IsVisible="{Binding SelectedRightTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=4}"
                    RowDefinitions="Auto,*,Auto">
                <WrapPanel Orientation="Horizontal">
                  <Button Content="上一条" Margin="0,0,6,6" Command="{Binding PreviousCommandCommand}"/>
                  <Button Content="下一条" Margin="0,0,6,6" Command="{Binding NextCommandCommand}"/>
                  <Button Content="定位" Margin="0,0,6,6" Command="{Binding LocateCommandCommand}"/>
                  <Button Content="复制命令和输出" Margin="0,0,6,6" Command="{Binding CopyCommandRecordCommand}"/>
                  <Button Content="保存为文本" Margin="0,0,6,6" Click="OnSaveCommandRecord"
                          ToolTip.Tip="把选中的命令和输出保存为 UTF-8 .txt"/>
                </WrapPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding CommandRecords}" SelectedItem="{Binding SelectedCommand}"
                         Background="Transparent" BorderThickness="0" DoubleTapped="OnCommandDoubleTapped">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CommandRecordViewModel">
                      <StackPanel Margin="2,4" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource UiInk}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource UiMuted}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LocateText}" FontSize="10" Foreground="{DynamicResource UiFaint}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Spacing="4" Margin="2,6,2,0">
                  <TextBlock Text="{Binding CommandNotice}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiAccent}"/>
                  <TextBlock Text="只记录带命令开始/完成标记的终端。历史被裁掉后不能定位，也不会复制到别的命令。" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource UiFaint}"/>
                </StackPanel>
              </Grid>

            </Panel>
          </Grid>
        </Border>
      </Grid>

      <!-- ============ Status bar ============ -->
      <Border Grid.Row="3" Background="{DynamicResource UiCanvas}" Padding="26,0">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="▦" Foreground="{DynamicResource UiFaint}" FontSize="11" VerticalAlignment="Center"/>
              <TextBlock Text="工作空间" Foreground="{DynamicResource UiMuted}" FontSize="11"/>
              <TextBlock Text="{Binding ActiveDirectoryName}" Foreground="{DynamicResource UiInk}" FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock Text="{Binding LaunchNotice}" Foreground="{DynamicResource UiBad}" FontSize="11"
                       TextTrimming="CharacterEllipsis" MaxWidth="420"
                       ToolTip.Tip="{Binding LaunchNotice}"
                       IsVisible="{Binding LaunchNotice, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
            <TextBlock Text="{Binding TerminalCount, StringFormat='◔ {0} 个终端'}" Foreground="{DynamicResource UiMuted}" FontSize="11"/>
            <TextBlock Text="{Binding RunningCount, StringFormat='⊕ {0} 个运行中'}" Foreground="{DynamicResource UiMuted}" FontSize="11"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <TextBlock Text="{Binding CpuText}" Foreground="{DynamicResource UiMuted}" FontSize="11"/>
            <TextBlock Text="{Binding MemText}" Foreground="{DynamicResource UiMuted}" FontSize="11"/>
            <ctl:SparklineControl Values="{Binding StatusSpark}" Stroke="{DynamicResource UiAccent}" Width="50" Height="14" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border x:Name="DockSpace" Grid.Row="2" Height="112"
              IsVisible="{Binding DockVisibilityMode, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=1}"/>
    </Grid>

    <Border x:Name="DockHint" HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Width="82" Height="30" CornerRadius="15" Background="Transparent" Margin="0,0,0,11" ZIndex="101"
            PointerEntered="OnDockHintEntered"
            IsVisible="{Binding DockVisibilityMode, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=0}">
      <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center"><PathIcon Data="{StaticResource ToolTools}" Width="14" Height="14" Foreground="{DynamicResource UiInk}"/><TextBlock Text="工具" FontSize="11" Foreground="{DynamicResource UiInk}" VerticalAlignment="Center"/></StackPanel>
    </Border>
    <!-- ============ Floating action dock ============ -->
    <ctl:DropletDock x:Name="ActionDock" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,11"
            Padding="8" ZIndex="100"
            Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}">
      <ctl:DropletDock.Styles>
        <Style Selector="PathIcon"><Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Style>
        <Style Selector="Button.dock">
          <Setter Property="Padding" Value="16,10"/>
          <Setter Property="CornerRadius" Value="12"/><Setter Property="MinWidth" Value="72"/><Setter Property="VerticalContentAlignment" Value="Top"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="RenderTransform" Value="translateY(0px)"/>
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut"/><BrushTransition Property="Background" Duration="0:0:0.18"/><BrushTransition Property="Foreground" Duration="0:0:0.18"/>
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="Button.dock:pointerover">
          <Setter Property="RenderTransform" Value="translateY(-2px)"/>
          <Setter Property="Background" Value="{DynamicResource UiRaised}"/>
          <Setter Property="Foreground" Value="{DynamicResource UiInk}"/>
        </Style>
        <Style Selector="Button.dock.dock-active">
          <Setter Property="Background" Value="{DynamicResource UiAccentSoft}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
          <Setter Property="Foreground" Value="{DynamicResource UiInk}"/>
        </Style>
      </ctl:DropletDock.Styles>
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="dock" Classes.dock-active="{Binding DockHighlight, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=1}"
                Command="{Binding DockSelectCommand}" CommandParameter="1">
          <StackPanel>
            <PathIcon Data="{StaticResource ToolMonitor}" HorizontalAlignment="Center"/>
            <TextBlock Text="监控" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
          </StackPanel>
        </Button>
        <Button Classes="dock" Classes.dock-active="{Binding DockHighlight, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=2}"
                Command="{Binding DockSelectCommand}" CommandParameter="2">
          <StackPanel>
            <PathIcon Data="{StaticResource ToolSsh}" HorizontalAlignment="Center"/>
            <TextBlock Text="SSH" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
          </StackPanel>
        </Button>
        <Button Classes="dock" Classes.dock-active="{Binding DockHighlight, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=3}"
                Command="{Binding DockSelectCommand}" CommandParameter="3">
          <StackPanel>
            <PathIcon Data="{StaticResource ToolLogs}" HorizontalAlignment="Center"/>
            <TextBlock Text="日志" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
          </StackPanel>
        </Button>
        <!-- Click: open artifacts, or publish if none. Ctrl+click / right-click 重新打包: force republish.
             Right-click also switches publish profiles, opens recent artifacts, opens the last
             successful artifact, copies its path, clears last result, and cancels a running publish.
             Under Deploy: last exit (or live packing elapsed) then the active profile name · RID. -->
        <Button x:Name="DeployDockButton" Classes="dock"
                Classes.dock-active="{Binding DockHighlight, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=4}"
                Command="{Binding DockSelectCommand}" CommandParameter="4"
                ToolTip.Tip="{Binding DeployDockTip}">
          <Button.ContextFlyout>
            <MenuFlyout Opening="OnDeployMenuOpening">
              <MenuItem Header="重新打包 Republish" Click="OnRepublishMenuClick"/>
              <MenuItem Header="取消打包 Cancel" Click="OnCancelPublishMenuClick"
                        IsEnabled="{Binding IsPublishRunning}"/>
              <Separator/>
              <MenuItem Header="配置档 Profiles">
                <MenuItem Header="（无已存配置）" IsEnabled="False"/>
              </MenuItem>
              <MenuItem Header="保存当前配置 Save profile" Click="OnSavePublishProfileClick"/>
              <MenuItem Header="删除配置档 Delete profile">
                <MenuItem Header="（无已存配置）" IsEnabled="False"/>
              </MenuItem>
              <Separator/>
              <MenuItem Header="打开上次成功产物 Open last success" Click="OnOpenLastSuccessClick"
                        IsEnabled="False"/>
              <MenuItem Header="复制上次成功产物路径 Copy last artifact path" Click="OnCopyLastSuccessPathClick"
                        IsEnabled="False"/>
              <MenuItem Header="清除上次发布结果 Clear last result" Click="OnClearLastPublishResultClick"
                        IsEnabled="False"/>
              <MenuItem Header="最近产物 Recent">
                <MenuItem Header="（暂无产物）" IsEnabled="False"/>
              </MenuItem>
            </MenuFlyout>
          </Button.ContextFlyout>
          <StackPanel>
            <PathIcon Data="{StaticResource ToolDeploy}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding DeployDockCaption}" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding LastPublishBadge}" FontSize="9"
                       HorizontalAlignment="Center" Margin="0,1,0,0"
                       IsVisible="{Binding HasLastPublishBadge}"
                       TextWrapping="NoWrap"/>
            <!-- Quiet active-profile line under the last-publish badge (name · RID). -->
            <TextBlock Text="{Binding ActivePublishProfileLabel}" FontSize="8"
                       HorizontalAlignment="Center" Margin="0,1,0,0" Opacity="0.72"
                       IsVisible="{Binding HasActivePublishProfileLabel}"
                       TextWrapping="NoWrap"/>
          </StackPanel>
        </Button>

      </StackPanel>
    </ctl:DropletDock>

    <Border x:Name="ShellSetupPanel" IsVisible="{Binding ShellSetupOpen}" ZIndex="210"
            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Margin="24"
            Padding="24" Background="{DynamicResource UiCanvas}" BorderBrush="{DynamicResource UiBorder}"
            BorderThickness="1" BoxShadow="{DynamicResource SurfaceShadow}" CornerRadius="18">
      <StackPanel Spacing="14">
        <TextBlock Text="选择你的第一个 Shell" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
        <TextBlock Text="{Binding ShellSetupMessage}" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/>
        <ComboBox x:Name="StartupShellPicker" ItemsSource="{Binding AvailableStartupShells}"
                  SelectedItem="{Binding SelectedStartupShell}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="corepty:AvailableShell">
              <TextBlock Text="{Binding Name}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox Text="{Binding StartupCustomShell}" Watermark="或填写自定义 Shell 的完整路径"/>
        <Button Content="开始使用" Command="{Binding ContinueShellSetupCommand}" HorizontalAlignment="Right"/>
      </StackPanel>
    </Border>

    <!-- Floating, grouped preferences; header and actions stay visible when scrolling. -->
    <Border x:Name="SettingsPanel" IsVisible="{Binding SettingsOpen}" ZIndex="200"
            HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="440" Margin="16"
            Background="{DynamicResource UiCanvas}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1"
            BoxShadow="{DynamicResource SurfaceShadow}" CornerRadius="18" ClipToBounds="True">
      <Grid RowDefinitions="76,*,66">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="22,16">
          <Border Width="38" Height="38" Background="{DynamicResource UiAccentSoft}" CornerRadius="10">
            <PathIcon Data="{StaticResource ToolSettings}" Width="20" Height="20" Foreground="{DynamicResource UiAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="设置" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
            <TextBlock Text="让工作空间更合你的习惯" FontSize="11" Foreground="{DynamicResource UiMuted}"/>
          </StackPanel>
          <Button Grid.Column="2" Content="×" Width="28" Height="28" Padding="0" CornerRadius="14"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Background="{DynamicResource UiRaised}" Foreground="{DynamicResource UiMuted}" BorderThickness="0"
                  Command="{Binding DockSelectCommand}" CommandParameter="5" ToolTip.Tip="关闭设置"/>
        </Grid>
        <TabControl x:Name="SettingsTabs" Grid.Row="1" Margin="16,0,16,12">
          <TabItem Header="外观">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="12" Margin="4,12,4,4">
                <Border Classes="settings-group">
                  <StackPanel Spacing="10">
                    <TextBlock Text="主题与终端文字" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
                    <ComboBox x:Name="ThemePicker" SelectedIndex="{Binding ThemeIndex}">
                      <ComboBoxItem>深蓝玻璃</ComboBoxItem><ComboBoxItem>深黑</ComboBoxItem>
                      <ComboBoxItem>亮白</ComboBoxItem><ComboBoxItem>纸张</ComboBoxItem>
                    </ComboBox>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                      <Button Content="−" Classes="terminal-tool" Command="{Binding DecreaseFontSizeCommand}" ToolTip.Tip="缩小字体"/>
                      <NumericUpDown Grid.Column="1" Value="{Binding FontSize}" Minimum="8" Maximum="32" Increment="1" FormatString="0"/>
                      <Button Grid.Column="2" Content="＋" Classes="terminal-tool" Command="{Binding IncreaseFontSizeCommand}" ToolTip.Tip="放大字体"/>
                      <Button Grid.Column="3" Content="重置" Classes="terminal-tool" Command="{Binding ResetTerminalFontSizeCommand}"/>
                    </Grid>
                    <TextBox Text="{Binding TerminalFontName}" Watermark="等宽字体：默认 Cascadia / Consolas"/>
                    <TextBlock Text="Ctrl+= / Ctrl+− 调整字号 · Ctrl+0 重置" FontSize="11" Foreground="{DynamicResource UiMuted}"/>
                  </StackPanel>
                </Border>
                <TextBlock Classes="settings-heading" Text="实时预览"/>
                <Border Background="{DynamicResource UiInset}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                  <StackPanel Spacing="8">
                    <TextBlock Text="PS C:\Projects&gt;" FontFamily="{Binding TerminalFont}" FontSize="{Binding FontSize}" Foreground="{DynamicResource UiAccent}"/>
                    <TextBlock Text="Terminal Hub · 中文与 English 012345" FontFamily="{Binding TerminalFont}" FontSize="{Binding FontSize}" Foreground="{DynamicResource UiInk}" TextWrapping="Wrap"/>
                    <TextBlock Text="✓ Build succeeded" FontFamily="{Binding TerminalFont}" FontSize="{Binding FontSize}" Foreground="{DynamicResource UiGood}"/>
                  </StackPanel>
                </Border>
                <TextBlock Text="主题、字体和字号立即应用，点击「完成」保存。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource UiMuted}"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="工作区">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Border Classes="settings-group" Margin="4,12,4,4">
                <StackPanel Spacing="14">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="右侧工具栏" Foreground="{DynamicResource UiInk}" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding InspectorVisible}" OnContent="" OffContent="" MinWidth="0"/></Grid>
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="下方输出区" Foreground="{DynamicResource UiInk}" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding OutputVisible}" OnContent="" OffContent="" MinWidth="0"/></Grid>
                  <TextBlock Text="Dock 显示方式" Foreground="{DynamicResource UiInk}"/>
                  <ComboBox SelectedIndex="{Binding DockVisibilityMode}"><ComboBoxItem>自动隐藏 · 底部「工具」呼出</ComboBoxItem><ComboBoxItem>始终显示</ComboBoxItem><ComboBoxItem>隐藏</ComboBoxItem></ComboBox>
                  <TextBlock Text="工作空间名称" Foreground="{DynamicResource UiInk}"/>
                  <TextBox Text="{Binding WorkspaceNameLive}"/>
                  <TextBlock Text="工作区模板" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
                  <ComboBox x:Name="WorkspaceTemplatePicker" ItemsSource="{Binding WorkspaceTemplates}" SelectedItem="{Binding SelectedTemplate}">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="settings:WorkspaceTemplate"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBox Text="{Binding TemplateName}" Watermark="模板名称，例如：前端项目"/>
                  <WrapPanel>
                    <Button Content="存为新模板" Command="{Binding SaveCurrentAsTemplateCommand}" Margin="0,0,6,6"/>
                    <Button Content="打开模板" Command="{Binding OpenTemplateCommand}" IsEnabled="{Binding !IsOpeningTemplate}" Margin="0,0,6,6"/>
                    <Button Content="保存修改" Command="{Binding SaveTemplateChangesCommand}" Margin="0,0,6,6"/>
                    <Button Content="更新为当前布局" Command="{Binding UpdateTemplateLayoutCommand}" Margin="0,0,6,6"/>
                    <Button Content="复制模板" Command="{Binding DuplicateTemplateCommand}" Margin="0,0,6,6"/>
                    <Button Content="导出模板" Click="OnExportTemplate" Margin="0,0,6,6"/>
                    <Button Content="导入模板" Click="OnImportTemplate" Margin="0,0,6,6"/>
                    <Button Content="删除模板" Command="{Binding DeleteTemplateCommand}" Margin="0,0,6,6"/>
                  </WrapPanel>
                  <TextBlock Text="打开前预览" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
                  <TextBlock Text="{Binding TemplatePreview}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/>
                  <TextBlock Text="{Binding TemplateMessage}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiAccent}"/>
                  <TextBlock Text="预览显示当前编辑。打开当前选中的模板会带上这些修改，并保留现有终端。启动命令只在打开且启用时执行；导入不会执行。" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/>
                  <TextBlock Text="会话分组" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
                  <ItemsControl ItemsSource="{Binding SessionGroups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="settings:SessionGroup">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                          <TextBox Text="{Binding Name}" Watermark="分组名称"/>
                          <Button Grid.Column="1" Content="删除" Margin="6,0,0,0"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteGroupCommand}"
                                  CommandParameter="{Binding}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="新建分组" Click="OnCreateEmptyGroup" HorizontalAlignment="Left"/>
                  <ItemsControl ItemsSource="{Binding TemplateSessions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WorkspaceSessionEditor">
                        <Expander Header="{Binding Name}" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                          <StackPanel Spacing="8">
                            <TextBox Text="{Binding Name}" Watermark="终端名称"/>
                            <TextBox Text="{Binding WorkingDirectory}" Watermark="工作目录"/>
                            <TextBox Text="{Binding Shell}" Watermark="Shell"/>
                            <TextBox Text="{Binding Arguments}" Watermark="Shell 参数"/>
                            <TextBox Text="{Binding StartupCommand}" Watermark="启动命令，例如：npm run dev"/>
                            <CheckBox Content="打开模板时执行启动命令（本地 Shell）" IsChecked="{Binding RunStartupCommand}" IsEnabled="{Binding CanRunStartupCommand}"/>
                          </StackPanel>
                        </Expander>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="快捷键">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="12" Margin="4,12,4,4">
                <TextBlock Text="点击右侧输入框，再按你想使用的快捷键。Backspace / Delete 清除；Tab 移到下一项。" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/>
                <TextBlock Text="Alt+1 到 Alt+9 按侧栏完整顺序切换，包括折叠分组里的终端。置顶或拖动后序号跟着新顺序变化。" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/>
                <ItemsControl ItemsSource="{Binding SessionShortcuts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionShortcutViewModel">
                      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,180" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource UiInk}" VerticalAlignment="Center"/>
                        <ctl:ShortcutEditor Grid.Column="1" Text="{Binding Gesture, Mode=TwoWay}" ToolTip.Tip="按快捷键录入；Backspace 清除"/>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Error}" Foreground="{DynamicResource UiBad}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" IsVisible="{Binding Error, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="恢复默认快捷键" Command="{Binding ResetSessionShortcutsCommand}"/>
                <TextBlock Text="空白表示不绑定；有冲突的快捷键不会生效。" FontSize="11" Foreground="{DynamicResource UiMuted}"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="启动">
            <Border Classes="settings-group" Margin="4,12,4,4" VerticalAlignment="Top">
              <StackPanel Spacing="12">
                <TextBlock Text="新终端使用" Foreground="{DynamicResource UiInk}"/>
                <ComboBox SelectedIndex="{Binding ShellIndex}"><ComboBoxItem>PowerShell (pwsh)</ComboBoxItem><ComboBoxItem>cmd.exe</ComboBoxItem><ComboBoxItem>WSL / bash</ComboBoxItem><ComboBoxItem>bash</ComboBoxItem><ComboBoxItem>自定义</ComboBoxItem></ComboBox>
                <TextBlock Text="自定义 Shell 路径" Foreground="{DynamicResource UiInk}"/>
                <TextBox Text="{Binding Settings.CustomShellPath}" Watermark="C:\…\pwsh.exe"/>
                <CheckBox Content="在资源管理器文件夹右键中显示 Terminal Hub" IsChecked="{Binding ExplorerMenuEnabled}"/>
                <TextBlock Text="{Binding ExplorerMenuMessage}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/>
                <TextBlock Text="勾选后，文件夹或其空白处的右键菜单会出现“在 Terminal Hub 中打开”。取消勾选即移除。带空格或中文的路径会传给已打开的窗口。" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/>
              </StackPanel>
            </Border>
          </TabItem>
          <TabItem Header="关于">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="4,12">
              <TextBlock Text="Terminal Hub" FontSize="20" Foreground="{DynamicResource UiInk}"/>
              <TextBlock Text="{Binding AppVersionText}" Foreground="{DynamicResource UiMuted}"/>
              <TextBlock Text="报错行号编辑器（可选 VS Code / Code.exe）" FontSize="11" Foreground="{DynamicResource UiMuted}"/>
              <TextBox Text="{Binding Settings.FileEditorPath}" Watermark="留空用记事本打开；Code.exe 支持定位行号"/>
              <CheckBox Content="提醒后台命令完成或失败" IsChecked="{Binding Settings.NotifyCommandCompletion}"/>
              <TextBlock Text="支持命令完成协议的 Shell 提供结果与耗时；其他 Shell 保留输出与进程状态提示。" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/>
              <Button Content="查看当前版本说明" Command="{Binding OpenReleaseNotesCommand}"/>
              <Button Content="检查更新" Command="{Binding CheckForUpdatesCommand}"/>
              <Button Content="打开 GitHub 发布页" Command="{Binding OpenProjectReleasesCommand}"/>
              <TextBlock Text="{Binding UpdateMessage}" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/>
              <Button Content="下载新版" Command="{Binding OpenUpdateDownloadCommand}" IsEnabled="{Binding HasUpdate}"/>
            </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="命令">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="12" Margin="4,12,4,4">
                <TextBlock Text="收藏命令会填入当前终端，不会自动按 Enter。多行命令只在终端开启括号粘贴时填入；否则不填入，避免逐行执行。Shell 不一致时仍会填入单行命令，并给出提示。" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/>
                <TextBlock Text="{Binding FavoriteNotice}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiAccent}"/>
                <ItemsControl ItemsSource="{Binding FavoriteCommands}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FavoriteCommandViewModel">
                      <Border BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel Spacing="8">
                          <TextBox Text="{Binding Name}" Watermark="名称，例如：启动开发服务"/>
                          <TextBox Text="{Binding Command}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Watermark="命令文本"/>
                          <TextBox Text="{Binding Shell}" Watermark="适用 Shell，留空表示任意"/>
                          <ctl:ShortcutEditor Text="{Binding Shortcut, Mode=TwoWay}" ToolTip.Tip="可选快捷键。按键录入；Backspace 清除"/>
                          <TextBlock Text="{Binding Error}" Foreground="{DynamicResource UiBad}" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
                          <Button Content="删除" HorizontalAlignment="Left"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteFavoriteCommand}"
                                  CommandParameter="{Binding}"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="添加收藏" Command="{Binding AddFavoriteCommand}" HorizontalAlignment="Left"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="0,1,0,0" Padding="20,12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="你的终端，你的工作空间" FontSize="11" Foreground="{DynamicResource UiMuted}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="完成" MinWidth="86" Background="{DynamicResource UiAccent}" Foreground="{DynamicResource UiOnAccent}" CornerRadius="8"
                    Padding="18,8" HorizontalContentAlignment="Center" Command="{Binding SaveSettingsCommand}"/>
          </Grid>
        </Border>
      </Grid>
    </Border>
    <Border ZIndex="290" Background="#66000000" IsVisible="{Binding #PalettePanel.IsVisible}" PointerPressed="OnPaletteBackdrop"/>
    <Border x:Name="PalettePanel" IsVisible="False" ZIndex="300" Width="620" MaxHeight="500"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,90,24,24" Padding="20"
            Background="{DynamicResource UiCanvas}" BorderBrush="{DynamicResource UiAccent}" BorderThickness="1"
            BoxShadow="{DynamicResource SurfaceShadow}" CornerRadius="14">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <TextBlock Text="查找终端与操作" Foreground="{DynamicResource UiInk}" FontSize="17" FontWeight="SemiBold"/>
        <TextBox x:Name="PaletteSearch" Grid.Row="1" Watermark="输入终端名、目录或操作…" TextChanged="OnPaletteTextChanged"/>
        <ListBox x:Name="PaletteResults" Grid.Row="2" MaxHeight="320" Background="Transparent" BorderThickness="0" DoubleTapped="OnExecutePalette">
          <ListBox.Styles>
            <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource UiRaised}"/></Style>
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource UiAccentSoft}"/></Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PaletteEntry">
              <Grid ColumnDefinitions="*,Auto" Margin="6,5">
                <StackPanel Spacing="4"><TextBlock Text="{Binding Label}" Foreground="{DynamicResource UiInk}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource UiMuted}" TextTrimming="CharacterEllipsis"/></StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Shortcut}" Foreground="{DynamicResource UiFaint}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Spacing="6"><TextBlock x:Name="PaletteEmpty" Text="没有匹配的终端或操作" Foreground="{DynamicResource UiMuted}"/><TextBlock Text="↑ ↓ 选择 · Enter 执行 · Esc 返回" FontSize="11" Foreground="{DynamicResource UiFaint}"/></StackPanel>
      </Grid>
    </Border>
    <Border IsVisible="{Binding NotificationVisible}" ZIndex="220" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24,0,24,90" MaxWidth="380" Padding="16" CornerRadius="12" Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiAccent}" BorderThickness="1">
      <StackPanel Spacing="10"><TextBlock Text="{Binding NotificationText}" TextWrapping="Wrap" Foreground="{DynamicResource UiInk}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="查看终端" Command="{Binding ShowNotificationSessionCommand}"/><Button Content="关闭" Command="{Binding DismissNotificationCommand}"/></StackPanel></StackPanel>
    </Border>
    <Border ZIndex="290" Background="#66000000" IsVisible="{Binding #BookmarkPanel.IsVisible}" PointerPressed="OnBookmarkBackdrop"/>
    <Border x:Name="BookmarkPanel" IsVisible="False" ZIndex="300" Width="760" MaxHeight="620"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,80,24,24" Padding="20"
            Background="{DynamicResource UiCanvas}" BorderBrush="{DynamicResource UiAccent}" BorderThickness="1"
            BoxShadow="{DynamicResource SurfaceShadow}" CornerRadius="14">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="输出书签" Foreground="{DynamicResource UiInk}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Content="当前会话" Classes="terminal-tool" Padding="10,3" FontSize="11"
                    Classes.selected="{Binding !BookmarksAllSessions}" Click="OnBookmarkScopeSession"/>
            <Button Content="全部" Classes="terminal-tool" Padding="10,3" FontSize="11"
                    Classes.selected="{Binding BookmarksAllSessions}" Click="OnBookmarkScopeAll"/>
          </StackPanel>
        </Grid>
        <TextBox x:Name="BookmarkSearch" Grid.Row="1" Watermark="按名称、会话或保存的文字筛选…" TextChanged="OnBookmarkSearchChanged"/>
        <TextBlock Grid.Row="2" FontSize="10" Foreground="{DynamicResource UiFaint}" TextWrapping="Wrap"
                   Text="书签保存的是文字快照。来源输出被裁剪、会话关闭或应用重启后，定位不可用，文字仍可查看复制。"/>
        <ListBox x:Name="BookmarkResults" Grid.Row="3" MaxHeight="220" Background="Transparent" BorderThickness="0"
                 ItemsSource="{Binding VisibleBookmarks}" SelectedItem="{Binding SelectedBookmark}" Tapped="OnBookmarkTapped">
          <ListBox.Styles>
            <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource UiRaised}"/></Style>
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource UiAccentSoft}"/></Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:BookmarkViewModel">
              <Grid ColumnDefinitions="*,Auto" Margin="6,5">
                <StackPanel Spacing="3" MinWidth="0">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Meta}" FontSize="10" Foreground="{DynamicResource UiMuted}"/>
                  <TextBlock Text="{Binding Preview}" FontSize="10" Foreground="{DynamicResource UiFaint}" TextTrimming="CharacterEllipsis" MaxWidth="440"/>
                  <TextBlock Text="{Binding LocateText}" FontSize="10" Foreground="{DynamicResource UiAccent}"
                             IsVisible="{Binding LocateText, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                  <Button Content="查看" FontSize="10" Padding="8,2" CornerRadius="5" Click="OnViewBookmark"
                          ToolTip.Tip="查看保存的完整文字"/>
                  <Button Content="定位" FontSize="10" Padding="8,2" CornerRadius="5"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LocateBookmarkCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="跳转到原输出位置"/>
                  <Button Content="复制" FontSize="10" Padding="8,2" CornerRadius="5"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyBookmarkCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="复制保存的文字"/>
                  <Button Content="改名" FontSize="10" Padding="8,2" CornerRadius="5" Click="OnRenameBookmark"
                          ToolTip.Tip="重命名书签"/>
                  <Button Content="删除" FontSize="10" Padding="8,2" CornerRadius="5"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteBookmarkCommand}" CommandParameter="{Binding}"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="4" RowDefinitions="Auto,Auto" RowSpacing="6"
              IsVisible="{Binding SelectedBookmark, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="保存的完整文字" FontSize="11" Foreground="{DynamicResource UiMuted}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="SaveBookmarkButton" Content="保存书签为文本" FontSize="11" Padding="10,3" Click="OnSaveBookmark"/>
          </Grid>
          <TextBox x:Name="BookmarkSnapshotText" Grid.Row="1" Text="{Binding SelectedBookmark.Text}" IsReadOnly="True"
                   AcceptsReturn="True" TextWrapping="NoWrap" Height="130"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Grid>
        <StackPanel Grid.Row="5" Spacing="5">
          <TextBlock Text="{Binding BookmarkNotice}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiAccent}"
                     IsVisible="{Binding BookmarkNotice, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
          <TextBlock x:Name="BookmarkEmpty" Text="还没有书签" FontSize="11" Foreground="{DynamicResource UiMuted}" TextWrapping="Wrap"/>
          <TextBlock Text="查看：阅读完整文字 · 点击条目或按 Enter 定位 · Esc 返回" FontSize="11" Foreground="{DynamicResource UiFaint}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="ToastPanel" IsVisible="False" ZIndex="310" HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Margin="24,0,24,96" Padding="14,8" CornerRadius="10" MaxWidth="620"
            Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiAccent}" BorderThickness="1">
      <TextBlock x:Name="ToastText" FontSize="11" Foreground="{DynamicResource UiInk}" TextWrapping="Wrap"/>
    </Border>
  </Panel>
</Window>
