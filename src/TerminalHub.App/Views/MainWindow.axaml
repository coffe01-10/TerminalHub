<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:TerminalHub.App.Localization"
        xmlns:vm="using:TerminalHub.App.ViewModels"
        xmlns:ctl="using:TerminalHub.App.Controls"
        xmlns:mon="using:TerminalHub.Core.Monitoring"
        xmlns:files="using:TerminalHub.Core.Files"
        xmlns:ssh="using:TerminalHub.Core.Ssh"
        xmlns:corepty="using:TerminalHub.Core.Pty"
        xmlns:ai="using:TerminalHub.Core.Ai"
        xmlns:settings="using:TerminalHub.Core.Settings"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="TerminalHub.App.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:Translate {Binding WindowTitle}}"
        Icon="avares://TerminalHub/Assets/terminal-hub-icon.ico"
        Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        Background="{DynamicResource UiCanvas}" FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="64">

  <Window.Resources>
    <StreamGeometry x:Key="ToolAdd">M7,2 H9 V7 H14 V9 H9 V14 H7 V9 H2 V7 H7 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolClose">M3,2 L8,7 L13,2 L14,3 L9,8 L14,13 L13,14 L8,9 L3,14 L2,13 L7,8 L2,3 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolBack">M7,2 L8.5,3.5 L5,7 H14 V9 H5 L8.5,12.5 L7,14 L1,8 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolForward">M9,2 L7.5,3.5 L11,7 H2 V9 H11 L7.5,12.5 L9,14 L15,8 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolRefresh">M13,2 V7 H8 L10,5 A4,4 0 1 0 12,9 H14 A6,6 0 1 1 11.5,3.5 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolSplit">M1,2 H15 V14 H1 Z M3,4 V12 H7 V4 Z M9,4 V12 H13 V4 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolPopout">M9,1 H15 V7 H13 V4.5 L7.5,10 L6,8.5 L11.5,3 H9 Z M1,4 H6 V6 H3 V13 H10 V10 H12 V15 H1 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolMore">M2,7 H4 V9 H2 Z M7,7 H9 V9 H7 Z M12,7 H14 V9 H12 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolOutput">M1,2 H15 V14 H1 Z M3,4 V9 H13 V4 Z M3,11 V12 H13 V11 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolSearch">M7,1 A6,6 0 1 0 7,13 A6,6 0 1 0 7,1 M7,3 A4,4 0 1 1 7,11 A4,4 0 1 1 7,3 M11,10 L16,15 L14.5,16.5 L9.5,11.5 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolTools">M5,1 H11 V4 H15 V14 H1 V4 H5 Z M6.5,2.5 V4 H9.5 V2.5 Z M2.5,5.5 V8 H6.5 V7 H9.5 V8 H13.5 V5.5 Z M2.5,9.5 V12.5 H13.5 V9.5 H9.5 V11 H6.5 V9.5 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolSettings">M6,1 H10 V3 L12,4 L14,3 L16,6 L14,8 L14,10 L16,12 L14,15 L12,14 L10,15 H6 L4,14 L2,15 L0,12 L2,10 V8 L0,6 L2,3 L4,4 L6,3 Z M8,5 A3,3 0 1 0 8,11 A3,3 0 1 0 8,5 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolWindow">M1,2 H15 V14 H1 Z M3,4 V12 H13 V4 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolMinimize">M2,7 H14 V9 H2 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolMonitor">M1,11 H4 V15 H1 Z M6,6 H9 V15 H6 Z M11,1 H14 V15 H11 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolSsh">M1,3 L6,8 L1,13 L2.5,14.5 L9,8 L2.5,1.5 Z M9,12 H15 V14 H9 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolLogs">M1,2 H15 V14 H1 Z M3,4 V5 H13 V4 Z M3,7 V8 H13 V7 Z M3,10 V12 H10 V10 Z</StreamGeometry>
    <StreamGeometry x:Key="ToolDeploy">M1,8 L8,1 L15,8 L13.5,9.5 L9,5 V13 H7 V5 L2.5,9.5 Z M2,13 H4 V15 H12 V13 H14 V17 H2 Z</StreamGeometry>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Border.workspace-tab.session-drop">
      <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
      <Setter Property="Background" Value="{DynamicResource UiAccentSoft}"/>
    </Style>
    <Style Selector="ctl|StageCard.session-drop">
      <Setter Property="Opacity" Value="0.65"/>
    </Style>
    <Style Selector="Border.workspace-tab">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Margin" Value="0,4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Border.workspace-tab:pointerover"><Setter Property="Background" Value="{DynamicResource UiSurface}"/></Style>
    <Style Selector="Border.workspace-tab.active"><Setter Property="Background" Value="{DynamicResource UiAccentSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource UiAccentSoft}"/></Style>
    <Style Selector="Border.workspace-tab.dragging"><Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/><Setter Property="Opacity" Value="0.85"/></Style>
    <Style Selector="Button.workspace-name">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,0,8,0"/>
      <Setter Property="Height" Value="30"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
      <Setter Property="Template"><ControlTemplate><ContentPresenter Content="{TemplateBinding Content}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/></ControlTemplate></Setter>
    </Style>
    <Style Selector="Border.workspace-tab.active Button.workspace-name"><Setter Property="Foreground" Value="{DynamicResource UiAccent}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Border.workspace-tab:pointerover Button.workspace-name"><Setter Property="Foreground" Value="{DynamicResource UiInk}"/></Style>
    <Style Selector="Border.workspace-tab Button.workspace-close"><Setter Property="Opacity" Value="0.4"/><Setter Property="Height" Value="24"/><Setter Property="MinWidth" Value="24"/><Setter Property="Padding" Value="5"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
    <Style Selector="Border.workspace-tab.active Button.workspace-close, Border.workspace-tab:pointerover Button.workspace-close"><Setter Property="Opacity" Value="1"/></Style>
    <Style Selector="Border.workspace-tab Border.workspace-count"><Setter Property="Background" Value="{DynamicResource UiSurface}"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="5,1"/><Setter Property="MinWidth" Value="18"/></Style>
    <Style Selector="Button.terminal-tool">
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.terminal-tool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource UiRaised}"/>
      <Setter Property="Foreground" Value="{DynamicResource UiInk}"/>
    </Style>
    <Style Selector="Button.terminal-tool:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource UiInset}"/>
    </Style>
    <Style Selector="Button.terminal-tool:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="Button.terminal-tool.selected">
      <Setter Property="Background" Value="{DynamicResource UiAccentSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
    </Style>
    <Style Selector="Button.terminal-tool PathIcon">
      <Setter Property="Width" Value="14"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
    </Style>
    <Style Selector="Button.terminal-tool.selected PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
    </Style>
    <Style Selector="Button.terminal-tool:pointerover PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource UiInk}"/>
    </Style>
    <Style Selector="Button.dock PathIcon">
      <Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/>
      <Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
    </Style>
    <Style Selector="Button.dock.dock-active PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
    </Style>
    <Style Selector="TabControl#SettingsTabs TabItem">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style Selector="Border.settings-group">
      <Setter Property="Background" Value="{DynamicResource UiSurface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style Selector="ctl|ShelfDrawer.floating">
      <Setter Property="Background" Value="{DynamicResource UiFloating}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BoxShadow" Value="{DynamicResource FloatingShadow}"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="4,10,4,10"/>
    </Style>
    <Style Selector="TextBlock.settings-heading">
      <Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="5,6,0,0"/>
    </Style>
    <Style Selector="Border#SettingsPanel TextBox, Border#SettingsPanel ComboBox">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
  </Window.Styles>

  <Window.KeyBindings>
    <!-- Session shortcuts live in OnSessionShortcutKeyDown (tunnel handler) so bare
         Ctrl+letter control bytes keep reaching the PTY: app chords are Ctrl+Shift+*. -->
  </Window.KeyBindings>

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Panel>
    <ctl:WorkspaceBackdrop/>
    <Grid RowDefinitions="64,42,*,Auto,Auto,32">

      <!-- ============ Title bar ============ -->
      <Border Grid.Row="0" Background="Transparent" Padding="26,0" PointerPressed="OnTitleBarPointerPressed">
        <Grid ColumnDefinitions="Auto,*">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Image Source="avares://TerminalHub/Assets/terminal-hub-icon.png" Width="32" Height="32"/>
            <TextBlock Text="Terminal Hub" FontFamily="{DynamicResource HeadingFont}" Foreground="{DynamicResource UiInk}" FontSize="17"
                       FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Text M0447}" Foreground="{DynamicResource UiMuted}" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                      Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="{Binding OsLabel}" Foreground="{DynamicResource UiFaint}" FontSize="11" VerticalAlignment="Center"/>
            <Button x:Name="ShelfToggleButton" Classes="terminal-tool" Classes.selected="{Binding !ShelfAutoHide}"
                    Command="{Binding ToggleShelfCommand}" ToolTip.Tip="{loc:Text M0448}" AutomationProperties.Name="{loc:Text M0448}">
              <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource ToolSplit}"/><TextBlock Text="{loc:Text M0449}" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button Classes="terminal-tool" Content="{loc:Text Workbench0}" Click="OnManagePlugins"/>
            <Button x:Name="PaletteButton" Classes="terminal-tool" Click="OnOpenPalette" ToolTip.Tip="{loc:Text M0450}">
              <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource ToolSearch}"/><TextBlock Text="{loc:Text M0451}" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button Classes="terminal-tool" Classes.selected="{Binding OutputVisible}" Command="{Binding ToggleOutputCommand}" ToolTip.Tip="{loc:Text M0452}">
              <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource ToolOutput}"/><TextBlock Text="{loc:Text M0336}" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button Classes="terminal-tool" Classes.selected="{Binding InspectorVisible}" Command="{Binding ToggleInspectorCommand}" ToolTip.Tip="{loc:Text M0453}">
              <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource ToolTools}"/><TextBlock Text="{loc:Text M0454}" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button Classes="terminal-tool" Classes.selected="{Binding SettingsOpen}" Command="{Binding DockSelectCommand}" CommandParameter="5" ToolTip.Tip="{loc:Text M0455}" AutomationProperties.Name="{loc:Text M0455}">
              <PathIcon Data="{StaticResource ToolSettings}"/>
            </Button>
            <Button Classes="terminal-tool" Click="OnMinimizeClick" ToolTip.Tip="{loc:Text M0456}" AutomationProperties.Name="{loc:Text M0456}"><PathIcon Data="{StaticResource ToolMinimize}"/></Button>
            <Button Classes="terminal-tool" Click="OnMaximizeClick" ToolTip.Tip="{loc:Text M0457}" AutomationProperties.Name="{loc:Text M0457}"><PathIcon Data="{StaticResource ToolWindow}"/></Button>
            <Button Classes="terminal-tool" Click="OnCloseClick" ToolTip.Tip="{loc:Text M0458}" AutomationProperties.Name="{loc:Text M0458}"><PathIcon Data="{StaticResource ToolClose}"/></Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============ Main three-rail ============ -->
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="26,0,26,0">
        <ScrollViewer x:Name="WorkspaceTabScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="WorkspaceTabs" ItemsSource="{Binding ProjectWorkspaces}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:LiveWorkspace">
              <Border Classes="workspace-tab" Classes.active="{Binding IsActive}">
                <StackPanel Orientation="Horizontal">
                  <Button Classes="workspace-name" Tag="{Binding}" Click="OnSwitchWorkspace" ToolTip.Tip="{loc:Text M0459}" AutomationProperties.Name="{Binding Name}">
                    <Button.ContextMenu><ContextMenu><MenuItem Header="{loc:Text M0388}" Tag="{Binding}" Click="OnRenameWorkspace"/></ContextMenu></Button.ContextMenu>
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      <Border Classes="workspace-count"><TextBlock Text="{Binding Count}" FontSize="10" Foreground="{DynamicResource UiMuted}" HorizontalAlignment="Center"/></Border>
                    </StackPanel>
                  </Button>
                  <Button Classes="terminal-tool workspace-close" Tag="{Binding}" Click="OnCloseWorkspace" ToolTip.Tip="{loc:Text M0460}" AutomationProperties.Name="{loc:Text M0461}"><PathIcon Data="{StaticResource ToolClose}" Width="10" Height="10"/></Button>
                </StackPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Button Grid.Column="1" Classes="terminal-tool" Command="{Binding NewProjectWorkspaceCommand}" Margin="10,0"><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource ToolAdd}"/><TextBlock Text="{loc:Text M0462}" VerticalAlignment="Center"/></StackPanel></Button>
        <Button Grid.Column="2" Classes="terminal-tool" Click="OnProjectTools"><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource ToolTools}"/><TextBlock Text="{loc:Text M0463}" VerticalAlignment="Center"/></StackPanel></Button>
      </Grid>
      <Border x:Name="ShelfEdgeHint" Grid.Row="2" Width="16" HorizontalAlignment="Left" ZIndex="60"
              IsVisible="{Binding ShelfAutoHide}" Background="Transparent" AutomationProperties.Name="{loc:Text M0464}">
        <Border Width="3" Height="52" CornerRadius="2" Background="{DynamicResource UiAccent}" Opacity="0.55"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
      </Border>
      <Border Grid.Row="2" ZIndex="80" IsVisible="{Binding BroadcastEnabled}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0" Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiAccent}" BorderThickness="1" CornerRadius="10" Padding="16,6">
        <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{loc:Translate {Binding BroadcastStatus}}" Foreground="{DynamicResource UiAccent}" VerticalAlignment="Center" MaxWidth="650" TextTrimming="CharacterEllipsis"/><Button Content="{loc:Text M0465}" Command="{Binding StopBroadcastCommand}" Classes="terminal-tool"/></StackPanel>
      </Border>
      <Grid Grid.Row="2" x:Name="StageLayout" ColumnDefinitions="280,18,*,0,0" Margin="18,10,24,14">

        <!-- ===== LEFT: perspective session shelf ===== -->
        <ctl:ShelfDrawer x:Name="ShelfHost" Grid.Column="0" Grid.ColumnSpan="5" HorizontalAlignment="Left"
                         Classes.floating="{Binding ShelfAutoHide}" ZIndex="50">
        <Grid x:Name="ShelfContent" RowDefinitions="30,*,52">
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="20,0,10,0">
            <TextBlock Text="{loc:Text M0466}" Foreground="{DynamicResource UiMuted}" FontSize="11" LetterSpacing="2" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding TerminalCount, StringFormat='{}{0:00}'}" Margin="0,0,8,0"
                       Foreground="{DynamicResource UiMuted}" FontSize="11" VerticalAlignment="Center"/>
            <Button x:Name="ShelfPinButton" Grid.Column="2" Classes="terminal-tool" Command="{Binding ToggleShelfCommand}"
                    ToolTip.Tip="{loc:Text M0367}" AutomationProperties.Name="{loc:Text M0367}">
              <Panel><TextBlock Text="‹" IsVisible="{Binding !ShelfAutoHide}" FontSize="20"/>
                <TextBlock Text="{loc:Text M0467}" IsVisible="{Binding ShelfAutoHide}" FontSize="10"/></Panel>
            </Button>
          </Grid>
          <ListBox x:Name="SessionShelf" Grid.Row="1" ItemsSource="{Binding ShelfItems}"
                   SelectedItem="{Binding ActiveCard, Mode=OneWay}" Background="Transparent" BorderThickness="0"
                   Padding="14,14,10,16" ClipToBounds="False" DoubleTapped="OnShelfBackgroundDoubleTapped"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="{x:Static vm:SessionCardViewModel.ShelfSpacing}"/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerTheme>
              <!-- A complete theme: no Fluent pointer/selection rectangle behind the tilted card. -->
              <ControlTheme TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="ClipToBounds" Value="False"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusAdorner" Value="{x:Null}"/>
                <Setter Property="Template">
                  <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Stretch"/>
                  </ControlTemplate>
                </Setter>
              </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.DataTemplates>
              <ctl:CachedShelfTemplate>
              <DataTemplate x:DataType="vm:SessionCardViewModel">
                <ctl:StageCard IsActive="{Binding IsActive}" StageDistance="{Binding StageDistance}"
                               WheelMode="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShelfAutoHide}"
                               Classes.active="{Binding IsActive}" Height="{Binding #Root.ThumbnailHeight}"
                               Margin="{Binding ShelfTopMargin}"
                               ToolTip.Tip="{Binding WorkingDirectory}" DoubleTapped="OnRenameCard">
                  <ctl:StageCard.Styles>
                    <Style Selector="ctl|StageCard > Border">
                      <Setter Property="Background" Value="{DynamicResource UiCard}"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/>
                      <Setter Property="BorderThickness" Value="1"/>
                      <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/>
                    </Style>
                    <Style Selector="ctl|StageCard:pointerover > Border">
                      <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
                      <Setter Property="Background" Value="{DynamicResource UiRaised}"/>
                      <Setter Property="BoxShadow" Value="{DynamicResource ActiveCardShadow}"/>
                    </Style>
                    <Style Selector="ctl|StageCard.active > Border">
                      <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
                      <Setter Property="BorderThickness" Value="{DynamicResource ActiveCardBorderThickness}"/>
                      <Setter Property="Background" Value="{DynamicResource UiRaised}"/>
                      <Setter Property="BoxShadow" Value="{DynamicResource ActiveCardShadow}"/>
                    </Style>
                  </ctl:StageCard.Styles>
                  <Border CornerRadius="{DynamicResource CardCorner}" Padding="9">
                  <Border.Transitions>
                    <Transitions>
                      <BrushTransition Property="Background" Duration="0:0:0.22"/>
                      <BrushTransition Property="BorderBrush" Duration="0:0:0.22"/>
                    </Transitions>
                  </Border.Transitions>
                  <Grid RowDefinitions="24,*,Auto">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="3,0,3,4">
                      <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="0,0,7,0">
                        <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" Margin="0,0,7,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource UiInk}"/>
                      </Grid>
                      <Border Grid.Column="1" IsVisible="{Binding ShowTagPill}" Background="{Binding TagPillBrush}"
                              CornerRadius="5" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Translate {Binding TagText}}" FontSize="9" Foreground="{Binding TagBrush}"/>
                      </Border>
                      <TextBlock Grid.Column="1" Text="{loc:Translate {Binding StatusText}}" Foreground="{Binding StatusBrush}"
                                 IsVisible="{Binding !ShowTagPill}" FontSize="9" VerticalAlignment="Center"/>
                      <Button Grid.Column="2" VerticalAlignment="Center" Padding="5,0" Margin="2,0,0,0"
                              Background="Transparent" BorderThickness="0" Cursor="Hand"
                              ToolTip.Tip="{loc:Text M0468}" AutomationProperties.Name="{loc:Text M0469}">
                        <Button.Flyout>
                          <MenuFlyout Opening="OnCardMenuOpening"/>
                        </Button.Flyout>
                        <TextBlock Text="⋯" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource UiMuted}"/>
                      </Button>
                    </Grid>
                    <Border Grid.Row="1" CornerRadius="{DynamicResource TerminalCorner}" Background="{DynamicResource UiInset}" Padding="3" ClipToBounds="True">
                      <ctl:StagePreview Emulator="{Binding Model.Emulator}"/>
                    </Border>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="3,6,3,0">
                      <TextBlock Text="{Binding ShelfCaption}" FontSize="9" Foreground="{DynamicResource UiMuted}"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding WorkingDirectory}"/>
                      <TextBlock Grid.Column="1" Text="{loc:Text M0470}" IsVisible="{Binding IsActive}" FontSize="9" Foreground="{DynamicResource UiAccent}"/>
                    </Grid>
                    <ctl:StageCardFinish Grid.RowSpan="3" Margin="-9" IsVisible="{Binding !IsActive}" IsHitTestVisible="False"/>
                  </Grid>
                  </Border>
                </ctl:StageCard>
              </DataTemplate>
              </ctl:CachedShelfTemplate>
              <ctl:CachedShelfTemplate>
              <DataTemplate x:DataType="vm:SessionGroupHeader">
                <Border Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="10,6" Margin="6,0" Cursor="Hand">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource UiInk}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{loc:Translate {Binding Activity}}" FontSize="10" Foreground="{DynamicResource UiAccent}"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </DataTemplate>
              </ctl:CachedShelfTemplate>
            </ListBox.DataTemplates>
          </ListBox>
          <Button Grid.Row="2" CornerRadius="12" Margin="14,8,10,0" Padding="14,9"
                  Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding NewSessionCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Text="＋" Foreground="{DynamicResource UiAccent}" FontSize="17"/>
              <TextBlock Grid.Column="1" Text="{loc:Text M0471}" Foreground="{DynamicResource UiInk}" Margin="8,2,0,0" FontSize="12"/>
              <TextBlock Grid.Column="2" Text="Ctrl ⇧ N" Foreground="{DynamicResource UiMuted}" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
          </Button>
        </Grid>
        </ctl:ShelfDrawer>

        <!-- right-edge drag handle for the session shelf (18px gutter column) -->
        <Border x:Name="ShelfResizeHandle" Grid.Column="1" Background="Transparent"
                Cursor="SizeWestEast" ToolTip.Tip="{loc:Text M0472}"/>

        <!-- ===== CENTER ===== -->
        <ctl:StageSurface x:Name="StageWindow" Grid.Column="2" CornerRadius="{DynamicResource SurfaceCorner}"
                Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1"
                BoxShadow="{DynamicResource SurfaceShadow}">
          <Grid x:Name="StageContentGrid" RowDefinitions="46,*,Auto" Margin="8">

            <!-- Single-row chrome like the mockup: icon · name · status · cwd | nav · actions -->
            <Grid x:Name="TerminalChrome" Grid.Row="0" ColumnDefinitions="Auto,*,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="8,0,4,4">
              <StackPanel x:Name="TerminalChromeIcon" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                <Ellipse Width="9" Height="9" Fill="#FF5F57" Margin="0,0,5,0"/>
                <Ellipse Width="9" Height="9" Fill="#FEBC2E" Margin="0,0,5,0"/>
                <Ellipse Width="9" Height="9" Fill="#28C840" Margin="0,0,10,0"/>
                <Border Width="27" Height="27" CornerRadius="7" Background="{DynamicResource UiRaised}">
                  <TextBlock Text="›_" FontFamily="Consolas" FontSize="14" Foreground="{DynamicResource UiAccent}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </StackPanel>
              <Grid x:Name="TerminalChromeTitle" Grid.Column="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,0,4,0" MaxWidth="360">
                <TextBlock Text="{Binding ActiveCard.Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontFamily="{DynamicResource HeadingFont}" DoubleTapped="OnRenameActive" ToolTip.Tip="{loc:Text M0473}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
                <Border Grid.Column="1" Background="{DynamicResource UiRaised}" CornerRadius="6" Padding="8,4" Margin="12,0,0,0"
                        IsVisible="{Binding ActiveCard, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                  <StackPanel Spacing="2"><TextBlock Text="{loc:Translate {Binding ActiveCard.StatusText}}" FontSize="10" Foreground="{Binding ActiveCard.StatusBrush}"/><TextBlock Text="{loc:Translate {Binding ActiveCard.CommandStatusText}}" FontSize="9" Foreground="{DynamicResource UiMuted}" IsVisible="{Binding ActiveCard.CommandStatusText, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/></StackPanel>
                </Border>
              </Grid>
              <Button x:Name="ChromeDirectory" Grid.Column="2" Classes="terminal-tool" Command="{Binding ShowWorkspaceCommand}"
                      HorizontalContentAlignment="Left" Margin="6,0,10,0" ToolTip.Tip="{Binding ActiveWorkingDirectory}">
                <TextBlock Text="{Binding ActiveWorkingDirectory}" TextTrimming="CharacterEllipsis" FontSize="11"/>
              </Button>
              <Button x:Name="ChromeBack" Grid.Column="3" Classes="terminal-tool"
                      Command="{Binding CwdBackCommand}" IsEnabled="{Binding CanCwdBack}"
                      ToolTip.Tip="{loc:Text M0474}" AutomationProperties.Name="{loc:Text M0474}">
                <PathIcon Data="{StaticResource ToolBack}"/>
              </Button>
              <Button x:Name="ChromeRefresh" Grid.Column="4" Classes="terminal-tool"
                      Command="{Binding RefreshCwdCommand}" ToolTip.Tip="{loc:Text M0475}" AutomationProperties.Name="{loc:Text M0475}">
                <PathIcon Data="{StaticResource ToolRefresh}"/>
              </Button>
              <Button x:Name="ChromeForward" Grid.Column="5" Classes="terminal-tool"
                      Command="{Binding CwdForwardCommand}" IsEnabled="{Binding CanCwdForward}"
                      ToolTip.Tip="{loc:Text M0476}" AutomationProperties.Name="{loc:Text M0476}">
                <PathIcon Data="{StaticResource ToolForward}"/>
              </Button>
              <Button x:Name="ChromeSplit" Grid.Column="6" Classes="terminal-tool" Classes.selected="{Binding IsSplit}"
                      Command="{Binding ToggleSplitCommand}"
                      ToolTip.Tip="{loc:Text M0477}" AutomationProperties.Name="{loc:Text M0270}">
                <PathIcon Data="{StaticResource ToolSplit}"/>
                <Button.ContextFlyout>
                  <MenuFlyout>
                    <MenuItem Header="{loc:Text M0478}" Command="{Binding SetSplitLayoutCommand}" CommandParameter="Horizontal"/>
                    <MenuItem Header="{loc:Text M0371}" Command="{Binding SetSplitLayoutCommand}" CommandParameter="Vertical"/>
                    <MenuItem Header="{loc:Text M0373}" Command="{Binding SetSplitLayoutCommand}" CommandParameter="Quad"/>
                    <MenuItem Header="{loc:Text M0375}" Command="{Binding TogglePaneMaximizedCommand}" IsEnabled="{Binding IsSplit}"/>
                    <MenuItem Header="{loc:Text M0479}" Command="{Binding SetSplitLayoutCommand}" CommandParameter="Single"/>
                  </MenuFlyout>
                </Button.ContextFlyout>
              </Button>
              <Button x:Name="ChromePopout" Grid.Column="7" Classes="terminal-tool"
                      Command="{Binding OpenInNewWindowCommand}"
                      ToolTip.Tip="{loc:Text M0480}" AutomationProperties.Name="{loc:Text M0271}">
                <PathIcon Data="{StaticResource ToolPopout}"/>
              </Button>
              <Button x:Name="ChromeNew" Grid.Column="8" Classes="terminal-tool" Command="{Binding NewSessionCommand}" ToolTip.Tip="{loc:Text M0481}" AutomationProperties.Name="{loc:Text M0471}">
                <PathIcon Data="{StaticResource ToolAdd}"/>
              </Button>
              <Button x:Name="SessionMenuButton" Grid.Column="9" Classes="terminal-tool" ToolTip.Tip="{loc:Text M0468}" AutomationProperties.Name="{loc:Text M0468}">
                <PathIcon Data="{StaticResource ToolMore}"/>
                <Button.Flyout>
                  <MenuFlyout Opening="OnSessionMenuOpening">
                  <MenuItem Header="{loc:Text M0478}" Command="{Binding SetSplitLayoutCommand}" CommandParameter="Horizontal"/>
                  <MenuItem Header="{loc:Text M0371}" Command="{Binding SetSplitLayoutCommand}" CommandParameter="Vertical"/>
                  <MenuItem Header="{loc:Text M0373}" Command="{Binding SetSplitLayoutCommand}" CommandParameter="Quad"/>
                  <MenuItem Header="{loc:Text M0375}" Command="{Binding TogglePaneMaximizedCommand}" IsEnabled="{Binding IsSplit}"/>
                  <MenuItem Header="{loc:Text M0479}" Command="{Binding SetSplitLayoutCommand}" CommandParameter="Single"/>
                  <MenuItem Header="{loc:Translate {Binding UndoLayoutText}}" Command="{Binding UndoLayoutCommand}"/>
                  <MenuItem Header="{loc:Translate {Binding RedoLayoutText}}" Command="{Binding RedoLayoutCommand}"/>
                    <Separator/>
                    <MenuItem Header="{loc:Text M0482}" Click="OnRenameActive"/>
                    <MenuItem x:Name="PinSessionItem" Header="{loc:Text M0255}" Command="{Binding TogglePinActiveCommand}"/>
                    <MenuItem Header="{loc:Text M0309}" Command="{Binding RemoveActiveFromGroupCommand}"/>
                    <MenuItem x:Name="MoveToGroupMenu" Header="{loc:Text M0308}"/>
                    <MenuItem Header="{loc:Text M0310}" Click="OnCreateGroupForActive"/>
                    <MenuItem Header="{loc:Text M0483}" Click="OnRenameActiveGroup"/>
                    <MenuItem x:Name="ToggleGroupItem" Header="{loc:Text M0302}" Command="{Binding ToggleActiveGroupCommand}"/>
                    <MenuItem Header="{loc:Text M0484}" Command="{Binding ShowWorkspaceCommand}"/>
                    <MenuItem x:Name="TerminalColorsMenu" Header="{loc:Text M0485}"/>
                    <MenuItem Header="{loc:Text M0486}" Command="{Binding CloseActiveSessionCommand}"/>
                    <MenuItem Header="{loc:Translate {Binding NextSessionMenuText}}" Command="{Binding CycleSessionNextCommand}"/>
                    <MenuItem Header="{loc:Translate {Binding PreviousSessionMenuText}}" Command="{Binding CycleSessionPrevCommand}"/>
                    <MenuItem x:Name="PopoutSessionsMenu" Header="{loc:Text M0487}"/>
                    <Separator/>
                    <MenuItem Header="{loc:Text M0488}" Command="{Binding CopyActiveCwdCommand}"/>
                    <Separator/>
                    <MenuItem Header="{loc:Text M0356}" Click="OnCopyScreen" ToolTip.Tip="{loc:Text M0489}"/>
                    <MenuItem Header="{loc:Text M0358}" Click="OnCopyAllOutput" ToolTip.Tip="{loc:Text M0359}"/>
                    <MenuItem x:Name="SaveSelectionItem" Header="{loc:Text M0333}" Click="OnSaveSelection"/>
                    <MenuItem Header="{loc:Text M0335}" Click="OnSaveAllOutput"/>
                    <Separator/>
                    <MenuItem Header="{loc:Text M0348}" Click="OnAddBookmark" ToolTip.Tip="{loc:Text M0490}"/>
                    <MenuItem Header="{loc:Text M0491}" Click="OnShowBookmarks"/>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button x:Name="ChromeClose" Grid.Column="10" Classes="terminal-tool" Command="{Binding CloseActiveSessionCommand}" ToolTip.Tip="{loc:Text M0492}" AutomationProperties.Name="{loc:Text M0493}">
                <PathIcon Data="{StaticResource ToolClose}"/>
              </Button>
            </Grid>

            <!-- Terminal viewport -->
            <Border Grid.Row="1" x:Name="TerminalViewport" CornerRadius="{DynamicResource TerminalCorner}" Background="{DynamicResource UiInset}" Padding="10,8" Margin="2,6" ClipToBounds="True"
                    BorderBrush="Transparent" BorderThickness="1">
              <Border.Styles>
                <Style Selector="Border:focus-within">
                  <Setter Property="BorderBrush" Value="{DynamicResource UiAccentSoft}"/>
                </Style>
              </Border.Styles>
              <Panel>
                <!-- empty stage: no sessions left -->
                <StackPanel IsVisible="{Binding ActiveCard, Converter={x:Static conv:ObjectConverters.IsNull}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                  <TextBlock Text="›_" FontFamily="Consolas" FontSize="26" Foreground="{DynamicResource UiFaint}"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="{loc:Text M0494}" FontSize="13" Foreground="{DynamicResource UiMuted}"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="{loc:Text M0495}" FontSize="11" Foreground="{DynamicResource UiFaint}"
                             HorizontalAlignment="Center"/>
                </StackPanel>
                <!-- single view -->
                <Panel IsVisible="{Binding !IsSplit}">
                  <ctl:TerminalView x:Name="MainTerminal"
                                    Emulator="{Binding ActiveSession.Emulator}"
                                    WorkingDirectory="{Binding ActiveWorkingDirectory}" ShellCommand="{Binding ActiveSession.Shell}" IsRemote="{Binding ActiveSession.IsRemote}"
                                    TerminalFontSize="{Binding FontSize, Mode=TwoWay}"
                                    TerminalFontFamily="{Binding TerminalFont}"
                                    SearchQuery="{Binding Dashboard.SearchQuery}"/>
                  <Button Content="{loc:Text M0496}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,6,6" Padding="10,4" CornerRadius="8" FontSize="10"
                          Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiAccent}" BorderThickness="1"
                          Foreground="{DynamicResource UiAccent}" Click="OnScrollToBottomClick"
                          IsVisible="{Binding #MainTerminal.IsScrolledUp}"
                          ToolTip.Tip="{loc:Text M0497}"/>
                  <ScrollBar Orientation="Vertical" Width="8" Opacity="0.5" Margin="0,0,1,0"
                             HorizontalAlignment="Right" VerticalAlignment="Stretch"
                             Minimum="0" Maximum="{Binding #MainTerminal.ScrollbackSize}"
                             ViewportSize="{Binding #MainTerminal.ViewportRows}"
                             Value="{Binding #MainTerminal.ScrollPosition, Mode=TwoWay}"
                             Visibility="{Binding #MainTerminal.OverlayScrollBarVisibility}"/>
                </Panel>
                <!-- split view: two independent sessions + draggable divider -->
                <ContentControl x:Name="SplitHost" IsVisible="{Binding IsSplit}"/>
                <Grid x:Name="SplitGrid" IsVisible="False" ColumnDefinitions="*,5,*" RowDefinitions="*,5,*">
                  <Border x:Name="LeftPaneBox" BorderThickness="1.5" CornerRadius="6" Margin="0,0,3,0"
                          Classes.pane-focus="{Binding FocusedPane, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=0}">
                    <Border.Styles>
                      <Style Selector="Border"><Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/></Style>
                      <Style Selector="Border.pane-focus"><Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/></Style>
                    </Border.Styles>
                    <Grid RowDefinitions="32,*">
                      <Border Background="{DynamicResource UiRaised}" CornerRadius="5,5,0,0" Padding="10,0">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock x:Name="LeftPaneTitle" Text="{Binding LeftPaneName}" FontSize="11" FontWeight="SemiBold"
                                     Foreground="{DynamicResource UiInk}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="1" Text="{loc:Text M0498}" FontSize="9" Foreground="{DynamicResource UiAccent}" VerticalAlignment="Center"
                                     IsVisible="{Binding FocusedPane, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=0}"/>
                        </Grid>
                      </Border>
                      <Panel Grid.Row="1" Margin="6,7,6,4">
                      <ctl:TerminalView x:Name="LeftTerminal" Emulator="{Binding LeftPane.Emulator}"
                                        WorkingDirectory="{Binding LeftPane.WorkingDirectory}" ShellCommand="{Binding LeftPane.Shell}" IsRemote="{Binding LeftPane.IsRemote}"
                                        TerminalFontSize="{Binding FontSize, Mode=TwoWay}"
                                        TerminalFontFamily="{Binding TerminalFont}"
                                        SearchQuery="{Binding Dashboard.SearchQuery}"/>
                      <Button Content="⬇" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Margin="0,0,6,6" Padding="8,3" CornerRadius="8" FontSize="10"
                              Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiAccent}" BorderThickness="1"
                              Foreground="{DynamicResource UiAccent}" Click="OnScrollToBottomClick"
                              IsVisible="{Binding #LeftTerminal.IsScrolledUp}"
                              ToolTip.Tip="{loc:Text M0497}"/>
                      <ScrollBar Orientation="Vertical" Width="8" Opacity="0.5" Margin="0,0,1,0"
                                 HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                 Minimum="0" Maximum="{Binding #LeftTerminal.ScrollbackSize}"
                                 ViewportSize="{Binding #LeftTerminal.ViewportRows}"
                                 Value="{Binding #LeftTerminal.ScrollPosition, Mode=TwoWay}"
                                 Visibility="{Binding #LeftTerminal.OverlayScrollBarVisibility}"/>
                    </Panel>
                    </Grid>
                  </Border>
                  <GridSplitter x:Name="ColumnDivider" Grid.Column="1" Grid.RowSpan="3" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource UiBorder}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
                  <GridSplitter x:Name="RowDivider" Grid.Row="1" Grid.ColumnSpan="3" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource UiBorder}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
                  <Border x:Name="RightPaneBox" Grid.Column="2" BorderThickness="1.5" CornerRadius="6" Margin="3,0,0,0"
                          Classes.pane-focus="{Binding FocusedPane, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=1}">
                    <Border.Styles>
                      <Style Selector="Border"><Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/></Style>
                      <Style Selector="Border.pane-focus"><Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/></Style>
                    </Border.Styles>
                    <Grid RowDefinitions="32,*">
                      <Border Background="{DynamicResource UiRaised}" CornerRadius="5,5,0,0" Padding="10,0">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock x:Name="RightPaneTitle" Text="{Binding RightPaneName}" FontSize="11" FontWeight="SemiBold"
                                     Foreground="{DynamicResource UiInk}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="1" Text="{loc:Text M0498}" FontSize="9" Foreground="{DynamicResource UiAccent}" VerticalAlignment="Center"
                                     IsVisible="{Binding FocusedPane, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=1}"/>
                        </Grid>
                      </Border>
                      <Panel Grid.Row="1" Margin="6,7,6,4" Background="Transparent">
                      <ctl:TerminalView x:Name="RightTerminal" Emulator="{Binding RightPane.Emulator}"
                                        WorkingDirectory="{Binding RightPane.WorkingDirectory}" ShellCommand="{Binding RightPane.Shell}" IsRemote="{Binding RightPane.IsRemote}"
                                        TerminalFontSize="{Binding FontSize, Mode=TwoWay}"
                                        TerminalFontFamily="{Binding TerminalFont}"
                                        SearchQuery="{Binding Dashboard.SearchQuery}"
                                        IsVisible="{Binding RightPane, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
                      <TextBlock Text="{loc:Text M0499}"
                                 Foreground="{DynamicResource UiFaint}" FontSize="11" TextWrapping="Wrap"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                                 IsVisible="{Binding RightPane, Converter={x:Static conv:ObjectConverters.IsNull}}"/>
                      <Button Content="⬇" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Margin="0,0,6,6" Padding="8,3" CornerRadius="8" FontSize="10"
                              Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiAccent}" BorderThickness="1"
                              Foreground="{DynamicResource UiAccent}" Click="OnScrollToBottomClick"
                              IsVisible="{Binding #RightTerminal.IsScrolledUp}"
                              ToolTip.Tip="{loc:Text M0497}"/>
                      <ScrollBar Orientation="Vertical" Width="8" Opacity="0.5" Margin="0,0,1,0"
                                 HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                 Minimum="0" Maximum="{Binding #RightTerminal.ScrollbackSize}"
                                 ViewportSize="{Binding #RightTerminal.ViewportRows}"
                                 Value="{Binding #RightTerminal.ScrollPosition, Mode=TwoWay}"
                                 Visibility="{Binding #RightTerminal.OverlayScrollBarVisibility}"/>
                    </Panel>
                    </Grid>
                  </Border>
                  <Border x:Name="BottomLeftPaneBox" BorderThickness="1.5" CornerRadius="6" Margin="0,0,3,0"
                          Classes.pane-focus="{Binding FocusedPane, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=2}">
                    <Border.Styles>
                      <Style Selector="Border"><Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/></Style>
                      <Style Selector="Border.pane-focus"><Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/></Style>
                    </Border.Styles>
                    <Grid RowDefinitions="32,*">
                      <Border Background="{DynamicResource UiRaised}" CornerRadius="5,5,0,0" Padding="10,0">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock x:Name="BottomLeftPaneTitle" Text="{Binding BottomLeftPaneName}" FontSize="11" FontWeight="SemiBold"
                                     Foreground="{DynamicResource UiInk}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="1" Text="{loc:Text M0498}" FontSize="9" Foreground="{DynamicResource UiAccent}" VerticalAlignment="Center"
                                     IsVisible="{Binding FocusedPane, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=2}"/>
                        </Grid>
                      </Border>
                      <Panel Grid.Row="1" Margin="6,7,6,4">
                      <ctl:TerminalView x:Name="BottomLeftTerminal" Emulator="{Binding BottomLeftPane.Emulator}"
                                        WorkingDirectory="{Binding BottomLeftPane.WorkingDirectory}" ShellCommand="{Binding BottomLeftPane.Shell}" IsRemote="{Binding BottomLeftPane.IsRemote}"
                                        TerminalFontSize="{Binding FontSize, Mode=TwoWay}"
                                        TerminalFontFamily="{Binding TerminalFont}"
                                        SearchQuery="{Binding Dashboard.SearchQuery}"/>
                      <Button Content="⬇" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Margin="0,0,6,6" Padding="8,3" CornerRadius="8" FontSize="10"
                              Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiAccent}" BorderThickness="1"
                              Foreground="{DynamicResource UiAccent}" Click="OnScrollToBottomClick"
                              IsVisible="{Binding #BottomLeftTerminal.IsScrolledUp}"
                              ToolTip.Tip="{loc:Text M0497}"/>
                      <ScrollBar Orientation="Vertical" Width="8" Opacity="0.5" Margin="0,0,1,0"
                                 HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                 Minimum="0" Maximum="{Binding #BottomLeftTerminal.ScrollbackSize}"
                                 ViewportSize="{Binding #BottomLeftTerminal.ViewportRows}"
                                 Value="{Binding #BottomLeftTerminal.ScrollPosition, Mode=TwoWay}"
                                 Visibility="{Binding #BottomLeftTerminal.OverlayScrollBarVisibility}"/>
                    </Panel>
                    </Grid>
                  </Border>
                  <Border x:Name="BottomRightPaneBox" BorderThickness="1.5" CornerRadius="6" Margin="0,0,3,0"
                          Classes.pane-focus="{Binding FocusedPane, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=3}">
                    <Border.Styles>
                      <Style Selector="Border"><Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/></Style>
                      <Style Selector="Border.pane-focus"><Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/></Style>
                    </Border.Styles>
                    <Grid RowDefinitions="32,*">
                      <Border Background="{DynamicResource UiRaised}" CornerRadius="5,5,0,0" Padding="10,0">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock x:Name="BottomRightPaneTitle" Text="{Binding BottomRightPaneName}" FontSize="11" FontWeight="SemiBold"
                                     Foreground="{DynamicResource UiInk}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="1" Text="{loc:Text M0498}" FontSize="9" Foreground="{DynamicResource UiAccent}" VerticalAlignment="Center"
                                     IsVisible="{Binding FocusedPane, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=3}"/>
                        </Grid>
                      </Border>
                      <Panel Grid.Row="1" Margin="6,7,6,4">
                      <ctl:TerminalView x:Name="BottomRightTerminal" Emulator="{Binding BottomRightPane.Emulator}"
                                        WorkingDirectory="{Binding BottomRightPane.WorkingDirectory}" ShellCommand="{Binding BottomRightPane.Shell}" IsRemote="{Binding BottomRightPane.IsRemote}"
                                        TerminalFontSize="{Binding FontSize, Mode=TwoWay}"
                                        TerminalFontFamily="{Binding TerminalFont}"
                                        SearchQuery="{Binding Dashboard.SearchQuery}"/>
                      <Button Content="⬇" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Margin="0,0,6,6" Padding="8,3" CornerRadius="8" FontSize="10"
                              Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiAccent}" BorderThickness="1"
                              Foreground="{DynamicResource UiAccent}" Click="OnScrollToBottomClick"
                              IsVisible="{Binding #BottomRightTerminal.IsScrolledUp}"
                              ToolTip.Tip="{loc:Text M0497}"/>
                      <ScrollBar Orientation="Vertical" Width="8" Opacity="0.5" Margin="0,0,1,0"
                                 HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                 Minimum="0" Maximum="{Binding #BottomRightTerminal.ScrollbackSize}"
                                 ViewportSize="{Binding #BottomRightTerminal.ViewportRows}"
                                 Value="{Binding #BottomRightTerminal.ScrollPosition, Mode=TwoWay}"
                                 Visibility="{Binding #BottomRightTerminal.OverlayScrollBarVisibility}"/>
                    </Panel>
                    </Grid>
                  </Border>
                </Grid>
              </Panel>
            </Border>

            <!-- Bottom panel: Output / Debug / Problems / Search -->
            <Border x:Name="OutputPanel" Grid.Row="2" Height="170" Margin="0,6,0,0"
                    KeyDown="OnPanelEscapeKeyDown"
                    IsVisible="{Binding OutputVisible}" CornerRadius="8" Background="{DynamicResource UiPanel}"
                    BorderBrush="{DynamicResource UiBorder}" BorderThickness="1">
              <Panel>
              <!-- top-edge drag handle: resize the bottom panel -->
              <Border x:Name="OutputResizeHandle" Height="8" VerticalAlignment="Top" Margin="0,-4,0,0"
                      Background="Transparent" Cursor="SizeNorthSouth" ZIndex="10"
                      ToolTip.Tip="{loc:Text M0500}"/>
              <Grid RowDefinitions="30,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="4,0">
                  <ListBox x:Name="OutputTabs" SelectedIndex="{Binding Dashboard.SelectedBottomTab}"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ScrollViewer.VerticalScrollBarVisibility="Disabled"
                           Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="12,4"/>
                        <Setter Property="Margin" Value="0,3"/>
                        <Setter Property="CornerRadius" Value="6"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
                        <Setter Property="Background" Value="Transparent"/>
                      </Style>
                      <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="{DynamicResource UiAccent}"/>
                        <Setter Property="Foreground" Value="{DynamicResource UiInk}"/>
                      </Style>
                      <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource UiAccentSoft}"/>
                        <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
                      </Style>
                    </ListBox.Styles>
                    <ListBoxItem Content="{loc:Text M0336}"/>
                    <ListBoxItem Content="{loc:Text UiDebug}"/>
                    <ListBoxItem>
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{loc:Text UiProblems}"/>
                        <Border IsVisible="{Binding Dashboard.HasProblems}" CornerRadius="8"
                                Background="{DynamicResource UiBad}" Padding="5,1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Dashboard.ProblemCount}" FontSize="9" Foreground="{DynamicResource UiOnAccent}"/>
                        </Border>
                      </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Content="{loc:Text UiSearch}"/>
                  </ListBox>
                  <ComboBox Classes="localized" x:Name="OutputLevelCombo" Grid.Column="1" FontSize="10" Padding="8,1" MinWidth="76"
                            VerticalAlignment="Center" SelectedIndex="{Binding Dashboard.OutputLevelFilter}"
                            ToolTip.Tip="{loc:Text M0501}">
                    <ComboBoxItem Content="{loc:Text M0058}"/>
                    <ComboBoxItem>info</ComboBoxItem>
                    <ComboBoxItem>warn</ComboBoxItem>
                    <ComboBoxItem>error</ComboBoxItem>
                  </ComboBox>
                  <Button Grid.Column="2" Content="{loc:Text UiClear}" FontSize="10" Padding="8,2"
                          Background="{DynamicResource UiRaised}" CornerRadius="6" BorderBrush="{DynamicResource UiBorder}"
                          Foreground="{DynamicResource UiMuted}" VerticalAlignment="Center"
                          Command="{Binding Dashboard.ClearOutputCommand}"/>
                </Grid>

                <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource UiBorder}">
                  <Panel>
                    <!-- Output -->
                    <ListBox x:Name="OutputList" IsVisible="{Binding Dashboard.SelectedBottomTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=0}"
                             ItemsSource="{Binding Dashboard.VisibleOutput}"
                             DoubleTapped="OnOutputEntryDoubleTapped"
                             Background="Transparent" BorderThickness="0" Padding="6">
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                          <Setter Property="Padding" Value="2,1"/>
                          <Setter Property="Background" Value="Transparent"/>
                          <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                          <Setter Property="FontSize" Value="10"/>
                        </Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntry">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}" Foreground="{DynamicResource UiFaint}"/>
                            <TextBlock Text="{Binding Level, StringFormat='[{0}]'}"
                                       Foreground="{Binding Level, Converter={x:Static vm:LogLevelConverter.Instance}}"/>
                            <TextBlock Text="{loc:Translate {Binding DisplayMessage}}" Foreground="{DynamicResource UiMuted}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Debug: raw session lines (pre-ANSI-strip, control bytes escaped) -->
                    <ListBox IsVisible="{Binding Dashboard.SelectedBottomTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=1}"
                             ItemsSource="{Binding Dashboard.DebugLog}"
                             Background="Transparent" BorderThickness="0" Padding="6">
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                          <Setter Property="Padding" Value="2,1"/>
                          <Setter Property="Background" Value="Transparent"/>
                          <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                          <Setter Property="FontSize" Value="10"/>
                        </Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntry">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss.fff}'}" Foreground="{DynamicResource UiFaint}"/>
                            <TextBlock IsVisible="{Binding Source, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"
                                       Text="{Binding Source, StringFormat='({0})'}" Foreground="{DynamicResource UiFaint}"/>
                            <TextBlock Text="{loc:Translate {Binding DisplayMessage}}" Foreground="{DynamicResource UiInk}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Problems: real errors from session output; clearable -->
                    <DockPanel IsVisible="{Binding Dashboard.SelectedBottomTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=2}">
                      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="8,4,8,0">
                        <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource UiFaint}"
                                   Text="{loc:Translate {Binding Dashboard.ProblemCount, StringFormat='会话输出中的 error / exception / 非零退出:{0} 条'}}"/>
                        <Button Grid.Column="1" Content="{loc:Text M0503}" FontSize="10" Padding="10,2"
                                Background="{DynamicResource UiRaised}" Foreground="{DynamicResource UiMuted}" CornerRadius="6" BorderThickness="0"
                                IsVisible="{Binding Dashboard.HasProblems}"
                                Command="{Binding Dashboard.ClearProblemsCommand}"/>
                      </Grid>
                      <TextBlock DockPanel.Dock="Top" Margin="8,4,8,0" FontSize="10" Foreground="{DynamicResource UiFaint}"
                                 IsVisible="{Binding !Dashboard.HasProblems}"
                                 Text="{loc:Text M0504}"/>
                    <ListBox ItemsSource="{Binding Dashboard.Problems}"
                             Background="Transparent" BorderThickness="0" Padding="6">
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                          <Setter Property="Padding" Value="2,1"/>
                          <Setter Property="Background" Value="Transparent"/>
                          <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                          <Setter Property="FontSize" Value="10"/>
                        </Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntry">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Level, StringFormat='[{0}]'}"
                                       Foreground="{Binding Level, Converter={x:Static vm:LogLevelConverter.Instance}}"/>
                            <TextBlock Text="{loc:Translate {Binding DisplayMessage}}" Foreground="{DynamicResource UiMuted}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    </DockPanel>

                    <!-- Search: filter active-session scrollback+screen, matched terms highlighted -->
                    <Grid IsVisible="{Binding Dashboard.SelectedBottomTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter={x:Static vm:DashboardViewModel.SearchTabIndex}}"
                          RowDefinitions="Auto,Auto,*">
                      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="8,6,8,0">
                        <TextBox x:Name="FindBox" Text="{Binding Dashboard.SearchQuery}"
                                 Watermark="{loc:Text M0505}" FontSize="11"
                                 KeyDown="OnSearchBoxKeyDown"
                                 Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiInk}"
                                 CornerRadius="6" Padding="8,4"/>
                        <Button Grid.Column="1" Content="▲" Padding="8,2" Margin="6,0,0,0" FontSize="10"
                                Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}"
                                Foreground="{DynamicResource UiMuted}" CornerRadius="6" VerticalAlignment="Center"
                                Click="OnSearchPrevMatch" ToolTip.Tip="{loc:Text M0506}"/>
                        <Button Grid.Column="2" Content="▼" Padding="8,2" Margin="4,0,0,0" FontSize="10"
                                Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}"
                                Foreground="{DynamicResource UiMuted}" CornerRadius="6" VerticalAlignment="Center"
                                Click="OnSearchNextMatch" ToolTip.Tip="{loc:Text M0507}"/>
                        <ComboBox Classes="localized" Grid.Column="3" SelectedIndex="{Binding Dashboard.SearchScope}" Margin="6,0" MinWidth="108" FontSize="11">
                          <ComboBoxItem Content="{loc:Text M0015}"/><ComboBoxItem Content="{loc:Text M0057}"/>
                        </ComboBox>
                        <TextBlock Grid.Column="4" Text="{loc:Translate {Binding Dashboard.SearchStatus}}"
                                   Foreground="{DynamicResource UiFaint}" FontSize="10" Margin="10,0"
                                   VerticalAlignment="Center" MinWidth="70"/>
                      </Grid>
                      <TextBlock Grid.Row="1" Text="{loc:Text M0508}"
                                 Foreground="{DynamicResource UiFaint}" FontSize="9" Margin="10,4,0,2"/>
                      <ListBox Grid.Row="2" x:Name="SearchResults" ItemsSource="{Binding Dashboard.SearchHits}"
                               Tapped="OnSearchHitDoubleTapped"
                               Background="Transparent" BorderThickness="0" Padding="6">
                        <ListBox.Styles>
                          <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="2,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                            <Setter Property="FontSize" Value="10"/>
                          </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding SessionName}" Foreground="{DynamicResource UiAccent}" MinWidth="90" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding Line, StringFormat='L{0}'}" Foreground="{DynamicResource UiFaint}" MinWidth="40"/>
                              <ctl:HighlightTextBlock LineText="{Binding Text}" Foreground="{DynamicResource UiMuted}"
                                                    Query="{Binding $parent[ListBox].DataContext.Dashboard.SearchQuery}"/>
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </Grid>

                    <!-- empty states: Output / Debug (Problems + Search carry their own hints) -->
                    <TextBlock Text="{loc:Text M0509}" Foreground="{DynamicResource UiFaint}" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static vm:TabEmptyConverter.Instance}" ConverterParameter="0">
                          <Binding Path="Dashboard.SelectedBottomTab"/>
                          <Binding Path="Dashboard.VisibleOutput.Count"/>
                        </MultiBinding>
                      </TextBlock.IsVisible>
                    </TextBlock>
                    <TextBlock Text="{loc:Text M0510}" Foreground="{DynamicResource UiFaint}" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static vm:TabEmptyConverter.Instance}" ConverterParameter="1">
                          <Binding Path="Dashboard.SelectedBottomTab"/>
                          <Binding Path="Dashboard.DebugLog.Count"/>
                        </MultiBinding>
                      </TextBlock.IsVisible>
                    </TextBlock>
                  </Panel>
                </Border>
              </Grid>
              </Panel>
            </Border>
          </Grid>
        </ctl:StageSurface>

        <!-- left-edge drag handle for the inspector rail (12px gutter column) -->
        <Border x:Name="InspectorResizeHandle" Grid.Column="3" Background="Transparent"
                Cursor="SizeWestEast" ToolTip.Tip="{loc:Text M0511}"/>

        <!-- ===== RIGHT: Processes/Files/Logs/SSH ===== -->
        <Border Grid.Column="4" CornerRadius="{DynamicResource SurfaceCorner}" IsVisible="{Binding InspectorVisible}"
                Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1"
                BoxShadow="{DynamicResource SurfaceShadow}" KeyDown="OnPanelEscapeKeyDown">
          <Grid RowDefinitions="42,*" Margin="9">

            <ListBox x:Name="InspectorTabs" Grid.Row="0" SelectedIndex="{Binding SelectedRightTab}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="10,4"/>
                  <Setter Property="Margin" Value="0,3"/>
                  <Setter Property="CornerRadius" Value="6"/>
                  <Setter Property="FontSize" Value="11"/>
                  <Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
                  <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem:selected">
                  <Setter Property="Background" Value="{DynamicResource UiAccent}"/>
                  <Setter Property="Foreground" Value="{DynamicResource UiInk}"/>
                </Style>
                      <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource UiAccentSoft}"/>
                        <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
                      </Style>
              </ListBox.Styles>
              <ListBoxItem>Processes</ListBoxItem>
              <ListBoxItem Content="{loc:Text UiFiles}"/>
              <ListBoxItem Content="{loc:Text M0591}"/>
              <ListBoxItem>SSH</ListBoxItem>
              <ListBoxItem Content="{loc:Text M0338}"/>
              <ListBoxItem>AI</ListBoxItem>
            </ListBox>

            <Panel Grid.Row="1" Margin="0,4,0,0">
              <!-- ===== Processes + System Monitor ===== -->
              <Grid IsVisible="{Binding SelectedRightTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=0}"
                    RowDefinitions="*,Auto">
                <Grid RowDefinitions="Auto,*">
                  <Grid ColumnDefinitions="50,*,70,70" Margin="6,4">
                    <Button Background="Transparent" BorderThickness="0" Padding="0" FontSize="10"
                            FontWeight="SemiBold" Foreground="{DynamicResource UiFaint}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand"
                            Command="{Binding Dashboard.SortProcessesCommand}" CommandParameter="pid"
                            ToolTip.Tip="{loc:Text M0512}">
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="PID"/>
                        <TextBlock Text="{Binding Dashboard.PidMark}" Foreground="{DynamicResource UiAccent}"/>
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0" FontSize="10"
                            FontWeight="SemiBold" Foreground="{DynamicResource UiFaint}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand"
                            Command="{Binding Dashboard.SortProcessesCommand}" CommandParameter="name"
                            ToolTip.Tip="{loc:Text M0512}">
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="{loc:Text M0753}"/>
                        <TextBlock Text="{Binding Dashboard.NameMark}" Foreground="{DynamicResource UiAccent}"/>
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0" FontSize="10"
                            FontWeight="SemiBold" Foreground="{DynamicResource UiFaint}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Cursor="Hand"
                            Command="{Binding Dashboard.SortProcessesCommand}" CommandParameter="cpu"
                            ToolTip.Tip="{loc:Text M0512}">
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="{Binding Dashboard.CpuMark}" Foreground="{DynamicResource UiAccent}"/>
                        <TextBlock Text="CPU"/>
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="0" FontSize="10"
                            FontWeight="SemiBold" Foreground="{DynamicResource UiFaint}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Cursor="Hand"
                            Command="{Binding Dashboard.SortProcessesCommand}" CommandParameter="mem"
                            ToolTip.Tip="{loc:Text M0512}">
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="{Binding Dashboard.MemMark}" Foreground="{DynamicResource UiAccent}"/>
                        <TextBlock Text="MEM"/>
                      </StackPanel>
                    </Button>
                  </Grid>
                  <Panel Grid.Row="1">
                    <TextBlock Text="{loc:Translate {Binding Dashboard.ProcessesEmptyText}}" Foreground="{DynamicResource UiFaint}" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding Dashboard.Processes.Count, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=0}"/>
                    <ListBox ItemsSource="{Binding Dashboard.Processes}"
                           Background="Transparent" BorderThickness="0">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="6,3"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="CornerRadius" Value="6"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                        <Setter Property="FontSize" Value="10.5"/>
                      </Style>
                      <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Background" Value="{DynamicResource UiRaised}"/>
                      </Style>
                      <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="{DynamicResource UiAccentSoft}"/>
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="mon:ProcessInfo">
                        <Grid ColumnDefinitions="50,*,70,70">
                          <Grid.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="{loc:Text M0513}"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Dashboard.KillProcessCommand}"
                                        CommandParameter="{Binding}"/>
                            </ContextMenu>
                          </Grid.ContextMenu>
                          <TextBlock Text="{Binding Pid}" Foreground="{DynamicResource UiMuted}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource UiInk}"/>
                          <TextBlock Grid.Column="2" Text="{Binding CpuPercent, StringFormat='{}{0:0.0}%'}"
                                     Foreground="{DynamicResource UiGood}" HorizontalAlignment="Right"/>
                          <TextBlock Grid.Column="3" Text="{Binding MemoryBytes, Converter={x:Static vm:BytesConverter.Instance}}"
                                     Foreground="{DynamicResource UiMuted}" HorizontalAlignment="Right"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                    </ListBox>
                  </Panel>
                </Grid>

                <!-- System Monitor widgets -->
                <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource UiSurface}"
                        BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" Padding="8" Margin="0,6,0,0">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Text UiMonitor}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource UiMuted}"/>
                    <Grid ColumnDefinitions="*,10,*">
                      <Border CornerRadius="8" Background="{DynamicResource UiSurface}" Padding="8">
                        <Grid RowDefinitions="Auto,Auto,*">
                          <TextBlock Text="CPU" FontSize="10" Foreground="{DynamicResource UiFaint}"/>
                          <TextBlock Grid.Row="1" Text="{Binding Dashboard.CpuPercent}" FontSize="18"
                                     FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
                          <ctl:SparklineControl Grid.Row="2" Values="{Binding Dashboard.CpuSpark}"
                                                Stroke="{DynamicResource UiAccent}" Fill="{DynamicResource UiAccent}" Height="34" Margin="0,4,0,0"/>
                        </Grid>
                      </Border>
                      <Border Grid.Column="2" CornerRadius="8" Background="{DynamicResource UiSurface}" Padding="8">
                        <Grid RowDefinitions="Auto,Auto,*">
                          <TextBlock Text="{loc:Text UiMemory}" FontSize="10" Foreground="{DynamicResource UiFaint}"/>
                          <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding Dashboard.MemUsage}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
                            <TextBlock Text="{Binding Dashboard.MemTotal}" FontSize="10" Foreground="{DynamicResource UiFaint}"
                                       VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                          </StackPanel>
                          <ctl:SparklineControl Grid.Row="2" Values="{Binding Dashboard.MemSpark}"
                                                Stroke="{DynamicResource UiViolet}" Fill="{DynamicResource UiViolet}" Height="34" Margin="0,4,0,0"/>
                        </Grid>
                      </Border>
                    </Grid>
                    <Grid ColumnDefinitions="*,10,*">
                      <Border CornerRadius="8" Background="{DynamicResource UiSurface}" Padding="8">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{loc:Text UiDisk}" FontSize="10" Foreground="{DynamicResource UiFaint}"/>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Dashboard.DiskUsage}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
                          </StackPanel>
                          <ProgressBar Value="{Binding Dashboard.DiskFraction}" Minimum="0" Maximum="1"
                                       MinWidth="0" Height="6" CornerRadius="3" Foreground="{DynamicResource UiGood}" Background="{DynamicResource UiRaised}"/>
                          <TextBlock Text="{Binding Dashboard.DiskPercent}" FontSize="9" Foreground="{DynamicResource UiFaint}" HorizontalAlignment="Right"/>
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="2" CornerRadius="8" Background="{DynamicResource UiSurface}" Padding="8">
                        <Grid RowDefinitions="Auto,*,*">
                          <TextBlock Text="{loc:Text UiNetwork}" FontSize="10" Foreground="{DynamicResource UiFaint}"/>
                          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Dashboard.NetDown}" FontSize="11" Foreground="{DynamicResource UiGood}"/>
                            <ctl:SparklineControl Values="{Binding Dashboard.NetDownSpark}" Stroke="{DynamicResource UiGood}"
                                                  Width="60" Height="16" VerticalAlignment="Center" MaxValue="20"/>
                          </StackPanel>
                          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Dashboard.NetUp}" FontSize="11" Foreground="{DynamicResource UiAccent}"/>
                            <ctl:SparklineControl Values="{Binding Dashboard.NetUpSpark}" Stroke="{DynamicResource UiAccent}"
                                                  Width="60" Height="16" VerticalAlignment="Center" MaxValue="20"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- ===== Files ===== -->
              <Grid IsVisible="{Binding SelectedRightTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=1}"
                    RowDefinitions="Auto,Auto,5*,Auto,4*">
                <!-- toolbar: up + breadcrumb + open-in-terminal + copy-path + refresh + session dir -->
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" Margin="0,2,0,4">
                  <Button Content="↑" Padding="8,2" CornerRadius="6" Background="{DynamicResource UiRaised}"
                          Foreground="{DynamicResource UiMuted}" BorderBrush="{DynamicResource UiBorder}"
                          IsEnabled="{Binding Files.CanGoUp}"
                          Command="{Binding Files.UpCommand}" ToolTip.Tip="{loc:Text M0514}"/>
                  <ScrollViewer x:Name="CrumbScroll" Grid.Column="1" Margin="6,0" VerticalAlignment="Center"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Files.Breadcrumbs}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilesViewModel+Crumb">
                          <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Content="{loc:Translate {Binding Label}}" Padding="4,1" FontSize="10"
                                    Background="Transparent" Foreground="{DynamicResource UiMuted}" BorderThickness="0"
                                    FontFamily="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Files.NavigateCrumbCommand}"
                                    CommandParameter="{Binding}">
                              <Button.Styles>
                                <Style Selector="Button:pointerover">
                                  <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
                                </Style>
                              </Button.Styles>
                            </Button>
                            <TextBlock Text="›" Foreground="{DynamicResource UiFaint}" FontSize="10" VerticalAlignment="Center"/>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <Button Grid.Column="2" Content="⇥" Padding="8,2" Margin="0,0,6,0" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" Foreground="{DynamicResource UiMuted}" BorderBrush="{DynamicResource UiBorder}"
                          Command="{Binding Files.OpenInTerminalCommand}"
                          ToolTip.Tip="{loc:Text M0515}"/>
                  <Button Grid.Column="3" Content="⎘" Padding="8,2" Margin="0,0,6,0" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" Foreground="{DynamicResource UiMuted}" BorderBrush="{DynamicResource UiBorder}"
                          Command="{Binding Files.CopyPathCommand}"
                          ToolTip.Tip="{loc:Text M0516}"/>
                  <Button Grid.Column="4" Content="⟳" Padding="8,2" Margin="0,0,6,0" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" Foreground="{DynamicResource UiMuted}" BorderBrush="{DynamicResource UiBorder}"
                          Command="{Binding Files.RefreshCommand}" ToolTip.Tip="{loc:Text M0517}"/>
                  <Button Grid.Column="5" Content="⌂" Padding="8,2" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" Foreground="{DynamicResource UiAccent}" BorderBrush="{DynamicResource UiBorder}"
                          Command="{Binding Files.GoToSessionDirCommand}" ToolTip.Tip="{loc:Text M0518}"/>
                  <ToggleButton Grid.Column="6" Content=".*" Padding="7,2" Margin="6,0,0,0" CornerRadius="6"
                                Background="{DynamicResource UiRaised}" Foreground="{DynamicResource UiFaint}"
                                BorderBrush="{DynamicResource UiBorder}" FontSize="10"
                                IsChecked="{Binding Files.ShowHidden}"
                                ToolTip.Tip="{loc:Text M0519}">
                    <ToggleButton.Styles>
                      <Style Selector="ToggleButton:checked">
                        <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
                      </Style>
                    </ToggleButton.Styles>
                  </ToggleButton>
                </Grid>
                <TextBlock Grid.Row="1" Text="{loc:Translate {Binding Files.StatusText}}"
                           Foreground="{Binding Files.StatusIsError, Converter={x:Static vm:BoolToErrorBrushConverter.Instance}}"
                           FontSize="9.5" Margin="2,0,0,2"
                           IsVisible="{Binding Files.StatusText, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>

                <!-- directory listing -->
                <Border Grid.Row="2" CornerRadius="8" Background="{DynamicResource UiSurface}"
                        BorderBrush="{DynamicResource UiBorder}" BorderThickness="1">
                  <ListBox x:Name="FilesList" ItemsSource="{Binding Files.Entries}"
                           SelectedItem="{Binding Files.SelectedEntry}"
                           Background="Transparent" BorderThickness="0" Padding="4"
                           DragDrop.AllowDrop="True"
                           DoubleTapped="OnFileEntryDoubleTapped"
                           KeyDown="OnFilesListKeyDown">
                    <ListBox.ContextMenu>
                      <ContextMenu Opened="OnFilesContextMenuOpened">
                        <MenuItem Header="{loc:Text M0043}" Click="OnFilesNewFolderClick"/>
                        <MenuItem Header="{loc:Text M0291}" Click="OnFilesNewTextFileClick"/>
                        <MenuItem x:Name="PasteMenuItem" Header="{loc:Text M0520}" Click="OnFilesPasteClick" ToolTip.Tip="{loc:Text M0521}"/>
                      </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="6,3"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="CornerRadius" Value="5"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="FontSize" Value="10.5"/>
                      </Style>
                      <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Background" Value="{DynamicResource UiRaised}"/>
                      </Style>
                      <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="{DynamicResource UiAccentSoft}"/>
                      </Style>
                      <!-- OS files hovering a directory row: import lands inside it -->
                      <Style Selector="ListBoxItem.drop-hot">
                        <Setter Property="Background" Value="{DynamicResource UiAccentSoft}"/>
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="files:FileEntry">
                        <Grid ColumnDefinitions="14,*,Auto,Auto">
                          <Grid.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="{loc:Text M0522}"
                                        IsVisible="{Binding !IsDirectory}"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Files.OpenExternallyCommand}"
                                        CommandParameter="{Binding}"/>
                              <MenuItem Header="{loc:Text M0523}"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Files.OpenInTerminalCommand}"
                                        CommandParameter="{Binding}"/>
                              <MenuItem Header="{loc:Text M0524}"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Files.RevealInFileManagerCommand}"
                                        CommandParameter="{Binding}"/>
                              <MenuItem Header="{loc:Text M0525}" Click="OnFilesRenameClick"/>
                              <MenuItem Header="{loc:Text M0516}"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Files.CopyPathCommand}"
                                        CommandParameter="{Binding}"/>
                            </ContextMenu>
                          </Grid.ContextMenu>
                          <TextBlock Text="▸" Foreground="{DynamicResource UiAccent}" IsVisible="{Binding IsDirectory}"/>
                          <TextBlock Text="·" Foreground="{DynamicResource UiFaint}" IsVisible="{Binding !IsDirectory}"/>
                          <TextBlock Grid.Column="1" Margin="2,0,0,0" TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource UiInk}">
                            <ToolTip.Tip>
                              <MultiBinding Converter="{x:Static vm:FileTooltipConverter.Instance}">
                                <Binding Path="FullPath"/>
                                <Binding Path="LinkTarget"/>
                              </MultiBinding>
                            </ToolTip.Tip>
                            <Run Text="{Binding Name}"
                                 Foreground="{Binding IsDirectory, Converter={x:Static vm:DirNameConverter.Instance}}"/>
                            <Run Text="{Binding IsSymlink, Converter={x:Static vm:BoolToSymlinkMarkConverter.Instance}}"
                                 FontSize="9" Foreground="{DynamicResource UiFaint}"/>
                          </TextBlock>
                          <TextBlock Grid.Column="2" Text="{Binding SizeBytes, Converter={x:Static vm:BytesConverter.Instance}}"
                                     Foreground="{DynamicResource UiFaint}" FontSize="9.5" HorizontalAlignment="Right"
                                     IsVisible="{Binding !IsDirectory}"/>
                          <TextBlock Grid.Column="3" Text="{Binding Modified, Converter={x:Static vm:ModifiedConverter.Instance}}"
                                     Foreground="{DynamicResource UiFaint}" FontSize="9.5" Margin="8,0,0,0"
                                     HorizontalAlignment="Right"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>

                <!-- preview header -->
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="2,6,2,2"
                      IsVisible="{Binding Files.HasPreview}">
                  <TextBlock Text="{Binding Files.PreviewTitle}" FontSize="10.5" FontWeight="SemiBold"
                             Foreground="{DynamicResource UiInk}" VerticalAlignment="Center"
                             ToolTip.Tip="{Binding Files.PreviewPath}"/>
                  <TextBlock Grid.Column="1" Text="{loc:Translate {Binding Files.PreviewMeta}}" FontSize="9"
                             Foreground="{DynamicResource UiFaint}" VerticalAlignment="Center"/>
                </Grid>

                <!-- preview pane -->
                <Border Grid.Row="4" CornerRadius="8" Background="{DynamicResource UiCanvas}"
                        BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" Padding="4"
                        IsVisible="{Binding Files.HasPreview}">
                  <Panel>
                    <Image Source="{Binding Files.PreviewImage}" Stretch="Uniform"
                           IsVisible="{Binding Files.PreviewIsImage}"/>
                    <TextBox Text="{loc:Translate {Binding Files.DisplayPreviewText}}" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="NoWrap" BorderThickness="0"
                             Background="Transparent" Foreground="{DynamicResource UiMuted}" FontSize="9.5"
                             FontFamily="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"
                             IsVisible="{Binding !Files.PreviewIsImage}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                  </Panel>
                </Border>
                <Border Grid.Row="4" CornerRadius="8" Background="{DynamicResource UiSurface}"
                        BorderBrush="{DynamicResource UiBorder}" BorderThickness="1"
                        IsVisible="{Binding !Files.HasPreview}">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Translate {Binding Files.PreviewHint}}" Foreground="{DynamicResource UiFaint}" FontSize="10"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Text M0526}" Foreground="{DynamicResource UiFaint}" FontSize="9"
                               HorizontalAlignment="Center" Margin="0,3,0,0" Opacity="0.7"/>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- ===== Logs ===== -->
              <Grid IsVisible="{Binding SelectedRightTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=2}"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
                <Grid.Styles>
                  <!-- exclusive level chips: same dark chip look as the toggles above -->
                  <Style Selector="ToggleButton.levelchip">
                    <Setter Property="Padding" Value="10,3"/>
                    <Setter Property="MinWidth" Value="44"/>
                    <Setter Property="CornerRadius" Value="6"/>
                    <Setter Property="Background" Value="{DynamicResource UiRaised}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/>
                    <Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
                    <Setter Property="FontSize" Value="10"/>
                  </Style>
                  <Style Selector="ToggleButton.levelchip:checked">
                    <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
                  </Style>
                  <Style Selector="ToggleButton.timechip">
                    <Setter Property="Padding" Value="10,3"/>
                    <Setter Property="MinWidth" Value="44"/>
                    <Setter Property="CornerRadius" Value="6"/>
                    <Setter Property="Background" Value="{DynamicResource UiRaised}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/>
                    <Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
                    <Setter Property="FontSize" Value="10"/>
                  </Style>
                  <Style Selector="ToggleButton.timechip:checked">
                    <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
                  </Style>
                  <Style Selector="ToggleButton.capchip">
                    <Setter Property="Padding" Value="10,3"/>
                    <Setter Property="MinWidth" Value="44"/>
                    <Setter Property="CornerRadius" Value="6"/>
                    <Setter Property="Background" Value="{DynamicResource UiRaised}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/>
                    <Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
                    <Setter Property="FontSize" Value="10"/>
                  </Style>
                  <Style Selector="ToggleButton.capchip:checked">
                    <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
                  </Style>
                </Grid.Styles>
                <!-- filter row: text + regex toggle + file sink -->
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2,0,4">
                  <TextBox Text="{Binding Logs.FilterText}" Watermark="{loc:Text M0527}"
                           Background="{DynamicResource UiRaised}" CornerRadius="6" BorderBrush="{DynamicResource UiBorder}"
                           Foreground="{DynamicResource UiInk}" Padding="8,3" FontSize="10.5"/>
                  <ToggleButton Grid.Column="1" Content=".*" Margin="4,0,0,0" Padding="6,3" MinWidth="30"
                                CornerRadius="6" Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}"
                                Foreground="{DynamicResource UiMuted}" FontSize="10"
                                FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                                IsChecked="{Binding Logs.UseRegex}"
                                ToolTip.Tip="{loc:Text M0528}">
                    <ToggleButton.Styles>
                      <Style Selector="ToggleButton:checked">
                        <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
                      </Style>
                    </ToggleButton.Styles>
                  </ToggleButton>
                  <ToggleButton Grid.Column="2" Content="{loc:Text M0529}" Margin="6,0,0,0" Padding="8,3"
                                CornerRadius="6" Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}"
                                Foreground="{DynamicResource UiMuted}" FontSize="10"
                                IsChecked="{Binding Logs.FileLogging}"
                                ToolTip.Tip="{loc:Text M0530}">
                    <ToggleButton.Styles>
                      <Style Selector="ToggleButton:checked">
                        <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
                      </Style>
                    </ToggleButton.Styles>
                  </ToggleButton>
                </Grid>
                <!-- level filter: exclusive chip bar (全部/info/warn/error + live ring-buffer counts) + timestamp / wrap / compact / 容量 -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                  <ToggleButton Classes="levelchip" Content="{loc:Translate {Binding Logs.LevelAllChipLabel}}"
                                IsChecked="{Binding Logs.LevelAllSelected}"
                                ToolTip.Tip="{loc:Text M0531}"/>
                  <ToggleButton Classes="levelchip" Content="{Binding Logs.LevelInfoChipLabel}" Margin="4,0,0,0"
                                IsChecked="{Binding Logs.LevelInfoSelected}"
                                ToolTip.Tip="{loc:Text M0532}"/>
                  <ToggleButton Classes="levelchip" Content="{Binding Logs.LevelWarnChipLabel}" Margin="4,0,0,0"
                                IsChecked="{Binding Logs.LevelWarnSelected}"
                                ToolTip.Tip="{loc:Text M0533}"/>
                  <ToggleButton Classes="levelchip" Content="{Binding Logs.LevelErrorChipLabel}" Margin="4,0,0,0"
                                IsChecked="{Binding Logs.LevelErrorSelected}"
                                ToolTip.Tip="{loc:Text M0534}"/>
                  <!-- timestamp mode: off=绝对 HH:mm:ss · on=相对「距现在」刚刚/12s/3m/1h/昨天 -->
                  <ToggleButton Classes="timechip" Content="{loc:Text M0535}" Margin="10,0,0,0"
                                IsChecked="{Binding Logs.UseRelativeTimestamps}"
                                ToolTip.Tip="{loc:Text M0536}"/>
                  <!-- line wrap: on(default)=Wrap · off=NoWrap + horizontal scroll for dense scanning -->
                  <ToggleButton Classes="timechip" Content="{loc:Text M0537}" Margin="4,0,0,0"
                                IsChecked="{Binding Logs.WrapLines}"
                                ToolTip.Tip="{loc:Text M0538}"/>
                  <!-- compact density: off(default)=FontSize 9.5 / Padding 4,1 · on≈8.5 / 2,0 -->
                  <ToggleButton Classes="timechip" Content="{loc:Text M0539}" Margin="4,0,0,0"
                                IsChecked="{Binding Logs.CompactDensity}"
                                ToolTip.Tip="{loc:Text M0540}"/>
                  <!-- ring-buffer capacity presets (exclusive chips; default 2000) -->
                  <TextBlock Text="{loc:Text M0541}" FontSize="10" Foreground="{DynamicResource UiFaint}"
                             VerticalAlignment="Center" Margin="10,0,4,0"
                             ToolTip.Tip="{loc:Text M0542}"/>
                  <ToggleButton Classes="capchip" Content="500"
                                IsChecked="{Binding Logs.Capacity500Selected}"
                                ToolTip.Tip="{loc:Text M0543}"/>
                  <ToggleButton Classes="capchip" Content="2000" Margin="4,0,0,0"
                                IsChecked="{Binding Logs.Capacity2000Selected}"
                                ToolTip.Tip="{loc:Text M0544}"/>
                  <ToggleButton Classes="capchip" Content="5000" Margin="4,0,0,0"
                                IsChecked="{Binding Logs.Capacity5000Selected}"
                                ToolTip.Tip="{loc:Text M0545}"/>
                </WrapPanel>
                <!-- session filter -->
                <ComboBox Grid.Row="2" ItemsSource="{Binding Logs.SessionNames}"
                          SelectedIndex="{Binding Logs.SessionFilterIndex}"
                          Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" FontSize="10"
                          CornerRadius="6" Padding="8,2" Margin="0,0,0,4"
                          VerticalAlignment="Center"/>
                <!-- actions: match nav / copy visible / export / clear results / retain history -->
                <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,4">
                  <Button Content="{loc:Text M0546}" Padding="8,3" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiMuted}"
                          FontSize="10" Command="{Binding Logs.GoPrevMatchCommand}"
                          IsEnabled="{Binding Logs.CanGoPrevMatch}"
                          ToolTip.Tip="{loc:Text M0547}"/>
                  <Button Content="{loc:Text M0548}" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiMuted}"
                          FontSize="10" Command="{Binding Logs.GoNextMatchCommand}"
                          IsEnabled="{Binding Logs.CanGoNextMatch}"
                          ToolTip.Tip="{loc:Text M0549}"/>
                  <Button Content="▲ error" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiBad}"
                          FontSize="10" Command="{Binding Logs.GoPrevErrorCommand}"
                          IsEnabled="{Binding Logs.CanGoPrevError}"
                          ToolTip.Tip="{loc:Text M0550}"/>
                  <Button Content="▼ error" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiBad}"
                          FontSize="10" Command="{Binding Logs.GoNextErrorCommand}"
                          IsEnabled="{Binding Logs.CanGoNextError}"
                          ToolTip.Tip="{loc:Text M0551}"/>
                  <Button Content="{loc:Text M0552}" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiMuted}"
                          FontSize="10" Command="{Binding Logs.JumpToSessionCommand}"
                          ToolTip.Tip="{loc:Text M0553}"/>
                  <Button Content="{loc:Text M0554}" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiMuted}"
                          FontSize="10" Command="{Binding Logs.CopyVisibleCommand}"
                          ToolTip.Tip="{loc:Text M0555}"/>
                  <Button Content="{loc:Text M0556}" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiMuted}"
                          FontSize="10" Command="{Binding Logs.CopySelectedCommand}"
                          IsEnabled="{Binding Logs.HasSelectedEntry}"
                          ToolTip.Tip="{loc:Text M0557}"/>
                  <Button Content="{loc:Text M0558}" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiMuted}"
                          FontSize="10" Command="{Binding Logs.ExportVisibleCommand}"
                          ToolTip.Tip="{loc:Text M0559}"/>
                  <Button Content="{loc:Text M0560}" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                          Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiMuted}"
                          FontSize="10" Command="{Binding Logs.ClearVisibleCommand}"
                          ToolTip.Tip="{loc:Text M0561}"/>
                  <ToggleButton Content="{loc:Text M0562}" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                                Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiMuted}"
                                FontSize="10" IsChecked="{Binding Logs.RetainHistoryOnClear}"
                                ToolTip.Tip="{loc:Text M0563}">
                    <ToggleButton.Styles>
                      <Style Selector="ToggleButton:checked">
                        <Setter Property="Foreground" Value="{DynamicResource UiAccent}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
                      </Style>
                    </ToggleButton.Styles>
                  </ToggleButton>
                </WrapPanel>
                <!-- invalid-regex hint -->
                <TextBlock Grid.Row="4" Text="{loc:Translate {Binding Logs.FilterError}}" Foreground="{DynamicResource UiBad}"
                           FontSize="9.5" Margin="2,0,2,3" TextWrapping="Wrap"
                           IsVisible="{Binding Logs.FilterError, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>

                <!-- log lines -->
                <Border Grid.Row="5" CornerRadius="8" Background="{DynamicResource UiSurface}"
                        BorderBrush="{DynamicResource UiBorder}" BorderThickness="1">
                  <Panel>
                    <ListBox x:Name="LogsList" ItemsSource="{Binding Logs.Entries}"
                             SelectedIndex="{Binding Logs.SelectedIndex, Mode=TwoWay}"
                             DoubleTapped="OnLogsEntryDoubleTapped"
                             KeyDown="OnLogsListKeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             Background="Transparent" BorderThickness="0" Padding="4"
                             Classes.compact="{Binding Logs.CompactDensity}">
                      <ListBox.Styles>
                        <!-- density: Classes.compact bound to Logs.CompactDensity refreshes Padding/FontSize -->
                        <Style Selector="ListBoxItem">
                          <Setter Property="Padding" Value="4,1"/>
                          <Setter Property="Background" Value="Transparent"/>
                          <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                          <Setter Property="FontSize" Value="9.5"/>
                        </Style>
                        <Style Selector="ListBox.compact ListBoxItem">
                          <Setter Property="Padding" Value="2,0"/>
                          <Setter Property="FontSize" Value="8.5"/>
                        </Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntry">
                          <!-- Message and Source reuse the Search tab's highlighter:
                               literal case-insensitive, or regex when the .* toggle is on. -->
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Foreground="{DynamicResource UiFaint}"
                                       FontSize="{Binding $parent[ListBox].DataContext.Logs.CompactDensity, Converter={x:Static vm:BoolToLogsFontSizeConverter.Instance}}">
                              <TextBlock.Text>
                                <MultiBinding Converter="{x:Static vm:LogTimestampConverter.Instance}">
                                  <Binding Path="Time"/>
                                  <Binding Path="$parent[ListBox].DataContext.Logs.UseRelativeTimestamps"/>
                                  <Binding Path="Revision" Source="{x:Static loc:UiText.Locale}"/>
                                </MultiBinding>
                              </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="{Binding Level, StringFormat='[{0}]'}"
                                       FontSize="{Binding $parent[ListBox].DataContext.Logs.CompactDensity, Converter={x:Static vm:BoolToLogsFontSizeConverter.Instance}}"
                                       Foreground="{Binding Level, Converter={x:Static vm:LogLevelConverter.Instance}}"/>
                            <ctl:HighlightTextBlock LineText="{Binding Source, StringFormat='({0})'}" Foreground="{DynamicResource UiFaint}"
                                                    FontSize="{Binding $parent[ListBox].DataContext.Logs.CompactDensity, Converter={x:Static vm:BoolToLogsFontSizeConverter.Instance}}"
                                                    Query="{Binding $parent[ListBox].DataContext.Logs.FilterText}"
                                                    UseRegex="{Binding $parent[ListBox].DataContext.Logs.UseRegex}"
                                                    IsVisible="{Binding Source, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
                            <ctl:HighlightTextBlock LineText="{loc:Translate {Binding DisplayMessage}}" Foreground="{DynamicResource UiMuted}"
                                                    FontSize="{Binding $parent[ListBox].DataContext.Logs.CompactDensity, Converter={x:Static vm:BoolToLogsFontSizeConverter.Instance}}"
                                                    TextWrapping="{Binding $parent[ListBox].DataContext.Logs.WrapLines, Converter={x:Static vm:BoolToTextWrappingConverter.Instance}}"
                                                    Query="{Binding $parent[ListBox].DataContext.Logs.FilterText}"
                                                    UseRegex="{Binding $parent[ListBox].DataContext.Logs.UseRegex}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{loc:Text M0564}" Foreground="{DynamicResource UiFaint}" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding Logs.Entries.Count, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=0}"/>
                    <!-- follow paused: floats over the list until resumed -->
                    <Button Content="{loc:Text M0565}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,10,10" Padding="10,4" CornerRadius="8"
                            Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiAccent}" BorderThickness="1"
                            Foreground="{DynamicResource UiAccent}" FontSize="10"
                            Command="{Binding Logs.ResumeFollowCommand}"
                            IsVisible="{Binding Logs.FollowPaused}"
                            ToolTip.Tip="{loc:Text M0566}"/>
                  </Panel>
                </Border>

                <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="10" Margin="2,4,2,0">
                  <TextBlock Text="{loc:Translate {Binding Logs.FileStatus}}" Foreground="{DynamicResource UiGood}"
                             FontSize="9" TextWrapping="Wrap"
                             IsVisible="{Binding Logs.FileStatus, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
                  <TextBlock Text="{loc:Translate {Binding Logs.StatusText}}" Foreground="{DynamicResource UiMuted}"
                             FontSize="9" TextWrapping="Wrap"
                             IsVisible="{Binding Logs.StatusText, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
                </StackPanel>
              </Grid>

              <!-- ===== SSH ===== -->
              <Grid IsVisible="{Binding SelectedRightTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=3}"
                    RowDefinitions="Auto,Auto,*,Auto">
                <!-- list-first header: the edit form only opens on demand once hosts exist -->
                <Grid ColumnDefinitions="*,Auto" Margin="2,0,0,4" IsVisible="{Binding Ssh.HasHosts}">
                  <TextBlock Text="{loc:Text M0567}" FontSize="10.5" FontWeight="SemiBold"
                             Foreground="{DynamicResource UiMuted}" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="＋" Padding="8,1" FontSize="12"
                          CornerRadius="6" Background="{DynamicResource UiRaised}"
                          Foreground="{DynamicResource UiAccent}" BorderBrush="{DynamicResource UiBorder}"
                          ToolTip.Tip="{loc:Text M0568}" Command="{Binding Ssh.ToggleEditingCommand}" IsVisible="{Binding Ssh.CanToggleEditing}"/>
                </Grid>
                <!-- edit form -->
                <Border Grid.Row="1" IsVisible="{Binding Ssh.Editing}" KeyDown="OnSshFormKeyDown"
                        CornerRadius="8" Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}"
                        BorderThickness="1" Padding="8" Margin="0,2,0,6">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Text M0569}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource UiMuted}"/>
                    <Grid ColumnDefinitions="*,*">
                      <TextBox Text="{Binding Ssh.EditName}" Watermark="{loc:Text M0570}"
                               Background="{DynamicResource UiRaised}" CornerRadius="6" BorderBrush="{DynamicResource UiBorder}"
                               Foreground="{DynamicResource UiInk}" Padding="8,3" FontSize="10.5"/>
                      <TextBox Grid.Column="1" Text="{Binding Ssh.EditUser}" Watermark="{loc:Text M0571}"
                               Background="{DynamicResource UiRaised}" CornerRadius="6" BorderBrush="{DynamicResource UiBorder}"
                               Foreground="{DynamicResource UiInk}" Padding="8,3" FontSize="10.5" Margin="6,0,0,0"/>
                    </Grid>
                    <TextBox Text="{Binding Ssh.EditHost}" Watermark="{loc:Text M0572}"
                             Background="{DynamicResource UiRaised}" CornerRadius="6" BorderBrush="{DynamicResource UiBorder}"
                             Foreground="{DynamicResource UiInk}" Padding="8,3" FontSize="10.5"
                             FontFamily="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox Text="{Binding Ssh.EditPort}" Watermark="{loc:Text M0573}"
                               Background="{DynamicResource UiRaised}" CornerRadius="6" BorderBrush="{DynamicResource UiBorder}"
                               Foreground="{DynamicResource UiInk}" Padding="8,3" FontSize="10.5"/>
                      <Button Grid.Column="1" Content="{loc:Text M0574}" Margin="6,0,0,0" Padding="10,3"
                              CornerRadius="6" Background="{DynamicResource UiAccent}" Foreground="{DynamicResource UiOnAccent}" FontSize="10"
                              Command="{Binding Ssh.AddOrUpdateCommand}"/>
                    </Grid>
                    <TextBlock Text="{loc:Translate {Binding Ssh.StatusText}}" FontSize="9.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource UiWarm}"
                               IsVisible="{Binding Ssh.StatusText, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
                  </StackPanel>
                </Border>

                <!-- saved hosts -->
                <Border Grid.Row="2" CornerRadius="8" Background="{DynamicResource UiSurface}"
                        BorderBrush="{DynamicResource UiBorder}" BorderThickness="1">
                  <Panel>
                    <TextBlock Text="{loc:Text M0575}" Foreground="{DynamicResource UiFaint}"
                               FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding Ssh.Hosts.Count, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=0}"/>
                    <ListBox ItemsSource="{Binding Ssh.Hosts}" SelectedItem="{Binding Ssh.Selected}"
                           Background="Transparent" BorderThickness="0" Padding="4"
                           Tapped="OnSshRowTapped" DoubleTapped="OnSshRowDoubleTapped"
                           KeyDown="OnSshListKeyDown">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="CornerRadius" Value="6"/>
                        <Setter Property="Background" Value="Transparent"/>
                      </Style>
                      <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Background" Value="{DynamicResource UiRaised}"/>
                      </Style>
                      <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="{DynamicResource UiAccentSoft}"/>
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="ssh:SshHost">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CommandLine}" FontSize="9" Foreground="{DynamicResource UiFaint}" TextTrimming="CharacterEllipsis"
                                       FontFamily="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                          </StackPanel>
                          <Button Grid.Column="1" Content="{loc:Text M0576}" Padding="8,2" Margin="6,0,0,0"
                                  ToolTip.Tip="{loc:Text M0577}"
                                  CornerRadius="5" Background="{DynamicResource UiRaised}" Foreground="{DynamicResource UiAccent}"
                                  BorderBrush="{DynamicResource UiBorder}" FontSize="10" ClickMode="Press"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Ssh.ConnectCommand}"
                                  CommandParameter="{Binding}"/>
                          <Button Grid.Column="2" Content="✕" Padding="6,2" Margin="4,0,0,0"
                                  CornerRadius="5" Background="Transparent" Foreground="{DynamicResource UiFaint}"
                                  BorderThickness="0" FontSize="10" ClickMode="Press"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Ssh.RemoveCommand}"
                                  CommandParameter="{Binding}"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  </Panel>
                </Border>

                <TextBlock Grid.Row="3" FontSize="9" Foreground="{DynamicResource UiFaint}" Margin="2,6,2,0"
                           TextWrapping="Wrap"
                           Text="{loc:Text M0578}"/>
              </Grid>

              <Grid IsVisible="{Binding SelectedRightTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=4}"
                    RowDefinitions="Auto,*,Auto">
                <WrapPanel Orientation="Horizontal">
                  <Button Content="{loc:Text M0579}" Margin="0,0,6,6" Command="{Binding PreviousCommandCommand}"/>
                  <Button Content="{loc:Text M0580}" Margin="0,0,6,6" Command="{Binding NextCommandCommand}"/>
                  <Button Content="{loc:Text M0581}" Margin="0,0,6,6" Command="{Binding LocateCommandCommand}"/>
                  <Button Content="{loc:Text M0582}" Margin="0,0,6,6" Command="{Binding CopyCommandRecordCommand}"/>
                  <Button Content="{loc:Text M0583}" Margin="0,0,6,6" Click="OnSaveCommandRecord"
                          ToolTip.Tip="{loc:Text M0584}"/>
                </WrapPanel>
                <Panel Grid.Row="1">
                  <TextBlock Text="{loc:Text M0585}" Foreground="{DynamicResource UiFaint}"
                             FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding CommandRecords.Count, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=0}"/>
                  <ListBox ItemsSource="{Binding CommandRecords}" SelectedItem="{Binding SelectedCommand}"
                         Background="Transparent" BorderThickness="0" DoubleTapped="OnCommandDoubleTapped">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CommandRecordViewModel">
                      <StackPanel Margin="2,4" Spacing="2">
                        <TextBlock Text="{loc:Translate {Binding DisplayTitle}}" FontSize="12" Foreground="{DynamicResource UiInk}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{loc:Translate {Binding DisplayDetail}}" FontSize="10" Foreground="{DynamicResource UiMuted}" TextWrapping="Wrap"/>
                        <TextBlock Text="{loc:Translate {Binding LocateText}}" FontSize="10" Foreground="{DynamicResource UiFaint}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                  </ListBox>
                </Panel>
                <StackPanel Grid.Row="2" Spacing="4" Margin="2,6,2,0">
                  <TextBlock Text="{loc:Translate {Binding CommandNotice}}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiAccent}"/>
                  <TextBlock Text="{loc:Text M0586}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource UiFaint}"/>
                </StackPanel>
              </Grid>

              <Grid IsVisible="{Binding SelectedRightTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=5}"
                    RowDefinitions="Auto,*" Margin="8,6">
                <StackPanel Spacing="8">
                  <TextBlock Text="{loc:Text M0790}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
                  <ComboBox ItemsSource="{Binding AiPanel.Clis}" SelectedItem="{Binding AiPanel.SelectedCli}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="ai:AiCli">
                        <StackPanel Spacing="1"><TextBlock Text="{Binding DisplayName}" FontSize="12"/>
                          <TextBlock Text="{Binding Path}" FontSize="9" Foreground="{DynamicResource UiFaint}" TextTrimming="CharacterEllipsis"/></StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{loc:Text M0791}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"
                             IsVisible="{Binding AiPanel.Clis.Count, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=0}"/>
                  <TextBox Text="{Binding AiPanel.TaskDraft}" Watermark="{loc:Text M0792}"
                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="140"/>
                  <Button Content="{loc:Text M0793}" Classes="primary" HorizontalAlignment="Stretch"
                          Command="{Binding AiPanel.StartTaskCommand}"/>
                  <TextBlock Text="{Binding AiPanel.Notice}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource UiAccent}"/>
                </StackPanel>
                <Panel Grid.Row="1" Margin="0,8,0,0">
                  <TextBlock Text="{loc:Text M0794}" Foreground="{DynamicResource UiFaint}" FontSize="10"
                             HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                             IsVisible="{Binding AiPanel.Tasks.Count, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=0}"/>
                  <ListBox ItemsSource="{Binding AiPanel.Tasks}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:AiTaskViewModel">
                        <Border BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource UiInk}" TextWrapping="Wrap" Grid.ColumnSpan="2"/>
                            <TextBlock Grid.Row="1" FontSize="10" Foreground="{DynamicResource UiMuted}" VerticalAlignment="Center">
                              <Run Text="{Binding Cli.DisplayName}"/><Run Text=" · "/><Run Text="{Binding Status}"/>
                              <Run Text=" · "/><Run Text="{Binding Started, StringFormat={}{0:HH:mm}}"/>
                            </TextBlock>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                              <Button Content="{loc:Text M0679}" Classes="quiet" Padding="6,2" FontSize="10"
                                      IsVisible="{Binding Active}"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AiPanel.ShowTaskCommand}"
                                      CommandParameter="{Binding}"/>
                              <Button Content="{loc:Text Workbench9}" Classes="quiet" Padding="6,2" FontSize="10"
                                      IsVisible="{Binding !Active}"
                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AiPanel.RemoveTaskCommand}"
                                      CommandParameter="{Binding}"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Panel>
              </Grid>

            </Panel>
          </Grid>
        </Border>
      </Grid>

      <StackPanel x:Name="PluginSidePanel" Grid.Row="2" IsVisible="False" Width="300" HorizontalAlignment="Right" Margin="12" Background="{DynamicResource UiPanel}" ZIndex="70"/>
      <StackPanel x:Name="PluginBottomPanel" Grid.Row="4" IsVisible="False" MaxHeight="220" Background="{DynamicResource UiPanel}"/>
      <!-- ============ Status bar ============ -->
      <Border Grid.Row="5" Background="{DynamicResource UiCanvas}" Padding="26,0">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel x:Name="StatusContents" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <TextBlock x:Name="PluginNotice" Foreground="{DynamicResource UiBad}" MaxWidth="280" TextTrimming="CharacterEllipsis" IsVisible="False"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="▦" Foreground="{DynamicResource UiFaint}" FontSize="11" VerticalAlignment="Center"/>
              <TextBlock Text="{loc:Text M0587}" Foreground="{DynamicResource UiMuted}" FontSize="11"/>
              <TextBlock Text="{Binding ActiveDirectoryName}" Foreground="{DynamicResource UiInk}" FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock Text="{loc:Translate {Binding LaunchNotice}}" Foreground="{DynamicResource UiBad}" FontSize="11"
                       TextTrimming="CharacterEllipsis" MaxWidth="420"
                       ToolTip.Tip="{loc:Translate {Binding LaunchNotice}}"
                       IsVisible="{Binding LaunchNotice, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
            <TextBlock Text="{loc:Translate {Binding TerminalCount, StringFormat='◔ {0} 个终端'}}" Foreground="{DynamicResource UiMuted}" FontSize="11"/>
            <TextBlock Text="{loc:Translate {Binding RunningCount, StringFormat='⊕ {0} 个运行中'}}" Foreground="{DynamicResource UiMuted}" FontSize="11"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <TextBlock Text="{Binding CpuText}" Foreground="{DynamicResource UiMuted}" FontSize="11"/>
            <TextBlock Text="{loc:Translate {Binding MemText}}" Foreground="{DynamicResource UiMuted}" FontSize="11"/>
            <ctl:SparklineControl Values="{Binding StatusSpark}" Stroke="{DynamicResource UiAccent}" Width="50" Height="14" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border x:Name="DockSpace" Grid.Row="3" Height="112"
              IsVisible="{Binding DockVisibilityMode, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=1}"/>
    </Grid>

    <Border x:Name="DockHint" HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Width="82" Height="30" CornerRadius="15" Background="Transparent" Margin="0,0,0,11" ZIndex="101"
            PointerEntered="OnDockHintEntered"
            IsVisible="{Binding DockVisibilityMode, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=0}">
      <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center"><PathIcon Data="{StaticResource ToolTools}" Width="14" Height="14" Foreground="{DynamicResource UiInk}"/><TextBlock Text="{loc:Text M0454}" FontSize="11" Foreground="{DynamicResource UiInk}" VerticalAlignment="Center"/></StackPanel>
    </Border>
    <!-- ============ Floating action dock ============ -->
    <ctl:DropletDock x:Name="ActionDock" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,11"
            Padding="8" ZIndex="100"
            Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}">
      <ctl:DropletDock.Styles>
        <Style Selector="PathIcon"><Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Style>
        <Style Selector="Button.dock">
          <Setter Property="Padding" Value="16,10"/>
          <Setter Property="CornerRadius" Value="12"/><Setter Property="MinWidth" Value="72"/><Setter Property="VerticalContentAlignment" Value="Top"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="RenderTransform" Value="translateY(0px)"/>
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut"/><BrushTransition Property="Background" Duration="0:0:0.18"/><BrushTransition Property="Foreground" Duration="0:0:0.18"/>
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="Button.dock:pointerover">
          <Setter Property="RenderTransform" Value="translateY(-2px)"/>
          <Setter Property="Background" Value="{DynamicResource UiRaised}"/>
          <Setter Property="Foreground" Value="{DynamicResource UiInk}"/>
        </Style>
        <Style Selector="Button.dock.dock-active">
          <Setter Property="Background" Value="{DynamicResource UiAccentSoft}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/>
          <Setter Property="Foreground" Value="{DynamicResource UiInk}"/>
        </Style>
        <!-- Mockup: New Session is the primary CTA — a filled accent pill with
             an inline label, kept accent-filled even when dock-active. -->
        <Style Selector="Button.dock.dock-primary">
          <Setter Property="Background" Value="{DynamicResource UiAccent}"/>
          <Setter Property="Foreground" Value="{DynamicResource UiOnAccent}"/>
          <Setter Property="Padding" Value="18,10"/>
        </Style>
        <Style Selector="Button.dock.dock-primary:pointerover">
          <Setter Property="RenderTransform" Value="translateY(-2px)"/>
          <Setter Property="Background" Value="{DynamicResource UiAccent}"/>
          <Setter Property="Foreground" Value="{DynamicResource UiOnAccent}"/>
        </Style>
      </ctl:DropletDock.Styles>
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button x:Name="NewDockButton" Classes="dock dock-primary" Classes.dock-active="{Binding DockHighlight, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=0}"
                Command="{Binding DockSelectCommand}" CommandParameter="0"
                ToolTip.Tip="{loc:Text M0471}" AutomationProperties.Name="{loc:Text M0471}">
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <!-- Local Foreground outranks every style, including the window-level
                 dock rules (UiMuted at rest / UiAccent in dock-active → invisible). -->
            <PathIcon Data="{StaticResource ToolAdd}" Foreground="{DynamicResource UiOnAccent}"/>
            <TextBlock Text="{loc:Text M0471}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Classes="dock" Classes.dock-active="{Binding DockHighlight, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=1}"
                Command="{Binding DockSelectCommand}" CommandParameter="1">
          <StackPanel>
            <PathIcon Data="{StaticResource ToolMonitor}" HorizontalAlignment="Center"/>
            <TextBlock Text="{loc:Text M0590}" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
          </StackPanel>
        </Button>
        <Button Classes="dock" Classes.dock-active="{Binding DockHighlight, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=2}"
                Command="{Binding DockSelectCommand}" CommandParameter="2">
          <StackPanel>
            <PathIcon Data="{StaticResource ToolSsh}" HorizontalAlignment="Center"/>
            <TextBlock Text="SSH" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
          </StackPanel>
        </Button>
        <Button Classes="dock" Classes.dock-active="{Binding DockHighlight, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=3}"
                Command="{Binding DockSelectCommand}" CommandParameter="3">
          <StackPanel>
            <PathIcon Data="{StaticResource ToolLogs}" HorizontalAlignment="Center"/>
            <TextBlock Text="{loc:Text M0591}" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
          </StackPanel>
        </Button>
        <!-- Click: open artifacts, or publish if none. Ctrl+click / right-click 重新打包: force republish.
             Right-click also switches publish profiles, opens recent artifacts, opens the last
             successful artifact, copies its path, clears last result, and cancels a running publish.
             Under Deploy: last exit (or live packing elapsed) then the active profile name · RID. -->
        <Button x:Name="DeployDockButton" Classes="dock"
                Classes.dock-active="{Binding DockHighlight, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=4}"
                Command="{Binding DockSelectCommand}" CommandParameter="4"
                ToolTip.Tip="{loc:Translate {Binding DeployDockTip}}">
          <Button.ContextFlyout>
            <MenuFlyout Opening="OnDeployMenuOpening">
              <MenuItem Header="{loc:Text M0592}" Click="OnRepublishMenuClick"/>
              <MenuItem Header="{loc:Text M0593}" Click="OnCancelPublishMenuClick"
                        IsEnabled="{Binding IsPublishRunning}"/>
              <Separator/>
              <MenuItem Header="{loc:Text M0594}">
                <MenuItem Header="{loc:Text M0286}" IsEnabled="False"/>
              </MenuItem>
              <MenuItem Header="{loc:Text M0595}" Click="OnSavePublishProfileClick"/>
              <MenuItem Header="{loc:Text M0596}">
                <MenuItem Header="{loc:Text M0286}" IsEnabled="False"/>
              </MenuItem>
              <Separator/>
              <MenuItem Header="{loc:Text M0597}" Click="OnOpenLastSuccessClick"
                        IsEnabled="False"/>
              <MenuItem Header="{loc:Text M0598}" Click="OnCopyLastSuccessPathClick"
                        IsEnabled="False"/>
              <MenuItem Header="{loc:Text M0599}" Click="OnClearLastPublishResultClick"
                        IsEnabled="False"/>
              <MenuItem Header="{loc:Text M0600}">
                <MenuItem Header="{loc:Text M0289}" IsEnabled="False"/>
              </MenuItem>
            </MenuFlyout>
          </Button.ContextFlyout>
          <StackPanel>
            <PathIcon Data="{StaticResource ToolDeploy}" HorizontalAlignment="Center"/>
            <TextBlock Text="{loc:Translate {Binding DeployDockCaption}}" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            <TextBlock Text="{loc:Translate {Binding LastPublishBadge}}" FontSize="9"
                       HorizontalAlignment="Center" Margin="0,1,0,0"
                       IsVisible="{Binding HasLastPublishBadge}"
                       TextWrapping="NoWrap"/>
            <!-- Quiet active-profile line under the last-publish badge (name · RID). -->
            <TextBlock Text="{Binding ActivePublishProfileLabel}" FontSize="8"
                       HorizontalAlignment="Center" Margin="0,1,0,0" Opacity="0.72"
                       IsVisible="{Binding HasActivePublishProfileLabel}"
                       TextWrapping="NoWrap"/>
          </StackPanel>
        </Button>
        <Button x:Name="SettingsDockButton" Classes="dock"
                Classes.dock-active="{Binding DockHighlight, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=5}"
                Command="{Binding DockSelectCommand}" CommandParameter="5"
                ToolTip.Tip="{loc:Text M0455}">
          <StackPanel>
            <PathIcon Data="{StaticResource ToolSettings}" HorizontalAlignment="Center"/>
            <TextBlock Text="{loc:Text M0455}" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
          </StackPanel>
        </Button>

      </StackPanel>
    </ctl:DropletDock>

    <Border x:Name="SessionTransferHint" IsVisible="False" IsHitTestVisible="False" ZIndex="220"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,108,20,0" Padding="14,8"
            Background="{DynamicResource UiCanvas}" BorderBrush="{DynamicResource UiAccent}" BorderThickness="1" CornerRadius="10">
      <TextBlock x:Name="SessionTransferText" Foreground="{DynamicResource UiAccent}" TextTrimming="CharacterEllipsis" MaxWidth="700"/>
    </Border>
    <Border x:Name="RecentSwitcherPanel" IsVisible="{Binding RecentSwitcherOpen}" ZIndex="230" HorizontalAlignment="Center" VerticalAlignment="Center"
            Width="520" MaxHeight="580" Margin="24" Padding="22" CornerRadius="18"
            Background="{DynamicResource UiCanvas}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1"
            BoxShadow="{DynamicResource FloatingShadow}">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <TextBlock Text="{loc:Text M0601}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
        <ListBox x:Name="RecentSessionList" Grid.Row="1" MaxHeight="480" ItemsSource="{Binding RecentCandidates}"
                 Background="Transparent" BorderThickness="0" SelectedItem="{Binding SelectedRecent}" DoubleTapped="OnRecentDoubleTapped">
          <ListBox.Styles>
            <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,3"/></Style>
            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource UiRaised}"/></Style>
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource UiAccentSoft}"/></Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RecentSessionEntry">
              <Grid ColumnDefinitions="116,*" ColumnSpacing="16" Margin="2">
                <Border Height="64" ClipToBounds="True" Background="{DynamicResource UiInset}" CornerRadius="7" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1">
                  <ctl:StagePreview Emulator="{Binding Emulator}"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                  <TextBlock Text="{Binding Name}" Foreground="{DynamicResource UiInk}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Workspace}" Foreground="{DynamicResource UiMuted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Text="{loc:Text M0602}" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/>
      </Grid>
    </Border>

    <Border x:Name="ShellSetupPanel" IsVisible="{Binding ShellSetupOpen}" ZIndex="210"
            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Margin="24"
            Padding="24" Background="{DynamicResource UiCanvas}" BorderBrush="{DynamicResource UiBorder}"
            BorderThickness="1" BoxShadow="{DynamicResource SurfaceShadow}" CornerRadius="18">
      <StackPanel Spacing="14">
        <TextBlock Text="{loc:Text M0603}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
        <TextBlock Text="{loc:Translate {Binding ShellSetupMessage}}" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/>
        <ComboBox x:Name="StartupShellPicker" ItemsSource="{Binding AvailableStartupShells}"
                  SelectedItem="{Binding SelectedStartupShell}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="corepty:AvailableShell">
              <TextBlock Text="{Binding Name}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox Text="{Binding StartupCustomShell}" Watermark="{loc:Text M0604}"/>
        <Button Content="{loc:Text M0605}" Command="{Binding ContinueShellSetupCommand}" HorizontalAlignment="Right"/>
      </StackPanel>
    </Border>

    <!-- Floating, grouped preferences; header and actions stay visible when scrolling. -->
    <Border x:Name="SettingsPanel" IsVisible="False" ctl:DropletExpansion.IsOpen="{Binding SettingsOpen}" ZIndex="200"
            HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="440" Margin="16"
            Background="{DynamicResource UiCanvas}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1"
            BoxShadow="{DynamicResource FloatingShadow}" CornerRadius="18" ClipToBounds="True">
      <Grid RowDefinitions="76,*,66">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="22,16">
          <Border Width="38" Height="38" Background="{DynamicResource UiAccentSoft}" CornerRadius="10">
            <PathIcon Data="{StaticResource ToolSettings}" Width="20" Height="20" Foreground="{DynamicResource UiAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{loc:Text M0455}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
            <TextBlock Text="{loc:Text M0606}" FontSize="11" Foreground="{DynamicResource UiMuted}"/>
          </StackPanel>
          <Button Grid.Column="2" Content="×" Width="28" Height="28" Padding="0" CornerRadius="14"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Background="{DynamicResource UiRaised}" Foreground="{DynamicResource UiMuted}" BorderThickness="0"
                  Command="{Binding DockSelectCommand}" CommandParameter="5" ToolTip.Tip="{loc:Text M0607}"/>
        </Grid>
        <TabControl x:Name="SettingsTabs" Grid.Row="1" Margin="16,0,16,12">
          <TabItem Header="{loc:Text M0608}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="12" Margin="4,12,4,4">
                <Border Classes="settings-group">
                  <StackPanel Spacing="10">
                    <TextBlock Text="{loc:Text Language}" Foreground="{DynamicResource UiInk}"/>
                    <ComboBox Classes="localized" x:Name="LanguagePicker" SelectedIndex="{Binding LanguageIndex}">
                      <ComboBoxItem Content="{loc:Text FollowSystem}"/>
                      <ComboBoxItem Content="简体中文"/>
                      <ComboBoxItem Content="English"/>
                    </ComboBox>
                    <TextBlock Text="{loc:Text M0609}" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
                    <ComboBox Classes="localized" x:Name="ThemePicker" SelectedIndex="{Binding ThemeIndex}">
                      <ComboBoxItem Content="{loc:Text M0688}"/><ComboBoxItem Content="{loc:Text M0689}"/>
                      <ComboBoxItem Content="{loc:Text M0690}"/><ComboBoxItem Content="{loc:Text M0691}"/>
                    </ComboBox>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                      <Button Content="−" Classes="terminal-tool" Command="{Binding DecreaseFontSizeCommand}" ToolTip.Tip="{loc:Text M0610}"/>
                      <NumericUpDown Grid.Column="1" Value="{Binding FontSize}" Minimum="8" Maximum="32" Increment="1" FormatString="0"/>
                      <Button Grid.Column="2" Content="＋" Classes="terminal-tool" Command="{Binding IncreaseFontSizeCommand}" ToolTip.Tip="{loc:Text M0611}"/>
                      <Button Grid.Column="3" Content="{loc:Text M0612}" Classes="terminal-tool" Command="{Binding ResetTerminalFontSizeCommand}"/>
                    </Grid>
                    <TextBox Text="{Binding TerminalFontName}" Watermark="{loc:Text M0613}"/>
                    <TextBlock Text="{loc:Text M0614}" FontSize="11" Foreground="{DynamicResource UiMuted}"/>
                  </StackPanel>
                </Border>
                <TextBlock Classes="settings-heading" Text="{loc:Text M0615}"/>
                <Border Background="{DynamicResource UiInset}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding TerminalPreviewPrompt}" FontFamily="{Binding TerminalFont}" FontSize="{Binding FontSize}" Foreground="{DynamicResource UiAccent}"/>
                    <TextBlock Text="{loc:Text M0616}" FontFamily="{Binding TerminalFont}" FontSize="{Binding FontSize}" Foreground="{DynamicResource UiInk}" TextWrapping="Wrap"/>
                    <TextBlock Text="✓ Build succeeded" FontFamily="{Binding TerminalFont}" FontSize="{Binding FontSize}" Foreground="{DynamicResource UiGood}"/>
                  </StackPanel>
                </Border>
                <TextBlock Text="{loc:Text M0617}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource UiMuted}"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="{loc:Text M0201}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Border Classes="settings-group" Margin="4,12,4,4">
                <StackPanel Spacing="14">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Text M0618}" Foreground="{DynamicResource UiInk}" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding InspectorVisible}" OnContent="" OffContent="" MinWidth="0"/></Grid>
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Text M0619}" Foreground="{DynamicResource UiInk}" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding OutputVisible}" OnContent="" OffContent="" MinWidth="0"/></Grid>
                  <TextBlock Text="{loc:Text M0620}" Foreground="{DynamicResource UiInk}"/>
                  <ComboBox Classes="localized" SelectedIndex="{Binding DockVisibilityMode}"><ComboBoxItem Content="{loc:Text M0692}"/><ComboBoxItem Content="{loc:Text M0693}"/><ComboBoxItem Content="{loc:Text M0694}"/></ComboBox>
                  <TextBlock Text="{loc:Text M0621}" Foreground="{DynamicResource UiInk}"/>
                  <TextBox Text="{Binding WorkspaceNameLive}"/>
                  <TextBlock Text="{loc:Text M0317}" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
                  <ComboBox x:Name="WorkspaceTemplatePicker" ItemsSource="{Binding WorkspaceTemplates}" SelectedItem="{Binding SelectedTemplate}">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="settings:WorkspaceTemplate"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBox Text="{Binding TemplateName}" Watermark="{loc:Text M0622}"/>
                  <WrapPanel>
                    <Button Content="{loc:Text M0623}" Command="{Binding SaveCurrentAsTemplateCommand}" Margin="0,0,6,6"/>
                    <Button Content="{loc:Text M0624}" Command="{Binding OpenTemplateCommand}" IsEnabled="{Binding !IsOpeningTemplate}" Margin="0,0,6,6"/>
                    <Button Content="{loc:Text M0625}" Command="{Binding SaveTemplateChangesCommand}" Margin="0,0,6,6"/>
                    <Button Content="{loc:Text M0626}" Command="{Binding UpdateTemplateLayoutCommand}" Margin="0,0,6,6"/>
                    <Button Content="{loc:Text M0627}" Command="{Binding DuplicateTemplateCommand}" Margin="0,0,6,6"/>
                    <Button Content="{loc:Text M0628}" Click="OnExportTemplate" Margin="0,0,6,6"/>
                    <Button Content="{loc:Text M0629}" Click="OnImportTemplate" Margin="0,0,6,6"/>
                    <Button Content="{loc:Text M0630}" Command="{Binding DeleteTemplateCommand}" Margin="0,0,6,6"/>
                  </WrapPanel>
                  <TextBlock Text="{loc:Text M0631}" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
                  <TextBlock Text="{loc:Translate {Binding TemplatePreview}}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/>
                  <TextBlock Text="{loc:Translate {Binding TemplateMessage}}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiAccent}"/>
                  <TextBlock Text="{loc:Text M0632}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/>
                  <TextBlock Text="{loc:Text M0633}" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
                  <ItemsControl ItemsSource="{Binding SessionGroups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="settings:SessionGroup">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                          <TextBox Text="{Binding Name}" Watermark="{loc:Text M0311}"/>
                          <Button Grid.Column="1" Content="{loc:Text M0634}" Margin="6,0,0,0"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteGroupCommand}"
                                  CommandParameter="{Binding}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="{loc:Text M0310}" Click="OnCreateEmptyGroup" HorizontalAlignment="Left"/>
                  <ItemsControl ItemsSource="{Binding TemplateSessions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WorkspaceSessionEditor">
                        <Expander Header="{Binding Name}" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                          <StackPanel Spacing="8">
                            <TextBox Text="{Binding Name}" Watermark="{loc:Text M0272}"/>
                            <TextBox Text="{Binding WorkingDirectory}" Watermark="{loc:Text M0635}"/>
                            <TextBox Text="{Binding Shell}" Watermark="Shell"/>
                            <TextBox Text="{Binding Arguments}" Watermark="{loc:Text M0636}"/>
                            <TextBox Text="{Binding StartupCommand}" Watermark="{loc:Text M0637}"/>
                            <CheckBox Content="{loc:Text M0638}" IsChecked="{Binding RunStartupCommand}" IsEnabled="{Binding CanRunStartupCommand}"/>
                          </StackPanel>
                        </Expander>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="{loc:Text M0639}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="12" Margin="4,12,4,4">
                <TextBlock Text="{loc:Text M0640}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/>
                <TextBlock Text="{loc:Text M0641}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/>
                <ItemsControl ItemsSource="{Binding SessionShortcuts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionShortcutViewModel">
                      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,180" Margin="0,0,0,10">
                        <TextBlock Text="{loc:Translate {Binding Label}}" Foreground="{DynamicResource UiInk}" VerticalAlignment="Center"/>
                        <ctl:ShortcutEditor Grid.Column="1" Text="{Binding Gesture, Mode=TwoWay}" ToolTip.Tip="{loc:Text M0642}"/>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{loc:Translate {Binding Error}}" Foreground="{DynamicResource UiBad}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" IsVisible="{Binding Error, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{loc:Text M0643}" Command="{Binding ResetSessionShortcutsCommand}"/>
                <TextBlock Text="{loc:Text M0644}" FontSize="11" Foreground="{DynamicResource UiMuted}"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="{loc:Text M0645}">
            <Border Classes="settings-group" Margin="4,12,4,4" VerticalAlignment="Top">
              <StackPanel Spacing="12">
                <TextBlock Text="{loc:Text M0646}" Foreground="{DynamicResource UiInk}"/>
                <ComboBox ItemsSource="{Binding SettingsShellLabels}" SelectedIndex="{Binding SettingsShellIndex}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{loc:Translate {ReflectionBinding}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                <TextBlock Text="{loc:Text M0647}" Foreground="{DynamicResource UiInk}"/>
                <TextBox Text="{Binding Settings.CustomShellPath}" Watermark="{loc:Translate {Binding CustomShellWatermark}}"/>
                <CheckBox Content="{loc:Translate {Binding FileManagerMenuLabel}}" IsChecked="{Binding ExplorerMenuEnabled}" IsEnabled="{Binding FileManagerMenuAvailable}"/>
                <TextBlock Text="{loc:Translate {Binding ExplorerMenuMessage}}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/>
                <TextBlock Text="{loc:Text M0648}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/>
              </StackPanel>
            </Border>
          </TabItem>
          <TabItem Header="{loc:Text M0649}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="4,12">
              <TextBlock Text="Terminal Hub" FontSize="20" Foreground="{DynamicResource UiInk}"/>
              <TextBlock Text="{loc:Translate {Binding AppVersionText}}" Foreground="{DynamicResource UiMuted}"/>
              <TextBlock Text="{loc:Text M0650}" FontSize="11" Foreground="{DynamicResource UiMuted}"/>
              <TextBox Text="{Binding Settings.FileEditorPath}" Watermark="{loc:Text M0651}"/>
              <CheckBox Content="{loc:Text M0652}" IsChecked="{Binding Settings.NotifyCommandCompletion}"/>
              <TextBlock Text="{loc:Text M0653}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/>
              <Button Content="{loc:Text M0654}" Command="{Binding OpenReleaseNotesCommand}"/>
              <Button Content="{loc:Text M0655}" Command="{Binding CheckForUpdatesCommand}"/>
              <Button Content="{loc:Text M0656}" Command="{Binding OpenProjectReleasesCommand}"/>
              <TextBlock Text="{loc:Translate {Binding UpdateMessage}}" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/>
              <ComboBox ItemsSource="{Binding UpdateAssets}" SelectedItem="{Binding SelectedUpdateAsset}" IsEnabled="{Binding !IsDownloadingUpdate}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="settings:ReleaseAsset"><StackPanel Spacing="3"><TextBlock Text="{loc:Translate {Binding Label}}"/><TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource UiMuted}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="{loc:Text M0657}" Click="OnDownloadUpdate" IsEnabled="{Binding !IsDownloadingUpdate}"/>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateDownloadPercent}" IsIndeterminate="{Binding UpdateDownloadIndeterminate}" IsVisible="{Binding IsDownloadingUpdate}"/>
              <Button Content="{loc:Text M0658}" Command="{Binding CancelUpdateDownloadCommand}" IsVisible="{Binding IsDownloadingUpdate}"/>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasDownloadedUpdate}"><Button Content="{loc:Text M0659}" Command="{Binding OpenDownloadedUpdateCommand}"/><Button Content="{loc:Text M0660}" Command="{Binding OpenUpdateFolderCommand}"/></StackPanel>
              <TextBlock Text="{loc:Text M0661}" Foreground="{DynamicResource UiInk}"/>
              <TextBox Text="{Binding UpdateNotes}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200"/>
              <Button Content="{loc:Text M0662}" Command="{Binding OpenUpdateDownloadCommand}"/>
            </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="{loc:Text M0338}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="12" Margin="4,12,4,4">
                <TextBlock Text="{loc:Text M0663}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/>
                <TextBlock Text="{loc:Translate {Binding FavoriteNotice}}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiAccent}"/>
                <ItemsControl ItemsSource="{Binding FavoriteCommands}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FavoriteCommandViewModel">
                      <Border BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel Spacing="8">
                          <TextBox Text="{Binding Name}" Watermark="{loc:Text M0664}"/>
                          <TextBox Text="{Binding Command}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Watermark="{loc:Text M0665}"/>
                          <TextBox Text="{Binding Shell}" Watermark="{loc:Text M0666}"/>
                          <ctl:ShortcutEditor Text="{Binding Shortcut, Mode=TwoWay}" ToolTip.Tip="{loc:Text M0667}"/>
                          <TextBlock Text="{loc:Translate {Binding Error}}" Foreground="{DynamicResource UiBad}" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
                          <Button Content="{loc:Text M0634}" HorizontalAlignment="Left"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteFavoriteCommand}"
                                  CommandParameter="{Binding}"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{loc:Text M0668}" Command="{Binding AddFavoriteCommand}" HorizontalAlignment="Left"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="0,1,0,0" Padding="20,12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Text M0669}" FontSize="11" Foreground="{DynamicResource UiMuted}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="{loc:Text M0010}" MinWidth="86" Background="{DynamicResource UiAccent}" Foreground="{DynamicResource UiOnAccent}" CornerRadius="8"
                    Padding="18,8" HorizontalContentAlignment="Center" Command="{Binding SaveSettingsCommand}"/>
          </Grid>
        </Border>
      </Grid>
    </Border>
    <Border ZIndex="290" Background="#66000000" IsVisible="{Binding #PalettePanel.IsVisible}" PointerPressed="OnPaletteBackdrop"/>
    <Border x:Name="PalettePanel" IsVisible="False" ZIndex="300" Width="620" MaxHeight="500"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,90,24,24" Padding="20"
            Background="{DynamicResource UiCanvas}" BorderBrush="{DynamicResource UiAccent}" BorderThickness="1"
            BoxShadow="{DynamicResource FloatingShadow}" CornerRadius="14">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <TextBlock Text="{loc:Text M0670}" Foreground="{DynamicResource UiInk}" FontSize="17" FontWeight="SemiBold"/>
        <TextBox x:Name="PaletteSearch" Grid.Row="1" Watermark="{loc:Text M0671}" TextChanged="OnPaletteTextChanged"/>
        <ListBox x:Name="PaletteResults" Grid.Row="2" MaxHeight="320" Background="Transparent" BorderThickness="0" DoubleTapped="OnExecutePalette">
          <ListBox.Styles>
            <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource UiRaised}"/></Style>
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource UiAccentSoft}"/></Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PaletteEntry">
              <Grid ColumnDefinitions="*,Auto" Margin="6,5">
                <StackPanel Spacing="4"><TextBlock Text="{loc:Translate {Binding Label}}" Foreground="{DynamicResource UiInk}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{loc:Translate {Binding Detail}}" FontSize="11" Foreground="{DynamicResource UiMuted}" TextTrimming="CharacterEllipsis"/></StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Shortcut}" Foreground="{DynamicResource UiFaint}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Spacing="6"><TextBlock x:Name="PaletteEmpty" Text="{loc:Text M0672}" Foreground="{DynamicResource UiMuted}"/><TextBlock Text="{loc:Text M0673}" FontSize="11" Foreground="{DynamicResource UiFaint}"/></StackPanel>
      </Grid>
    </Border>
    <Border IsVisible="{Binding NotificationVisible}" ZIndex="220" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24,0,24,90" MaxWidth="380" Padding="16" CornerRadius="12" Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiAccent}" BorderThickness="1">
      <StackPanel Spacing="10"><TextBlock Text="{loc:Translate {Binding NotificationText}}" TextWrapping="Wrap" Foreground="{DynamicResource UiInk}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="{loc:Text M0674}" Command="{Binding ShowNotificationSessionCommand}"/><Button Content="{loc:Text M0675}" Command="{Binding DismissNotificationCommand}"/></StackPanel></StackPanel>
    </Border>
    <Border ZIndex="290" Background="#66000000" IsVisible="{Binding #BookmarkPanel.IsVisible}" PointerPressed="OnBookmarkBackdrop"/>
    <Border x:Name="BookmarkPanel" IsVisible="False" ZIndex="300" Width="760" MaxHeight="620"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,80,24,24" Padding="20"
            Background="{DynamicResource UiCanvas}" BorderBrush="{DynamicResource UiAccent}" BorderThickness="1"
            BoxShadow="{DynamicResource FloatingShadow}" CornerRadius="14">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{loc:Text M0676}" Foreground="{DynamicResource UiInk}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Content="{loc:Text M0015}" Classes="terminal-tool" Padding="10,3" FontSize="11"
                    Classes.selected="{Binding !BookmarksAllSessions}" Click="OnBookmarkScopeSession"/>
            <Button Content="{loc:Text M0058}" Classes="terminal-tool" Padding="10,3" FontSize="11"
                    Classes.selected="{Binding BookmarksAllSessions}" Click="OnBookmarkScopeAll"/>
          </StackPanel>
        </Grid>
        <TextBox x:Name="BookmarkSearch" Grid.Row="1" Watermark="{loc:Text M0677}" TextChanged="OnBookmarkSearchChanged"/>
        <TextBlock Grid.Row="2" FontSize="10" Foreground="{DynamicResource UiFaint}" TextWrapping="Wrap"
                   Text="{loc:Text M0678}"/>
        <ListBox x:Name="BookmarkResults" Grid.Row="3" MaxHeight="220" Background="Transparent" BorderThickness="0"
                 ItemsSource="{Binding VisibleBookmarks}" SelectedItem="{Binding SelectedBookmark}" Tapped="OnBookmarkTapped">
          <ListBox.Styles>
            <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource UiRaised}"/></Style>
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource UiAccentSoft}"/></Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:BookmarkViewModel">
              <Grid ColumnDefinitions="*,Auto" Margin="6,5">
                <StackPanel Spacing="3" MinWidth="0">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Meta}" FontSize="10" Foreground="{DynamicResource UiMuted}"/>
                  <TextBlock Text="{Binding Preview}" FontSize="10" Foreground="{DynamicResource UiFaint}" TextTrimming="CharacterEllipsis" MaxWidth="440"/>
                  <TextBlock Text="{loc:Translate {Binding LocateText}}" FontSize="10" Foreground="{DynamicResource UiAccent}"
                             IsVisible="{Binding LocateText, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                  <Button Content="{loc:Text M0679}" FontSize="10" Padding="8,2" CornerRadius="5" Click="OnViewBookmark"
                          ToolTip.Tip="{loc:Text M0680}"/>
                  <Button Content="{loc:Text M0581}" FontSize="10" Padding="8,2" CornerRadius="5"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LocateBookmarkCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="{loc:Text M0681}"/>
                  <Button Content="{loc:Text M0682}" FontSize="10" Padding="8,2" CornerRadius="5"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyBookmarkCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="{loc:Text M0683}"/>
                  <Button Content="{loc:Text M0684}" FontSize="10" Padding="8,2" CornerRadius="5" Click="OnRenameBookmark"
                          ToolTip.Tip="{loc:Text M0342}"/>
                  <Button Content="{loc:Text M0634}" FontSize="10" Padding="8,2" CornerRadius="5"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteBookmarkCommand}" CommandParameter="{Binding}"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="4" RowDefinitions="Auto,Auto" RowSpacing="6"
              IsVisible="{Binding SelectedBookmark, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Text M0685}" FontSize="11" Foreground="{DynamicResource UiMuted}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="SaveBookmarkButton" Content="{loc:Text M0344}" FontSize="11" Padding="10,3" Click="OnSaveBookmark"/>
          </Grid>
          <TextBox x:Name="BookmarkSnapshotText" Grid.Row="1" Text="{Binding SelectedBookmark.Text}" IsReadOnly="True"
                   AcceptsReturn="True" TextWrapping="NoWrap" Height="130"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Grid>
        <StackPanel Grid.Row="5" Spacing="5">
          <TextBlock Text="{loc:Translate {Binding BookmarkNotice}}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiAccent}"
                     IsVisible="{Binding BookmarkNotice, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
          <TextBlock x:Name="BookmarkEmpty" Text="{loc:Text M0686}" FontSize="11" Foreground="{DynamicResource UiMuted}" TextWrapping="Wrap"/>
          <TextBlock Text="{loc:Text M0687}" FontSize="11" Foreground="{DynamicResource UiFaint}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="ToastPanel" IsVisible="False" ZIndex="310" HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Margin="24,0,24,96" Padding="14,8" CornerRadius="10" MaxWidth="620"
            Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiAccent}" BorderThickness="1">
      <TextBlock x:Name="ToastText" FontSize="11" Foreground="{DynamicResource UiInk}" TextWrapping="Wrap"/>
    </Border>
  </Panel>
</Window>
