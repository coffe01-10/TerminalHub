<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TerminalHub.App.ViewModels"
        xmlns:ctl="using:TerminalHub.App.Controls"
        xmlns:mon="using:TerminalHub.Core.Monitoring"
        xmlns:ai="using:TerminalHub.Core.AI"
        xmlns:files="using:TerminalHub.Core.Files"
        xmlns:ssh="using:TerminalHub.Core.Ssh"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="TerminalHub.App.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Title="Terminal Hub · 终端控制中心"
        Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        Background="#FF0A0D14"
        TransparencyLevelHint="AcrylicBlur">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewSessionCommand}"/>
  </Window.KeyBindings>

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Panel>
    <Grid RowDefinitions="34,*,28">

      <!-- ============ Title bar ============ -->
      <Border Grid.Row="0" Background="#B3121724" Padding="12,0">
        <Grid ColumnDefinitions="Auto,*">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Width="18" Height="18" CornerRadius="4" Background="#3B82F6">
              <TextBlock Text="▦" FontSize="11" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Terminal Hub" Foreground="#E2E8F0" FontSize="13"
                       FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="终端控制中心" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                      Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="{Binding OsLabel}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
            <Button Content="⚙" Padding="6,0" Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                    Command="{Binding DockSelectCommand}" CommandParameter="5"/>
            <Button Content="—" Padding="6,0" Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                    Click="OnMinimizeClick"/>
            <Button Content="▢" Padding="6,0" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="10"
                    Click="OnMaximizeClick"/>
            <Button Content="✕" Padding="6,0" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="10"
                    Click="OnCloseClick"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============ Main three-rail ============ -->
      <Grid Grid.Row="1" ColumnDefinitions="212,6,*,6,352" Margin="8,4,8,0">

        <!-- ===== LEFT: session cards ===== -->
        <Border Grid.Column="0" CornerRadius="14"
                Background="#66131A28" BorderBrush="#332A3142" BorderThickness="1">
          <Grid RowDefinitions="*,Auto" Margin="8">
            <ListBox ItemsSource="{Binding SessionCards}"
                     SelectedItem="{Binding ActiveCard}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="Margin" Value="0,0,0,10"/>
                  <Setter Property="CornerRadius" Value="10"/>
                  <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem:selected">
                  <Setter Property="Background" Value="Transparent"/>
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SessionCardViewModel">
                  <Border CornerRadius="10" Padding="8"
                          BorderThickness="1.5"
                          Classes.active="{Binding IsActive}"
                          Background="#CC141B29">
                    <Border.Styles>
                      <Style Selector="Border">
                        <Setter Property="BorderBrush" Value="#332A3142"/>
                      </Style>
                      <Style Selector="Border.active">
                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                        <Setter Property="Background" Value="#E61A2233"/>
                        <Setter Property="BoxShadow" Value="0 0 22 1 #7338BDF8"/>
                      </Style>
                    </Border.Styles>
                    <StackPanel Spacing="5">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}"/>
                          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                        </StackPanel>
                        <Border Grid.Column="1" IsVisible="{Binding HasTag}"
                                CornerRadius="7" Padding="8,2" Background="{Binding TagPillBrush}">
                          <TextBlock Text="{Binding TagText}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding TagBrush}"/>
                        </Border>
                      </Grid>
                      <Border CornerRadius="6" Background="#F20A0D14" Padding="4" MinHeight="92">
                        <ItemsControl ItemsSource="{Binding PreviewLines}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"
                                         FontFamily="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"
                                         FontSize="6.6" LineHeight="7.4" TextWrapping="NoWrap"/>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Button Grid.Row="1" CornerRadius="10" Margin="0,4,0,0" Padding="10,8"
                    Background="#1A2438" BorderBrush="#3B82F6" BorderThickness="1"
                    HorizontalContentAlignment="Left"
                    Command="{Binding NewSessionCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="+" Foreground="#38BDF8" FontWeight="Bold"/>
                <TextBlock Text="新建终端" Foreground="#E2E8F0"/>
                <TextBlock Text="Ctrl N" Foreground="#64748B" FontSize="10" Margin="14,0,0,0"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- ===== CENTER ===== -->
        <Border Grid.Column="2" CornerRadius="14"
                Background="#66131A28" BorderBrush="#332A3142" BorderThickness="1">
          <Grid RowDefinitions="34,30,*,Auto,Auto,170" Margin="6">

            <!-- Tab strip -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="4,0,8,0">
                <Ellipse Width="10" Height="10" Fill="#F87171"/>
                <Ellipse Width="10" Height="10" Fill="#FBBF24"/>
                <Ellipse Width="10" Height="10" Fill="#34D399"/>
              </StackPanel>
              <ListBox Grid.Column="1" ItemsSource="{Binding SessionCards}"
                       SelectedItem="{Binding ActiveCard}"
                       Background="Transparent" BorderThickness="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="2,3"/>
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="Background" Value="#26131A28"/>
                    <Setter Property="BorderBrush" Value="#332A3142"/>
                    <Setter Property="BorderThickness" Value="1"/>
                  </Style>
                  <Style Selector="ListBoxItem:selected">
                    <Setter Property="Background" Value="#3B233246"/>
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SessionCardViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,4">
                      <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#E2E8F0"/>
                      <Button Content="×" FontSize="11" Padding="2,0" Background="Transparent"
                              Foreground="#64748B" BorderThickness="0"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseSessionCommand}"
                              CommandParameter="{Binding}"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Grid.Column="2" Content="＋" Padding="10,2" Margin="4,3" CornerRadius="8"
                      Background="#26131A28" Foreground="#38BDF8" BorderBrush="#332A3142"
                      Command="{Binding NewSessionCommand}"/>
            </Grid>

            <!-- Toolbar: ← back / ⟳ refresh CWD / → forward + path -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
              <Button Content="←" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" Padding="6,0"
                      Command="{Binding CwdBackCommand}" IsEnabled="{Binding CanCwdBack}"
                      ToolTip.Tip="后退目录历史"/>
              <Button Grid.Column="1" Content="⟳" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" Padding="6,0"
                      Command="{Binding RefreshCwdCommand}" ToolTip.Tip="刷新 CWD"/>
              <Button Grid.Column="2" Content="→" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" Padding="6,0"
                      Command="{Binding CwdForwardCommand}" IsEnabled="{Binding CanCwdForward}"
                      ToolTip.Tip="前进目录历史"/>
              <TextBlock Grid.Column="3" Text="{Binding Breadcrumb}" FontSize="11"
                         Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,0,0"/>
              <Button Grid.Column="4" Content="◫ 分屏" Background="Transparent" BorderThickness="0"
                      Foreground="{Binding IsSplit, Converter={x:Static vm:BoolBrushConverter.Instance}}"
                      FontSize="11" Padding="6,0"
                      Command="{Binding ToggleSplitCommand}"
                      ToolTip.Tip="并排显示两个会话;点击窗格聚焦,点会话卡分配到该窗格。再点退出。"/>
              <Button Grid.Column="5" Content="↗ 在新窗口打开" Background="Transparent" BorderThickness="0"
                      Foreground="#94A3B8" FontSize="11" Padding="6,0"
                      Command="{Binding OpenInNewWindowCommand}"
                      ToolTip.Tip="把当前会话弹出为独立窗口（关闭子窗即收回）"/>
              <Button Grid.Column="6" Content="•••" Background="Transparent" BorderThickness="0"
                      Foreground="#94A3B8" Padding="6,0"/>
            </Grid>

            <!-- Terminal viewport -->
            <Border Grid.Row="2" CornerRadius="8" Background="#F20A0D14" Margin="2,4" ClipToBounds="True">
              <Panel>
                <!-- single view -->
                <ctl:TerminalView IsVisible="{Binding !IsSplit}"
                                  Emulator="{Binding ActiveSession.Emulator}"
                                  TerminalFontSize="{Binding FontSize}"/>
                <!-- split view: two independent sessions + draggable divider -->
                <Grid IsVisible="{Binding IsSplit}" ColumnDefinitions="*,5,*">
                  <Border BorderThickness="1.5" CornerRadius="6" Margin="0,0,3,0"
                          Classes.pane-focus="{Binding FocusedPane, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=0}">
                    <Border.Styles>
                      <Style Selector="Border"><Setter Property="BorderBrush" Value="Transparent"/></Style>
                      <Style Selector="Border.pane-focus"><Setter Property="BorderBrush" Value="#5538BDF8"/></Style>
                    </Border.Styles>
                    <ctl:TerminalView Emulator="{Binding LeftPane.Emulator}"
                                      TerminalFontSize="{Binding FontSize}"
                                      PointerPressed="OnLeftPanePressed"/>
                  </Border>
                  <GridSplitter Grid.Column="1" Width="5" Background="#221A2030"
                                ResizeBehavior="BasedOnAlignment"/>
                  <Border Grid.Column="2" BorderThickness="1.5" CornerRadius="6" Margin="3,0,0,0"
                          Classes.pane-focus="{Binding FocusedPane, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=1}">
                    <Border.Styles>
                      <Style Selector="Border"><Setter Property="BorderBrush" Value="Transparent"/></Style>
                      <Style Selector="Border.pane-focus"><Setter Property="BorderBrush" Value="#5538BDF8"/></Style>
                    </Border.Styles>
                    <Panel PointerPressed="OnRightPanePressed" Background="Transparent">
                      <ctl:TerminalView Emulator="{Binding RightPane.Emulator}"
                                        TerminalFontSize="{Binding FontSize}"
                                        IsVisible="{Binding RightPane, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
                      <TextBlock Text="右栏暂无会话 — 点击左侧会话卡分配到这里"
                                 Foreground="#64748B" FontSize="11" TextWrapping="Wrap"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                                 IsVisible="{Binding RightPane, Converter={x:Static conv:ObjectConverters.IsNull}}"/>
                    </Panel>
                  </Border>
                </Grid>
              </Panel>
            </Border>

            <!-- Assistant progress row -->
            <Grid Grid.Row="3" Margin="6,3" IsVisible="{Binding Assistant.HasProgress}"
                  ColumnDefinitions="*,Auto">
              <ProgressBar Value="{Binding Assistant.ProgressPercent}" Minimum="0" Maximum="100"
                           Height="7" CornerRadius="3.5" Foreground="#3B82F6" Background="#1A2030"/>
              <TextBlock Grid.Column="1" Text="{Binding Assistant.ProgressLabel}"
                         FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>

            <!-- Command input -->
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="4,2">
              <TextBox Text="{Binding CommandInput}" Watermark="输入命令，或 ? 开头向 Codex 提问…"
                       Background="#1A2030" CornerRadius="10" BorderBrush="#2A3142" BorderThickness="1"
                       Foreground="#E2E8F0" Padding="12,6" FontSize="12"
                       KeyDown="OnCommandInputKeyDown"/>
              <Button Grid.Column="1" Content="➤" Margin="6,0,0,0" Width="38" CornerRadius="10"
                      Background="#3B82F6" Foreground="White"
                      Command="{Binding SubmitCommandInputCommand}"/>
            </Grid>

            <!-- Bottom panel: Output / Debug / Problems / Search -->
            <Border Grid.Row="5" CornerRadius="8" Background="#99131A28"
                    BorderBrush="#332A3142" BorderThickness="1">
              <Grid RowDefinitions="30,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="4,0">
                  <ListBox SelectedIndex="{Binding Dashboard.SelectedBottomTab}"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ScrollViewer.VerticalScrollBarVisibility="Disabled"
                           Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="12,4"/>
                        <Setter Property="Margin" Value="0,3"/>
                        <Setter Property="CornerRadius" Value="6"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="Background" Value="Transparent"/>
                      </Style>
                      <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="#3B82F6"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                      </Style>
                    </ListBox.Styles>
                    <ListBoxItem>Output</ListBoxItem>
                    <ListBoxItem>Debug</ListBoxItem>
                    <ListBoxItem>
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Problems"/>
                        <Border IsVisible="{Binding Dashboard.HasProblems}" CornerRadius="8"
                                Background="#F87171" Padding="5,1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Dashboard.ProblemCount}" FontSize="9" Foreground="White"/>
                        </Border>
                      </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>Search</ListBoxItem>
                  </ListBox>
                  <Button Grid.Column="1" Content="⧉ Clear" FontSize="10" Padding="8,2"
                          Background="#1A2030" CornerRadius="6" BorderBrush="#2A3142"
                          Foreground="#94A3B8" VerticalAlignment="Center"
                          Command="{Binding Dashboard.ClearOutputCommand}"/>
                  <ComboBox Grid.Column="2" SelectedIndex="0" Margin="6,0,0,0" VerticalAlignment="Center"
                            Background="#1A2030" BorderBrush="#2A3142" FontSize="10" MinWidth="90"
                            CornerRadius="6" Padding="6,2">
                    <ComboBoxItem>All Levels</ComboBoxItem>
                    <ComboBoxItem>Info</ComboBoxItem>
                    <ComboBoxItem>Warn</ComboBoxItem>
                    <ComboBoxItem>Error</ComboBoxItem>
                  </ComboBox>
                </Grid>

                <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="#1F2635">
                  <Panel>
                    <!-- Output -->
                    <ListBox IsVisible="{Binding Dashboard.SelectedBottomTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=0}"
                             ItemsSource="{Binding Dashboard.OutputLog}"
                             Background="Transparent" BorderThickness="0" Padding="6">
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                          <Setter Property="Padding" Value="2,1"/>
                          <Setter Property="Background" Value="Transparent"/>
                          <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                          <Setter Property="FontSize" Value="10"/>
                        </Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntry">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}" Foreground="#64748B"/>
                            <TextBlock Text="{Binding Level, StringFormat='[{0}]'}"
                                       Foreground="{Binding Level, Converter={x:Static vm:LogLevelConverter.Instance}}"/>
                            <TextBlock Text="{Binding Message}" Foreground="#CBD5E1"/>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Debug: raw session lines (pre-ANSI-strip, control bytes escaped) -->
                    <ListBox IsVisible="{Binding Dashboard.SelectedBottomTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=1}"
                             ItemsSource="{Binding Dashboard.DebugLog}"
                             Background="Transparent" BorderThickness="0" Padding="6">
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                          <Setter Property="Padding" Value="2,1"/>
                          <Setter Property="Background" Value="Transparent"/>
                          <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                          <Setter Property="FontSize" Value="10"/>
                        </Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntry">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss.fff}'}" Foreground="#475569"/>
                            <TextBlock IsVisible="{Binding Source, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"
                                       Text="{Binding Source, StringFormat='({0})'}" Foreground="#64748B"/>
                            <TextBlock Text="{Binding Message}" Foreground="#8B9DB8"/>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Problems: real errors from session output; clearable -->
                    <DockPanel IsVisible="{Binding Dashboard.SelectedBottomTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=2}">
                      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="8,4,8,0">
                        <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="#64748B"
                                   Text="{Binding Dashboard.ProblemCount, StringFormat='会话输出中的 error / exception / 非零退出:{0} 条'}"/>
                        <Button Grid.Column="1" Content="清空" FontSize="10" Padding="10,2"
                                Background="#1A2030" Foreground="#94A3B8" CornerRadius="6" BorderThickness="0"
                                IsVisible="{Binding Dashboard.HasProblems}"
                                Command="{Binding Dashboard.ClearProblemsCommand}"/>
                      </Grid>
                      <TextBlock DockPanel.Dock="Top" Margin="8,4,8,0" FontSize="10" Foreground="#64748B"
                                 IsVisible="{Binding !Dashboard.HasProblems}"
                                 Text="暂无问题 —— 会话输出中的错误会出现在这里"/>
                    <ListBox ItemsSource="{Binding Dashboard.Problems}"
                             Background="Transparent" BorderThickness="0" Padding="6">
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                          <Setter Property="Padding" Value="2,1"/>
                          <Setter Property="Background" Value="Transparent"/>
                          <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                          <Setter Property="FontSize" Value="10"/>
                        </Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntry">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Level, StringFormat='[{0}]'}"
                                       Foreground="{Binding Level, Converter={x:Static vm:LogLevelConverter.Instance}}"/>
                            <TextBlock Text="{Binding Message}" Foreground="#CBD5E1"/>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    </DockPanel>

                    <!-- Search: filter active-session scrollback+screen, matched terms highlighted -->
                    <Grid IsVisible="{Binding Dashboard.SelectedBottomTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=3}"
                          RowDefinitions="Auto,Auto,*">
                      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="8,6,8,0">
                        <TextBox Text="{Binding Dashboard.SearchQuery}"
                                 Watermark="在当前会话中搜索…" FontSize="11"
                                 Background="#1A2030" BorderBrush="#2A3142" Foreground="#E2E8F0"
                                 CornerRadius="6" Padding="8,4"/>
                        <TextBlock Grid.Column="1" Text="{Binding Dashboard.SearchStatus}"
                                   Foreground="#64748B" FontSize="10" Margin="10,0"
                                   VerticalAlignment="Center" MinWidth="70"/>
                      </Grid>
                      <TextBlock Grid.Row="1" Text="作用域: 当前活动会话 scrollback + 屏幕"
                                 Foreground="#475569" FontSize="9" Margin="10,4,0,2"/>
                      <ListBox Grid.Row="2" ItemsSource="{Binding Dashboard.SearchHits}"
                               Background="Transparent" BorderThickness="0" Padding="6">
                        <ListBox.Styles>
                          <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="2,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                            <Setter Property="FontSize" Value="10"/>
                          </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding Line, StringFormat='L{0}'}" Foreground="#475569" MinWidth="40"/>
                              <ctl:HighlightTextBlock LineText="{Binding Text}" Foreground="#CBD5E1"
                                                    Query="{Binding $parent[ListBox].DataContext.Dashboard.SearchQuery}"/>
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </Grid>
                  </Panel>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <!-- ===== RIGHT: Processes/Files/Logs/SSH/Codex ===== -->
        <Border Grid.Column="4" CornerRadius="14"
                Background="#66131A28" BorderBrush="#332A3142" BorderThickness="1">
          <Grid RowDefinitions="34,*" Margin="6">

            <ListBox Grid.Row="0" SelectedIndex="{Binding SelectedRightTab}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="10,4"/>
                  <Setter Property="Margin" Value="0,3"/>
                  <Setter Property="CornerRadius" Value="6"/>
                  <Setter Property="FontSize" Value="11"/>
                  <Setter Property="Foreground" Value="#94A3B8"/>
                  <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem:selected">
                  <Setter Property="Background" Value="#3B82F6"/>
                  <Setter Property="Foreground" Value="#FFFFFF"/>
                </Style>
              </ListBox.Styles>
              <ListBoxItem>Processes</ListBoxItem>
              <ListBoxItem>Files</ListBoxItem>
              <ListBoxItem>Logs</ListBoxItem>
              <ListBoxItem>SSH</ListBoxItem>
              <ListBoxItem>Codex</ListBoxItem>
            </ListBox>

            <Panel Grid.Row="1" Margin="0,4,0,0">
              <!-- ===== Processes + System Monitor ===== -->
              <Grid IsVisible="{Binding SelectedRightTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=0}"
                    RowDefinitions="*,Auto">
                <Grid RowDefinitions="Auto,*">
                  <Grid ColumnDefinitions="50,*,70,70" Margin="6,4">
                    <TextBlock Text="PID" FontSize="10" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="NAME" FontSize="10" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="CPU" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="MEM" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                  </Grid>
                  <ListBox Grid.Row="1" ItemsSource="{Binding Dashboard.Processes}"
                           Background="Transparent" BorderThickness="0">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="6,3"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="CornerRadius" Value="6"/>
                        <Setter Property="Background" Value="#19131A28"/>
                        <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                        <Setter Property="FontSize" Value="10.5"/>
                      </Style>
                      <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="#3B233246"/>
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="mon:ProcessInfo">
                        <Grid ColumnDefinitions="50,*,70,70">
                          <TextBlock Text="{Binding Pid}" Foreground="#94A3B8"/>
                          <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#E2E8F0"/>
                          <TextBlock Grid.Column="2" Text="{Binding CpuPercent, StringFormat='{}{0:0.0}%'}"
                                     Foreground="#34D399" HorizontalAlignment="Right"/>
                          <TextBlock Grid.Column="3" Text="{Binding MemoryBytes, Converter={x:Static vm:BytesConverter.Instance}}"
                                     Foreground="#94A3B8" HorizontalAlignment="Right"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>

                <!-- System Monitor widgets -->
                <Border Grid.Row="1" CornerRadius="10" Background="#99131A28"
                        BorderBrush="#332A3142" BorderThickness="1" Padding="8" Margin="0,6,0,0">
                  <StackPanel Spacing="8">
                    <TextBlock Text="System Monitor" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    <Grid ColumnDefinitions="*,10,*">
                      <Border CornerRadius="8" Background="#CC141B29" Padding="8">
                        <Grid RowDefinitions="Auto,Auto,*">
                          <TextBlock Text="CPU" FontSize="10" Foreground="#64748B"/>
                          <TextBlock Grid.Row="1" Text="{Binding Dashboard.CpuPercent}" FontSize="18"
                                     FontWeight="SemiBold" Foreground="#E2E8F0"/>
                          <ctl:SparklineControl Grid.Row="2" Values="{Binding Dashboard.CpuSpark}"
                                                Stroke="#3B82F6" Fill="#333B82F6" Height="34" Margin="0,4,0,0"/>
                        </Grid>
                      </Border>
                      <Border Grid.Column="2" CornerRadius="8" Background="#CC141B29" Padding="8">
                        <Grid RowDefinitions="Auto,Auto,*">
                          <TextBlock Text="Memory" FontSize="10" Foreground="#64748B"/>
                          <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding Dashboard.MemUsage}" FontSize="18" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                            <TextBlock Text="{Binding Dashboard.MemTotal}" FontSize="10" Foreground="#64748B"
                                       VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                          </StackPanel>
                          <ctl:SparklineControl Grid.Row="2" Values="{Binding Dashboard.MemSpark}"
                                                Stroke="#A78BFA" Fill="#33A78BFA" Height="34" Margin="0,4,0,0"/>
                        </Grid>
                      </Border>
                    </Grid>
                    <Grid ColumnDefinitions="*,10,*">
                      <Border CornerRadius="8" Background="#CC141B29" Padding="8">
                        <StackPanel Spacing="4">
                          <TextBlock Text="Disk" FontSize="10" Foreground="#64748B"/>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Dashboard.DiskUsage}" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                          </StackPanel>
                          <ProgressBar Value="{Binding Dashboard.DiskFraction}" Minimum="0" Maximum="1"
                                       Height="6" CornerRadius="3" Foreground="#34D399" Background="#1A2030"/>
                          <TextBlock Text="{Binding Dashboard.DiskPercent}" FontSize="9" Foreground="#64748B" HorizontalAlignment="Right"/>
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="2" CornerRadius="8" Background="#CC141B29" Padding="8">
                        <Grid RowDefinitions="Auto,*,*">
                          <TextBlock Text="Network" FontSize="10" Foreground="#64748B"/>
                          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Dashboard.NetDown}" FontSize="11" Foreground="#34D399"/>
                            <ctl:SparklineControl Values="{Binding Dashboard.NetDownSpark}" Stroke="#34D399"
                                                  Width="60" Height="16" VerticalAlignment="Center" MaxValue="20"/>
                          </StackPanel>
                          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Dashboard.NetUp}" FontSize="11" Foreground="#38BDF8"/>
                            <ctl:SparklineControl Values="{Binding Dashboard.NetUpSpark}" Stroke="#38BDF8"
                                                  Width="60" Height="16" VerticalAlignment="Center" MaxValue="20"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- ===== Files ===== -->
              <Grid IsVisible="{Binding SelectedRightTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=1}"
                    RowDefinitions="Auto,Auto,5*,Auto,4*">
                <!-- toolbar: up + breadcrumb + refresh + session dir -->
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,2,0,4">
                  <Button Content="↑" Padding="8,2" CornerRadius="6" Background="#1A2030"
                          Foreground="#94A3B8" BorderBrush="#2A3142"
                          IsEnabled="{Binding Files.CanGoUp}"
                          Command="{Binding Files.UpCommand}" ToolTip.Tip="上一级"/>
                  <ScrollViewer Grid.Column="1" Margin="6,0" VerticalAlignment="Center"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Files.Breadcrumbs}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilesViewModel+Crumb">
                          <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Content="{Binding Label}" Padding="4,1" FontSize="10"
                                    Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                                    FontFamily="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Files.NavigateCrumbCommand}"
                                    CommandParameter="{Binding}">
                              <Button.Styles>
                                <Style Selector="Button:pointerover">
                                  <Setter Property="Foreground" Value="#38BDF8"/>
                                </Style>
                              </Button.Styles>
                            </Button>
                            <TextBlock Text="›" Foreground="#475569" FontSize="10" VerticalAlignment="Center"/>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <Button Grid.Column="2" Content="⟳" Padding="8,2" Margin="0,0,6,0" CornerRadius="6"
                          Background="#1A2030" Foreground="#94A3B8" BorderBrush="#2A3142"
                          Command="{Binding Files.RefreshCommand}" ToolTip.Tip="刷新"/>
                  <Button Grid.Column="3" Content="⌂" Padding="8,2" CornerRadius="6"
                          Background="#1A2030" Foreground="#38BDF8" BorderBrush="#2A3142"
                          Command="{Binding Files.GoToSessionDirCommand}" ToolTip.Tip="会话目录"/>
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding Files.StatusText}" Foreground="#F87171"
                           FontSize="9.5" Margin="2,0,0,2"
                           IsVisible="{Binding Files.StatusText, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>

                <!-- directory listing -->
                <Border Grid.Row="2" CornerRadius="8" Background="#CC141B29"
                        BorderBrush="#332A3142" BorderThickness="1">
                  <ListBox ItemsSource="{Binding Files.Entries}"
                           SelectedItem="{Binding Files.SelectedEntry}"
                           Background="Transparent" BorderThickness="0" Padding="4"
                           DoubleTapped="OnFileEntryDoubleTapped"
                           KeyDown="OnFilesListKeyDown">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="6,3"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="CornerRadius" Value="5"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="FontSize" Value="10.5"/>
                      </Style>
                      <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Background" Value="#22131A28"/>
                      </Style>
                      <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="#3B233246"/>
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="files:FileEntry">
                        <Grid ColumnDefinitions="14,*,Auto">
                          <TextBlock Text="▸" Foreground="#38BDF8" IsVisible="{Binding IsDirectory}"/>
                          <TextBlock Text="·" Foreground="#475569" IsVisible="{Binding !IsDirectory}"/>
                          <TextBlock Grid.Column="1" Margin="2,0,0,0" Text="{Binding Name}"
                                     Foreground="{Binding IsDirectory, Converter={x:Static vm:DirNameConverter.Instance}}"/>
                          <TextBlock Grid.Column="2" Text="{Binding SizeBytes, Converter={x:Static vm:BytesConverter.Instance}}"
                                     Foreground="#64748B" FontSize="9.5" HorizontalAlignment="Right"
                                     IsVisible="{Binding !IsDirectory}"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>

                <!-- preview header -->
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="2,6,2,2"
                      IsVisible="{Binding Files.HasPreview}">
                  <TextBlock Text="{Binding Files.PreviewTitle}" FontSize="10.5" FontWeight="SemiBold"
                             Foreground="#E2E8F0" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Files.PreviewMeta}" FontSize="9"
                             Foreground="#64748B" VerticalAlignment="Center"/>
                </Grid>

                <!-- preview pane -->
                <Border Grid.Row="4" CornerRadius="8" Background="#F20A0D14"
                        BorderBrush="#332A3142" BorderThickness="1" Padding="4"
                        IsVisible="{Binding Files.HasPreview}">
                  <TextBox Text="{Binding Files.PreviewText}" IsReadOnly="True"
                           AcceptsReturn="True" TextWrapping="NoWrap" BorderThickness="0"
                           Background="Transparent" Foreground="#CBD5E1" FontSize="9.5"
                           FontFamily="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Border>
                <Border Grid.Row="4" CornerRadius="8" Background="#CC141B29"
                        BorderBrush="#332A3142" BorderThickness="1"
                        IsVisible="{Binding !Files.HasPreview}">
                  <TextBlock Text="双击文件查看预览" Foreground="#475569" FontSize="10"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>

              <!-- ===== Logs ===== -->
              <Grid IsVisible="{Binding SelectedRightTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=2}"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
                <Grid.Styles>
                  <!-- exclusive level chips: same dark chip look as the toggles above -->
                  <Style Selector="ToggleButton.levelchip">
                    <Setter Property="Padding" Value="10,3"/>
                    <Setter Property="MinWidth" Value="44"/>
                    <Setter Property="CornerRadius" Value="6"/>
                    <Setter Property="Background" Value="#1A2030"/>
                    <Setter Property="BorderBrush" Value="#2A3142"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="FontSize" Value="10"/>
                  </Style>
                  <Style Selector="ToggleButton.levelchip:checked">
                    <Setter Property="Foreground" Value="#38BDF8"/>
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                  </Style>
                </Grid.Styles>
                <!-- filter row: text + regex toggle + file sink -->
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2,0,4">
                  <TextBox Text="{Binding Logs.FilterText}" Watermark="过滤日志…"
                           Background="#1A2030" CornerRadius="6" BorderBrush="#2A3142"
                           Foreground="#E2E8F0" Padding="8,3" FontSize="10.5"/>
                  <ToggleButton Grid.Column="1" Content=".*" Margin="4,0,0,0" Padding="6,3" MinWidth="30"
                                CornerRadius="6" Background="#1A2030" BorderBrush="#2A3142"
                                Foreground="#94A3B8" FontSize="10"
                                FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                                IsChecked="{Binding Logs.UseRegex}"
                                ToolTip.Tip="把过滤框内容当作正则表达式（忽略大小写）">
                    <ToggleButton.Styles>
                      <Style Selector="ToggleButton:checked">
                        <Setter Property="Foreground" Value="#38BDF8"/>
                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                      </Style>
                    </ToggleButton.Styles>
                  </ToggleButton>
                  <ToggleButton Grid.Column="2" Content="⬇ 写文件" Margin="6,0,0,0" Padding="8,3"
                                CornerRadius="6" Background="#1A2030" BorderBrush="#2A3142"
                                Foreground="#94A3B8" FontSize="10"
                                IsChecked="{Binding Logs.FileLogging}"
                                ToolTip.Tip="将会话输出写入本地日志文件">
                    <ToggleButton.Styles>
                      <Style Selector="ToggleButton:checked">
                        <Setter Property="Foreground" Value="#38BDF8"/>
                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                      </Style>
                    </ToggleButton.Styles>
                  </ToggleButton>
                </Grid>
                <!-- level filter: exclusive chip bar (全部/info/warn/error) -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                  <ToggleButton Classes="levelchip" Content="全部"
                                IsChecked="{Binding Logs.LevelAllSelected}"
                                ToolTip.Tip="显示所有级别 / show all levels"/>
                  <ToggleButton Classes="levelchip" Content="info" Margin="4,0,0,0"
                                IsChecked="{Binding Logs.LevelInfoSelected}"
                                ToolTip.Tip="只看 info 级行"/>
                  <ToggleButton Classes="levelchip" Content="warn" Margin="4,0,0,0"
                                IsChecked="{Binding Logs.LevelWarnSelected}"
                                ToolTip.Tip="只看 warn 级行"/>
                  <ToggleButton Classes="levelchip" Content="error" Margin="4,0,0,0"
                                IsChecked="{Binding Logs.LevelErrorSelected}"
                                ToolTip.Tip="只看 error 级行"/>
                </StackPanel>
                <!-- session filter -->
                <ComboBox Grid.Row="2" ItemsSource="{Binding Logs.SessionNames}"
                          SelectedIndex="{Binding Logs.SessionFilterIndex}"
                          Background="#1A2030" BorderBrush="#2A3142" FontSize="10"
                          CornerRadius="6" Padding="8,2" Margin="0,0,0,4"
                          VerticalAlignment="Center"/>
                <!-- actions: match nav / copy visible / export / clear results / retain history -->
                <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,4">
                  <Button Content="▲ 上一条" Padding="8,3" CornerRadius="6"
                          Background="#1A2030" BorderBrush="#2A3142" Foreground="#94A3B8"
                          FontSize="10" Command="{Binding Logs.GoPrevMatchCommand}"
                          IsEnabled="{Binding Logs.CanGoPrevMatch}"
                          ToolTip.Tip="选中上一条匹配行（需要过滤词；到头即停，不循环）"/>
                  <Button Content="▼ 下一条" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                          Background="#1A2030" BorderBrush="#2A3142" Foreground="#94A3B8"
                          FontSize="10" Command="{Binding Logs.GoNextMatchCommand}"
                          IsEnabled="{Binding Logs.CanGoNextMatch}"
                          ToolTip.Tip="选中下一条匹配行并滚动到它（暂停跟随尾部）；到头即停，不循环"/>
                  <Button Content="⧉ 复制可见行" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                          Background="#1A2030" BorderBrush="#2A3142" Foreground="#94A3B8"
                          FontSize="10" Command="{Binding Logs.CopyVisibleCommand}"
                          ToolTip.Tip="复制当前过滤结果到剪贴板"/>
                  <Button Content="⬇ 导出" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                          Background="#1A2030" BorderBrush="#2A3142" Foreground="#94A3B8"
                          FontSize="10" Command="{Binding Logs.ExportVisibleCommand}"
                          ToolTip.Tip="把当前过滤后的可见行一次性导出为 .log / .txt 文件（与「⬇ 写文件」实时写入无关）"/>
                  <Button Content="✕ 清空结果" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                          Background="#1A2030" BorderBrush="#2A3142" Foreground="#94A3B8"
                          FontSize="10" Command="{Binding Logs.ClearVisibleCommand}"
                          ToolTip.Tip="清除当前过滤结果（从缓冲中移除，不再出现）"/>
                  <ToggleButton Content="📌 保留历史" Margin="6,0,0,0" Padding="8,3" CornerRadius="6"
                                Background="#1A2030" BorderBrush="#2A3142" Foreground="#94A3B8"
                                FontSize="10" IsChecked="{Binding Logs.RetainHistoryOnClear}"
                                ToolTip.Tip="开启后：底部 Output 清空时 Logs 保留已缓冲历史；默认跟随清空">
                    <ToggleButton.Styles>
                      <Style Selector="ToggleButton:checked">
                        <Setter Property="Foreground" Value="#38BDF8"/>
                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                      </Style>
                    </ToggleButton.Styles>
                  </ToggleButton>
                </WrapPanel>
                <!-- invalid-regex hint -->
                <TextBlock Grid.Row="4" Text="{Binding Logs.FilterError}" Foreground="#F87171"
                           FontSize="9.5" Margin="2,0,2,3" TextWrapping="Wrap"
                           IsVisible="{Binding Logs.FilterError, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>

                <!-- log lines -->
                <Border Grid.Row="5" CornerRadius="8" Background="#CC141B29"
                        BorderBrush="#332A3142" BorderThickness="1">
                  <Panel>
                    <ListBox x:Name="LogsList" ItemsSource="{Binding Logs.Entries}"
                             SelectedIndex="{Binding Logs.SelectedIndex, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="4">
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                          <Setter Property="Padding" Value="4,1"/>
                          <Setter Property="Background" Value="Transparent"/>
                          <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                          <Setter Property="FontSize" Value="9.5"/>
                        </Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntry">
                          <!-- Message and Source reuse the Search tab's highlighter:
                               literal case-insensitive, or regex when the .* toggle is on. -->
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}" Foreground="#64748B"/>
                            <TextBlock Text="{Binding Level, StringFormat='[{0}]'}"
                                       Foreground="{Binding Level, Converter={x:Static vm:LogLevelConverter.Instance}}"/>
                            <ctl:HighlightTextBlock LineText="{Binding Source, StringFormat='({0})'}" Foreground="#7C8AA5"
                                                    Query="{Binding $parent[ListBox].DataContext.Logs.FilterText}"
                                                    UseRegex="{Binding $parent[ListBox].DataContext.Logs.UseRegex}"
                                                    IsVisible="{Binding Source, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
                            <ctl:HighlightTextBlock LineText="{Binding Message}" Foreground="#CBD5E1" TextWrapping="Wrap"
                                                    Query="{Binding $parent[ListBox].DataContext.Logs.FilterText}"
                                                    UseRegex="{Binding $parent[ListBox].DataContext.Logs.UseRegex}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- follow paused: floats over the list until resumed -->
                    <Button Content="⬇ 跟随" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,10,10" Padding="10,4" CornerRadius="8"
                            Background="#E61A2030" BorderBrush="#3B82F6" BorderThickness="1"
                            Foreground="#38BDF8" FontSize="10"
                            Command="{Binding Logs.ResumeFollowCommand}"
                            IsVisible="{Binding Logs.FollowPaused}"
                            ToolTip.Tip="新行不再自动滚动；点击恢复跟随（或滚回底部）"/>
                  </Panel>
                </Border>

                <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="10" Margin="2,4,2,0">
                  <TextBlock Text="{Binding Logs.FileStatus}" Foreground="#34D399"
                             FontSize="9" TextWrapping="Wrap"
                             IsVisible="{Binding Logs.FileStatus, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
                  <TextBlock Text="{Binding Logs.StatusText}" Foreground="#94A3B8"
                             FontSize="9" TextWrapping="Wrap"
                             IsVisible="{Binding Logs.StatusText, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
                </StackPanel>
              </Grid>

              <!-- ===== SSH ===== -->
              <Grid IsVisible="{Binding SelectedRightTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=3}"
                    RowDefinitions="Auto,*,Auto">
                <!-- edit form -->
                <Border CornerRadius="8" Background="#CC141B29" BorderBrush="#332A3142"
                        BorderThickness="1" Padding="8" Margin="0,2,0,6">
                  <StackPanel Spacing="6">
                    <TextBlock Text="新建 / 编辑连接" FontSize="10.5" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    <Grid ColumnDefinitions="*,*">
                      <TextBox Text="{Binding Ssh.EditName}" Watermark="名称 (可选)"
                               Background="#1A2030" CornerRadius="6" BorderBrush="#2A3142"
                               Foreground="#E2E8F0" Padding="8,3" FontSize="10.5"/>
                      <TextBox Grid.Column="1" Text="{Binding Ssh.EditUser}" Watermark="用户"
                               Background="#1A2030" CornerRadius="6" BorderBrush="#2A3142"
                               Foreground="#E2E8F0" Padding="8,3" FontSize="10.5" Margin="6,0,0,0"/>
                    </Grid>
                    <TextBox Text="{Binding Ssh.EditHost}" Watermark="主机 host / IP"
                             Background="#1A2030" CornerRadius="6" BorderBrush="#2A3142"
                             Foreground="#E2E8F0" Padding="8,3" FontSize="10.5"
                             FontFamily="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox Text="{Binding Ssh.EditPort}" Watermark="端口"
                               Background="#1A2030" CornerRadius="6" BorderBrush="#2A3142"
                               Foreground="#E2E8F0" Padding="8,3" FontSize="10.5"/>
                      <Button Grid.Column="1" Content="＋ 添加/更新" Margin="6,0,0,0" Padding="10,3"
                              CornerRadius="6" Background="#3B82F6" Foreground="White" FontSize="10"
                              Command="{Binding Ssh.AddOrUpdateCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding Ssh.StatusText}" FontSize="9.5" TextWrapping="Wrap"
                               Foreground="#FBBF24"
                               IsVisible="{Binding Ssh.StatusText, Converter={x:Static vm:StringNotEmptyConverter.Instance}}"/>
                  </StackPanel>
                </Border>

                <!-- saved hosts -->
                <Border Grid.Row="1" CornerRadius="8" Background="#CC141B29"
                        BorderBrush="#332A3142" BorderThickness="1">
                  <ListBox ItemsSource="{Binding Ssh.Hosts}" SelectedItem="{Binding Ssh.Selected}"
                           Background="Transparent" BorderThickness="0" Padding="4">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="CornerRadius" Value="6"/>
                        <Setter Property="Background" Value="Transparent"/>
                      </Style>
                      <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Background" Value="#22131A28"/>
                      </Style>
                      <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="#3B233246"/>
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="ssh:SshHost">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="10.5" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                            <TextBlock Text="{Binding CommandLine}" FontSize="9" Foreground="#64748B"
                                       FontFamily="Cascadia Code, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                          </StackPanel>
                          <Button Grid.Column="1" Content="连接" Padding="8,2" Margin="6,0,0,0"
                                  CornerRadius="5" Background="#26303F" Foreground="#38BDF8"
                                  BorderBrush="#2A3142" FontSize="10"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Ssh.ConnectCommand}"
                                  CommandParameter="{Binding}"/>
                          <Button Grid.Column="2" Content="✕" Padding="6,2" Margin="4,0,0,0"
                                  CornerRadius="5" Background="Transparent" Foreground="#64748B"
                                  BorderThickness="0" FontSize="10"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Ssh.RemoveCommand}"
                                  CommandParameter="{Binding}"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>

                <TextBlock Grid.Row="2" FontSize="9" Foreground="#475569" Margin="2,6,2,0"
                           TextWrapping="Wrap"
                           Text="连接使用本机 ssh 命令:密码 / 密钥确认直接在终端会话中完成;密钥建议用 ssh-agent 或 ~/.ssh/config。"/>
              </Grid>

              <!-- ===== Codex assistant ===== -->
              <Grid IsVisible="{Binding SelectedRightTab, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=4}"
                    RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                <Grid ColumnDefinitions="*,Auto" Margin="2,2">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="22" Height="22" CornerRadius="6" Background="#26303F">
                      <TextBlock Text="⌘" FontSize="12" Foreground="#38BDF8"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Codex 助手" FontWeight="SemiBold" FontSize="13" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="⚙" Background="Transparent" BorderThickness="0" Foreground="#64748B"
                          ToolTip.Tip="设置" Command="{Binding DockSelectCommand}" CommandParameter="5"/>
                </Grid>

                <Border Grid.Row="1" CornerRadius="8" Background="#CC141B29" Padding="8" Margin="0,4">
                  <TextBlock Text="{Binding Assistant.StatusText}" FontSize="11" Foreground="#CBD5E1"
                             TextWrapping="Wrap" LineHeight="16"/>
                </Border>

                <StackPanel Grid.Row="2" Spacing="5" Margin="0,2">
                  <ItemsControl ItemsSource="{Binding Assistant.Checklist}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="ai:ChecklistItem">
                        <Button Background="Transparent" BorderThickness="0" Padding="0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand"
                                Command="{Binding $parent[ItemsControl].DataContext.Assistant.ToggleItemCommand}"
                                CommandParameter="{Binding}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="14" Height="14" VerticalAlignment="Center"
                                     Stroke="{Binding State, Converter={x:Static vm:ChecklistRingConverter.Instance}}"
                                     StrokeThickness="1.5"
                                     Fill="{Binding State, Converter={x:Static vm:ChecklistFillConverter.Instance}}"/>
                            <TextBlock Text="{Binding Text}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{Binding State, Converter={x:Static vm:ChecklistTextConverter.Instance}}"/>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <ScrollViewer Grid.Row="3" MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,2"
                              IsVisible="{Binding Assistant.HasMessages}">
                  <ItemsControl ItemsSource="{Binding Assistant.Messages}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="ai:ChatMessage">
                        <Grid ColumnDefinitions="42,*" Margin="0,1">
                          <TextBlock Text="{Binding Sender}" FontSize="9" Foreground="#38BDF8" VerticalAlignment="Top"/>
                          <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="10" Foreground="#CBD5E1"
                                     TextWrapping="Wrap"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <DockPanel Grid.Row="4" Margin="0,6,0,0">
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                    <TextBlock Text="建议任务" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                    <Border Grid.Column="1" CornerRadius="6" Background="#1A2030" Padding="8,2">
                      <TextBlock Text="点击加入清单" FontSize="10" Foreground="#94A3B8"/>
                    </Border>
                  </Grid>
                  <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding Assistant.Suggestions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ai:SuggestedTask">
                          <Button Background="Transparent" BorderThickness="0" Padding="0"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand"
                                  Command="{Binding $parent[ItemsControl].DataContext.Assistant.RunSuggestionCommand}"
                                  CommandParameter="{Binding}">
                            <Border CornerRadius="8" Background="#CC141B29" BorderBrush="#332A3142"
                                    BorderThickness="1" Padding="8" Margin="0,0,0,6">
                              <Grid ColumnDefinitions="Auto,*">
                                <Border Width="24" Height="24" CornerRadius="6" Background="#26303F" VerticalAlignment="Top">
                                  <TextBlock Text="{Binding Icon}" FontSize="11" Foreground="#38BDF8"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="1">
                                  <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                  <TextBlock Text="{Binding Description}" FontSize="9.5" Foreground="#64748B" TextWrapping="Wrap"/>
                                </StackPanel>
                              </Grid>
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>

                <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                  <TextBox Text="{Binding Assistant.TaskInput}" Watermark="描述你想做的任务…"
                           Background="#1A2030" CornerRadius="8" BorderBrush="#2A3142" BorderThickness="1"
                           Foreground="#E2E8F0" Padding="10,5" FontSize="11"
                           KeyDown="OnAssistantInputKeyDown"/>
                  <Button Grid.Column="1" Content="➤" Margin="6,0,0,0" Width="34" CornerRadius="8"
                          Background="#26303F" Foreground="#38BDF8" BorderBrush="#2A3142"
                          Command="{Binding Assistant.SubmitTaskCommand}"/>
                </Grid>
              </Grid>
            </Panel>
          </Grid>
        </Border>
      </Grid>

      <!-- ============ Status bar ============ -->
      <Border Grid.Row="2" Background="#B3121724" Padding="12,0">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="▦" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
              <TextBlock Text="工作空间" Foreground="#94A3B8" FontSize="11"/>
              <TextBlock Text="{Binding WorkspaceName}" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock Text="{Binding TerminalCount, StringFormat='◔ {0} 个终端'}" Foreground="#94A3B8" FontSize="11"/>
            <TextBlock Text="{Binding RunningCount, StringFormat='⊕ {0} 个运行中'}" Foreground="#94A3B8" FontSize="11"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <TextBlock Text="{Binding CpuText}" Foreground="#94A3B8" FontSize="11"/>
            <TextBlock Text="{Binding MemText}" Foreground="#94A3B8" FontSize="11"/>
            <ctl:SparklineControl Values="{Binding StatusSpark}" Stroke="#3B82F6" Width="50" Height="14" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ============ Floating action dock ============ -->
    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"
            CornerRadius="16" Padding="6" ZIndex="100"
            Background="#D91B2333" BorderBrush="#403B82F6" BorderThickness="1"
            BoxShadow="0 8 30 0 #80000000">
      <Border.Styles>
        <Style Selector="Button.dock">
          <Setter Property="Padding" Value="12,6"/>
          <Setter Property="CornerRadius" Value="10"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Foreground" Value="#94A3B8"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.dock:pointerover">
          <Setter Property="Background" Value="#4026303F"/>
          <Setter Property="Foreground" Value="#E2E8F0"/>
        </Style>
        <Style Selector="Button.dock.dock-active">
          <Setter Property="Background" Value="#333B82F6"/>
          <Setter Property="BorderBrush" Value="#8038BDF8"/>
          <Setter Property="Foreground" Value="#E2F0FF"/>
        </Style>
      </Border.Styles>
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="primary" Padding="12,6" CornerRadius="10"
                Command="{Binding DockSelectCommand}" CommandParameter="0">
          <Button.Styles>
            <Style Selector="Button.primary">
              <Setter Property="Background" Value="#3B82F6"/>
              <Setter Property="Foreground" Value="White"/>
            </Style>
          </Button.Styles>
          <StackPanel>
            <TextBlock Text="▶" FontSize="13" HorizontalAlignment="Center"/>
            <TextBlock Text="New Session" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
          </StackPanel>
        </Button>
        <Button Classes="dock" Classes.dock-active="{Binding DockHighlight, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=1}"
                Command="{Binding DockSelectCommand}" CommandParameter="1">
          <StackPanel>
            <TextBlock Text="▥" FontSize="13" HorizontalAlignment="Center"/>
            <TextBlock Text="Monitor" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
          </StackPanel>
        </Button>
        <Button Classes="dock" Classes.dock-active="{Binding DockHighlight, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=2}"
                Command="{Binding DockSelectCommand}" CommandParameter="2">
          <StackPanel>
            <TextBlock Text="⌁" FontSize="13" HorizontalAlignment="Center"/>
            <TextBlock Text="SSH" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
          </StackPanel>
        </Button>
        <Button Classes="dock" Classes.dock-active="{Binding DockHighlight, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=3}"
                Command="{Binding DockSelectCommand}" CommandParameter="3">
          <StackPanel>
            <TextBlock Text="▤" FontSize="13" HorizontalAlignment="Center"/>
            <TextBlock Text="Logs" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
          </StackPanel>
        </Button>
        <!-- Click: open artifacts, or publish if none. Ctrl+click / right-click 重新打包: force republish.
             Right-click also switches publish profiles and opens recent artifacts. -->
        <Button x:Name="DeployDockButton" Classes="dock"
                Classes.dock-active="{Binding DockHighlight, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=4}"
                Command="{Binding DockSelectCommand}" CommandParameter="4"
                ToolTip.Tip="点击：有产物则打开目录，无产物则按当前配置档开始打包。Ctrl+点击或右键「重新打包」强制重新发布。右键可切换配置档、查看最近产物。">
          <Button.ContextFlyout>
            <MenuFlyout Opening="OnDeployMenuOpening">
              <MenuItem Header="重新打包 Republish" Click="OnRepublishMenuClick"/>
              <Separator/>
              <MenuItem Header="配置档 Profiles">
                <MenuItem Header="（无已存配置）" IsEnabled="False"/>
              </MenuItem>
              <MenuItem Header="保存当前配置 Save profile" Click="OnSavePublishProfileClick"/>
              <MenuItem Header="删除配置档 Delete profile">
                <MenuItem Header="（无已存配置）" IsEnabled="False"/>
              </MenuItem>
              <Separator/>
              <MenuItem Header="最近产物 Recent">
                <MenuItem Header="（暂无产物）" IsEnabled="False"/>
              </MenuItem>
            </MenuFlyout>
          </Button.ContextFlyout>
          <StackPanel>
            <TextBlock Text="☁" FontSize="13" HorizontalAlignment="Center"/>
            <TextBlock Text="Deploy" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
          </StackPanel>
        </Button>
        <Button Classes="dock" Classes.dock-active="{Binding DockHighlight, Converter={x:Static vm:IntEqualConverter.Instance}, ConverterParameter=5}"
                Command="{Binding DockSelectCommand}" CommandParameter="5">
          <StackPanel>
            <TextBlock Text="⚙" FontSize="13" HorizontalAlignment="Center"/>
            <TextBlock Text="Settings" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <!-- ============ Settings overlay ============ -->
    <Border IsVisible="{Binding SettingsOpen}"
            HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="320"
            Background="#E60F141F" BorderBrush="#332A3142" BorderThickness="1,0,0,0"
            Padding="16" CornerRadius="14,0,0,0">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="设置 Settings" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0"/>
          <Button Grid.Column="1" Content="✕" Background="Transparent" BorderThickness="0"
                  Foreground="#94A3B8" Command="{Binding DockSelectCommand}" CommandParameter="5"/>
        </Grid>

        <TextBlock Text="Shell" Foreground="#94A3B8" FontSize="11"/>
        <ComboBox SelectedIndex="{Binding ShellIndex}" HorizontalAlignment="Stretch"
                  Background="#1A2030" BorderBrush="#2A3142" CornerRadius="6" Padding="8,4">
          <ComboBoxItem>PowerShell (pwsh)</ComboBoxItem>
          <ComboBoxItem>cmd.exe</ComboBoxItem>
          <ComboBoxItem>WSL / bash</ComboBoxItem>
          <ComboBoxItem>bash</ComboBoxItem>
        </ComboBox>

        <TextBlock Text="自定义 Shell 路径" Foreground="#94A3B8" FontSize="11"/>
        <TextBox Text="{Binding Settings.CustomShellPath}" Watermark="C:\\…\\pwsh.exe"
                 Background="#1A2030" BorderBrush="#2A3142" Foreground="#E2E8F0"
                 CornerRadius="6" Padding="8,4" FontSize="11"/>

        <TextBlock Text="字体大小 Font size" Foreground="#94A3B8" FontSize="11"/>
        <TextBox Text="{Binding FontSize, Mode=TwoWay}"
                 Background="#1A2030" BorderBrush="#2A3142" Foreground="#E2E8F0"
                 CornerRadius="6" Padding="8,4" FontSize="11"/>

        <TextBlock Text="工作空间 Workspace" Foreground="#94A3B8" FontSize="11"/>
        <TextBox Text="{Binding WorkspaceNameLive}"
                 Background="#1A2030" BorderBrush="#2A3142" Foreground="#E2E8F0"
                 CornerRadius="6" Padding="8,4" FontSize="11"/>

        <TextBlock Text="主题 Theme" Foreground="#94A3B8" FontSize="11"/>
        <ComboBox SelectedIndex="0" HorizontalAlignment="Stretch"
                  Background="#1A2030" BorderBrush="#2A3142" CornerRadius="6" Padding="8,4">
          <ComboBoxItem>Dark Glass (默认)</ComboBoxItem>
        </ComboBox>

        <Button Content="保存 Save" Background="#3B82F6" Foreground="White" CornerRadius="8"
                Padding="10,7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Command="{Binding SaveSettingsCommand}"/>
      </StackPanel>
    </Border>
  </Panel>
</Window>
