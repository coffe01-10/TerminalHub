<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:Avalonia.Data.Converters" xmlns:views="using:TerminalHub.App.Views"
        x:Class="TerminalHub.App.Views.ProjectToolsWindow" x:CompileBindings="False"
        Title="工作区工具" Width="1040" Height="720" MinWidth="900" MinHeight="640"
        Icon="avares://TerminalHub/Assets/terminal-hub-icon.ico"
        FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif" FontSize="13"
        Background="{DynamicResource UiCanvas}" Foreground="{DynamicResource UiInk}">
  <Window.Resources>
    <StreamGeometry x:Key="RulesIcon">M2,2 H14 V14 H2 Z M4,4 V6 H12 V4 Z M4,8 V9 H12 V8 Z M4,11 V12 H9 V11 Z</StreamGeometry>
    <StreamGeometry x:Key="BroadcastIcon">M7,6 H9 V10 H7 Z M4,4 L5,5 A4,4 0 0 0 5,11 L4,12 A6,6 0 0 1 4,4 Z M12,4 A6,6 0 0 1 12,12 L11,11 A4,4 0 0 0 11,5 Z M1,1 L2,2 A9,9 0 0 0 2,14 L1,15 A11,11 0 0 1 1,1 Z M15,1 A11,11 0 0 1 15,15 L14,14 A9,9 0 0 0 14,2 Z</StreamGeometry>
    <StreamGeometry x:Key="TaskIcon">M2,2 H14 V14 H2 Z M4,5 L7,8 L4,11 L5,12 L9,8 L5,4 Z M9,11 H12 V12 H9 Z</StreamGeometry>
    <StreamGeometry x:Key="FolderIcon">M1,3 H7 L9,5 H15 V14 H1 Z M3,7 V12 H13 V7 Z</StreamGeometry>
    <StreamGeometry x:Key="RecordIcon">M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 M8,3 A5,5 0 1 1 8,13 A5,5 0 1 1 8,3 M8,5 A3,3 0 1 0 8,11 A3,3 0 1 0 8,5</StreamGeometry>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="23"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.caption"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource UiMuted}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Medium"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource UiSurface}"/><Setter Property="CornerRadius" Value="12"/></Style>
    <Style Selector="TextBox, ComboBox"><Setter Property="MinHeight" Value="36"/><Setter Property="FontSize" Value="13"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="10,7"/></Style>
    <Style Selector="CheckBox"><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="30"/></Style>
    <Style Selector="CheckBox /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource UiInk}"/></Style>
    <Style Selector="CheckBox /template/ Border#NormalRectangle"><Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/></Style>
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle, CheckBox:checked:pointerover /template/ Border#NormalRectangle, CheckBox:checked:pressed /template/ Border#NormalRectangle"><Setter Property="Background" Value="{DynamicResource UiAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource UiAccent}"/></Style>
    <Style Selector="CheckBox:checked /template/ Path#CheckGlyph, CheckBox:checked:pointerover /template/ Path#CheckGlyph, CheckBox:checked:pressed /template/ Path#CheckGlyph"><Setter Property="Fill" Value="{DynamicResource UiOnAccent}"/></Style>
    <Style Selector="Button"><Setter Property="Padding" Value="13,8"/><Setter Property="FontSize" Value="12"/><Setter Property="CornerRadius" Value="7"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource UiAccent}"/><Setter Property="Foreground" Value="{DynamicResource UiOnAccent}"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource UiAccent}"/><Setter Property="Opacity" Value="0.88"/><Setter Property="Foreground" Value="{DynamicResource UiOnAccent}"/></Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource UiAccent}"/><Setter Property="Opacity" Value="0.75"/></Style>
    <Style Selector="Button.quiet"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource UiMuted}"/></Style>
    <Style Selector="Button.quiet:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource UiRaised}"/><Setter Property="Foreground" Value="{DynamicResource UiInk}"/></Style>
    <Style Selector="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="10,10"/><Setter Property="Margin" Value="0,2"/><Setter Property="CornerRadius" Value="7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource UiRaised}"/></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource UiAccentSoft}"/></Style>
    <Style Selector="ListBox#ToolNavigation"><Setter Property="Padding" Value="12,0"/></Style>
    <Style Selector="ListBox#ToolNavigation ListBoxItem">
      <Setter Property="Padding" Value="14,13"/><Setter Property="Margin" Value="0,3"/><Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
      <Setter Property="Template"><ControlTemplate><Border x:Name="NavigationBackground" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Stretch"/></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="ListBox#ToolNavigation ListBoxItem:pointerover /template/ Border#NavigationBackground"><Setter Property="Background" Value="{DynamicResource UiRaised}"/></Style>
    <Style Selector="ListBox#ToolNavigation ListBoxItem:selected"><Setter Property="Foreground" Value="{DynamicResource UiAccent}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="ListBox#ToolNavigation ListBoxItem:selected /template/ Border#NavigationBackground"><Setter Property="Background" Value="{DynamicResource UiAccentSoft}"/></Style>
    <Style Selector="ListBox#ToolNavigation PathIcon"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/></Style>
    <Style Selector="TabControl#ToolsTabs TabItem"><Setter Property="Focusable" Value="False"/></Style>
    <Style Selector="StackPanel.empty"><Setter Property="Spacing" Value="9"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="MaxWidth" Value="320"/></Style>
    <Style Selector="StackPanel.empty TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="PathIcon.empty-icon"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Foreground" Value="{DynamicResource UiFaint}"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
  </Window.Styles>
  <Grid ColumnDefinitions="184,*" RowDefinitions="*,64">
    <Border Grid.RowSpan="2" Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Spacing="8" Margin="24,28,20,24">
          <TextBlock Text="TERMINAL HUB" FontSize="10" LetterSpacing="2" Foreground="{DynamicResource UiMuted}"/>
          <TextBlock Text="工作区工具" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding ActiveWorkspace.Name}" FontSize="12" Foreground="{DynamicResource UiAccent}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <ListBox x:Name="ToolNavigation" Grid.Row="1" SelectedIndex="{Binding SelectedIndex, ElementName=ToolsTabs, Mode=TwoWay}" AutomationProperties.Name="工作区工具导航">
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="12"><PathIcon Data="{StaticResource RulesIcon}"/><TextBlock Text="输出规则"/></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="12"><PathIcon Data="{StaticResource BroadcastIcon}"/><TextBlock Text="广播输入"/></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="12"><PathIcon Data="{StaticResource TaskIcon}"/><TextBlock Text="项目任务"/></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="12"><PathIcon Data="{StaticResource FolderIcon}"/><TextBlock Text="远程文件"/></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="12"><PathIcon Data="{StaticResource RecordIcon}"/><TextBlock Text="录制回放"/></StackPanel></ListBoxItem>
        </ListBox>
        <StackPanel Grid.Row="3" Margin="24,16,20,24" Spacing="5"><TextBlock Text="专注当前工作区" FontSize="11" Foreground="{DynamicResource UiMuted}"/><TextBlock Text="规则 · 自动化 · 协作" FontSize="10" Foreground="{DynamicResource UiFaint}"/></StackPanel>
      </Grid>
    </Border>
    <TabControl x:Name="ToolsTabs" Grid.Column="1" Margin="24,26,24,0" SelectedIndex="0">
      <TabControl.Template>
        <ControlTemplate><Grid>
          <!-- 保留容器生成，页面选择由左侧导航控制。隐藏的页签不参与键盘焦点。 -->
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Width="0" Height="0" Opacity="0" IsHitTestVisible="False" ClipToBounds="True"/>
          <ContentPresenter Name="PART_SelectedContentHost" Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid></ControlTemplate>
      </TabControl.Template>
      <TabItem Header="输出规则">
        <Grid RowDefinitions="Auto,*,160" RowSpacing="16">
          <StackPanel Spacing="6"><TextBlock Classes="title" Text="输出规则"/><TextBlock Classes="caption" Text="把重要输出标出来，让错误和关键信息一眼可见。"/></StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="184,*" ColumnSpacing="16">
            <Border Classes="card"><Grid RowDefinitions="Auto,*,Auto">
              <Grid ColumnDefinitions="*,Auto" Margin="14,10,8,4"><TextBlock Classes="label" Text="我的规则" VerticalAlignment="Center"/><Button Grid.Column="1" Content="＋" Classes="quiet" Padding="8,4" FontSize="18" Command="{Binding NewOutputRuleCommand}" ToolTip.Tip="新建输出规则" AutomationProperties.Name="新建输出规则"/></Grid>
              <Panel Grid.Row="1"><ListBox ItemsSource="{Binding OutputRules}" SelectedItem="{Binding SelectedOutputRule}"><ListBox.ItemTemplate><DataTemplate><StackPanel Spacing="5"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="Medium"/><TextBlock Text="{Binding MatchCount, StringFormat='命中 {0} 次'}" FontSize="11" Foreground="{DynamicResource UiMuted}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                <TextBlock Text="尚无规则" Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding OutputRules.Count, Converter={x:Static views:ProjectToolsWindow.IsEmpty}}" IsHitTestVisible="False"/>
              </Panel>
              <Button Grid.Row="2" Content="删除选中规则" Classes="quiet" Margin="8,4,8,8" HorizontalAlignment="Stretch" Command="{Binding DeleteOutputRuleCommand}" IsEnabled="{Binding SelectedOutputRule, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
            </Grid></Border>
            <Border Grid.Column="1" Classes="card" Padding="20,16">
              <Panel>
                <StackPanel x:Name="RuleEmptyState" Classes="empty" IsVisible="{Binding SelectedOutputRule, Converter={x:Static conv:ObjectConverters.IsNull}}">
                  <PathIcon Classes="empty-icon" Data="{StaticResource RulesIcon}"/><TextBlock Text="关注你在意的输出" FontSize="16" FontWeight="SemiBold"/><TextBlock Classes="caption" Text="添加关键字或正则表达式，自动高亮命中内容，也可以开启通知。"/><Button Content="＋ 新建第一条规则" Classes="primary" Command="{Binding NewOutputRuleCommand}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
                <ScrollViewer x:Name="RuleEditor" IsVisible="{Binding SelectedOutputRule, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="规则名称"/><TextBox Text="{Binding SelectedOutputRule.Name}" Watermark="例如：构建错误"/>
                    <TextBlock Classes="label" Text="匹配内容" Margin="0,4,0,0"/><TextBox Text="{Binding SelectedOutputRule.Pattern}" Watermark="关键字或正则表达式"/>
                    <WrapPanel><CheckBox Content="启用规则" IsChecked="{Binding SelectedOutputRule.Enabled}" Margin="0,0,16,0"/><CheckBox Content="正则表达式" IsChecked="{Binding SelectedOutputRule.IsRegex}" Margin="0,0,16,0"/><CheckBox Content="命中时通知" IsChecked="{Binding SelectedOutputRule.Notify}"/></WrapPanel>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><TextBlock Classes="label" Text="高亮颜色" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding SelectedOutputRule.Color}" Watermark="#RRGGBB"/></Grid>
                    <TextBlock Text="{Binding SelectedOutputRule.Error}" Foreground="{DynamicResource UiBad}" TextWrapping="Wrap" IsVisible="{Binding SelectedOutputRule.Error, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                    <Button Content="扫描工作区输出" Classes="primary" Command="{Binding ScanOutputRulesCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                  </StackPanel>
                </ScrollViewer>
              </Panel>
            </Border>
          </Grid>
          <Border Grid.Row="2" Classes="card"><Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,12"><TextBlock Classes="label" Text="匹配结果"/><TextBlock Grid.Column="1" Classes="caption" Text="双击结果，跳转到终端原文" Margin="14,0,0,0"/><TextBlock Grid.Column="2" Classes="caption" Text="{Binding OutputRuleResults.Count, StringFormat='{}{0} 条'}"/></Grid>
            <Panel Grid.Row="1"><ListBox ItemsSource="{Binding OutputRuleResults}" DoubleTapped="OnRuleLocate"><ListBox.ItemTemplate><DataTemplate><StackPanel Spacing="3"><TextBlock Text="{Binding SessionName}" Foreground="{DynamicResource UiAccent}" FontSize="11"/><TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
              <TextBlock Classes="caption" Text="扫描包含当前屏幕和历史记录，最多显示 200 条结果。" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0" IsVisible="{Binding OutputRuleResults.Count, Converter={x:Static views:ProjectToolsWindow.IsEmpty}}" IsHitTestVisible="False"/>
            </Panel>
          </Grid></Border>
        </Grid>
      </TabItem>
      <TabItem Header="广播输入">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
          <StackPanel Spacing="6"><TextBlock Classes="title" Text="广播输入"/><TextBlock Classes="caption" Text="一次输入，同步发送到你选中的多个终端。"/></StackPanel>
          <Border Grid.Row="1" Background="{DynamicResource UiAccentSoft}" CornerRadius="10" Padding="16,12"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><PathIcon Data="{StaticResource BroadcastIcon}" Width="18" Height="18" Foreground="{DynamicResource UiAccent}"/><TextBlock Grid.Column="1" Text="选择至少两个终端；开启后，键盘输入和粘贴都会同步发送。" Foreground="{DynamicResource UiAccent}" FontSize="12" TextWrapping="Wrap"/></Grid></Border>
          <Border Grid.Row="2" Classes="card"><Grid RowDefinitions="Auto,*">
            <TextBlock Classes="label" Text="选择接收输入的终端" Margin="18,16,18,8"/>
            <ListBox Grid.Row="1" ItemsSource="{Binding BroadcastTargets}"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"><StackPanel Spacing="4" Margin="6,0"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"/><TextBlock Text="{Binding Card.WorkingDirectory}" FontSize="11" Foreground="{DynamicResource UiMuted}" TextTrimming="CharacterEllipsis"/></StackPanel></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox>
          </Grid></Border>
          <Border Grid.Row="3" Classes="card" Padding="16"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="5" VerticalAlignment="Center"><TextBlock Text="{Binding BroadcastStatus}" Foreground="{DynamicResource UiAccent}" TextWrapping="Wrap"/><TextBlock Classes="caption" Text="按 Esc 可以立即停止广播。"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="停止广播" Classes="quiet" Command="{Binding StopBroadcastCommand}" IsVisible="{Binding BroadcastEnabled}"/><Button Content="开启广播" Classes="primary" Command="{Binding StartBroadcastCommand}" IsVisible="{Binding !BroadcastEnabled}"/></StackPanel></Grid></Border>
        </Grid>
      </TabItem>
      <TabItem Header="项目任务">
        <Grid RowDefinitions="Auto,*" RowSpacing="16">
          <StackPanel Spacing="6"><TextBlock Classes="title" Text="项目任务"/><TextBlock Classes="caption" Text="把构建、测试和常用命令保存下来，下次一键运行。"/></StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="184,*" ColumnSpacing="16">
            <Border Classes="card"><Grid RowDefinitions="Auto,*,Auto">
              <Grid ColumnDefinitions="*,Auto" Margin="14,10,8,4"><TextBlock Classes="label" Text="我的任务" VerticalAlignment="Center"/><Button Grid.Column="1" Content="＋" Classes="quiet" Padding="8,4" FontSize="18" Command="{Binding NewProjectTaskCommand}" ToolTip.Tip="新建项目任务" AutomationProperties.Name="新建项目任务"/></Grid>
              <Panel Grid.Row="1"><ListBox ItemsSource="{Binding ProjectTasks}" SelectedItem="{Binding SelectedProjectTask}"><ListBox.ItemTemplate><DataTemplate><StackPanel Spacing="5"><TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource UiMuted}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="尚无任务" Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ProjectTasks.Count, Converter={x:Static views:ProjectToolsWindow.IsEmpty}}" IsHitTestVisible="False"/></Panel>
              <Button Grid.Row="2" Content="删除选中任务" Classes="quiet" Margin="8,4,8,8" HorizontalAlignment="Stretch" Command="{Binding DeleteProjectTaskCommand}" IsEnabled="{Binding SelectedProjectTask, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
            </Grid></Border>
            <Border Grid.Column="1" Classes="card" Padding="20"><Panel>
              <StackPanel Classes="empty" IsVisible="{Binding SelectedProjectTask, Converter={x:Static conv:ObjectConverters.IsNull}}"><PathIcon Classes="empty-icon" Data="{StaticResource TaskIcon}"/><TextBlock Text="常用命令，随时就绪" FontSize="16" FontWeight="SemiBold"/><TextBlock Classes="caption" Text="选择一个终端，保存你经常执行的命令，运行状态会显示在这里。"/><Button Content="＋ 新建第一个任务" Classes="primary" Command="{Binding NewProjectTaskCommand}" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
              <ScrollViewer IsVisible="{Binding SelectedProjectTask, Converter={x:Static conv:ObjectConverters.IsNotNull}}"><StackPanel Spacing="8">
                <TextBlock Classes="label" Text="任务名称"/><TextBox Text="{Binding SelectedProjectTask.Name}" Watermark="例如：构建项目"/>
                <TextBlock Classes="label" Text="运行终端" Margin="0,6,0,0"/><ComboBox ItemsSource="{Binding ProjectTerminalNames}" SelectedItem="{Binding SelectedProjectTask.SessionName}" HorizontalAlignment="Stretch" PlaceholderText="选择一个 PowerShell / Bash 终端"/>
                <TextBlock Classes="label" Text="执行命令" Margin="0,6,0,0"/><TextBox Text="{Binding SelectedProjectTask.Command}" Watermark="dotnet build" AcceptsReturn="True" Height="128" FontFamily="Cascadia Mono, Consolas, monospace"/>
                <WrapPanel Margin="0,8,0,0"><Button Content="运行 / 重跑" Classes="primary" Command="{Binding RunProjectTaskCommand}" Margin="0,0,8,8"/><Button Content="停止" Command="{Binding StopProjectTaskCommand}" Margin="0,0,8,8"/><Button Content="查看终端" Classes="quiet" Command="{Binding ShowProjectTaskTerminalCommand}" Margin="0,0,0,8"/></WrapPanel>
                <TextBlock Text="{Binding SelectedProjectTask.Status}" Foreground="{DynamicResource UiAccent}" TextWrapping="Wrap"/><TextBlock Classes="caption" Text="状态与退出码来自终端。停止任务会向终端发送 Ctrl+C。"/>
              </StackPanel></ScrollViewer>
            </Panel></Border>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="远程文件">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
          <StackPanel Spacing="6"><TextBlock Classes="title" Text="远程文件"/><TextBlock Classes="caption" Text="浏览 SSH 主机上的文件，在本地与远程之间传输。"/></StackPanel>
          <Border Grid.Row="1" Classes="card" Padding="16"><Grid RowDefinitions="Auto,Auto" RowSpacing="12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16"><TextBlock Classes="label" Text="SSH 主机" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Ssh.Hosts}" SelectedItem="{Binding RemoteFiles.Host}" HorizontalAlignment="Stretch" PlaceholderText="选择已保存的 SSH 主机"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBox Text="{Binding RemoteFiles.Path}" Watermark="远程目录" FontFamily="Cascadia Mono, Consolas, monospace"/><Button Grid.Column="1" Content="打开 / 刷新" Command="{Binding RemoteFiles.RefreshCommand}"/><Button Grid.Column="2" Content="上一级" Classes="quiet" Command="{Binding RemoteFiles.UpCommand}"/></Grid>
          </Grid></Border>
          <Border Grid.Row="2" Classes="card"><Grid RowDefinitions="Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto" Margin="18,14"><TextBlock Classes="label" Text="名称"/><TextBlock Grid.Column="1" Classes="caption" Text="大小"/></Grid>
            <Panel Grid.Row="1"><ListBox ItemsSource="{Binding RemoteFiles.Entries}" SelectedItem="{Binding RemoteFiles.Selected}" DoubleTapped="OnRemoteDirectory"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><PathIcon Data="{StaticResource FolderIcon}" Width="16" Height="16" IsVisible="{Binding IsDirectory}" Foreground="{DynamicResource UiAccent}"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding Size, StringFormat='{}{0:N0} B'}" Foreground="{DynamicResource UiMuted}" FontSize="12"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
              <StackPanel Classes="empty" IsVisible="{Binding RemoteFiles.Entries.Count, Converter={x:Static views:ProjectToolsWindow.IsEmpty}}" IsHitTestVisible="False"><PathIcon Classes="empty-icon" Data="{StaticResource FolderIcon}"/><TextBlock Text="浏览远程目录" FontSize="16" FontWeight="SemiBold"/><TextBlock Classes="caption" Text="选择主机后打开目录，双击文件夹进入下一级。"/></StackPanel>
            </Panel>
            <WrapPanel Grid.Row="2" Margin="12,8,12,12"><Button Content="上传文件" Classes="primary" Click="OnUpload" Margin="0,0,8,4"/><Button Content="下载选中文件" Click="OnDownload" Margin="0,0,8,4"/><Button Content="在此打开终端" Classes="quiet" Command="{Binding RemoteFiles.OpenTerminalCommand}" Margin="0,0,8,4"/><Button Content="取消传输" Classes="quiet" Command="{Binding RemoteFiles.CancelCommand}" IsVisible="{Binding RemoteFiles.Busy}" Margin="0,0,0,4"/></WrapPanel>
          </Grid></Border>
          <StackPanel Grid.Row="3" Spacing="8"><ProgressBar Value="{Binding RemoteFiles.Progress}" Minimum="0" Maximum="100" Height="4" IsVisible="{Binding RemoteFiles.Busy}"/><TextBlock Classes="caption" Text="{Binding RemoteFiles.Status}"/></StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="录制回放">
        <ScrollViewer><StackPanel Spacing="16">
          <StackPanel Spacing="6" Margin="0,0,0,6"><TextBlock Classes="title" Text="录制回放"/><TextBlock Classes="caption" Text="留下终端操作的完整过程，随时回顾关键步骤。"/></StackPanel>
          <Border Classes="card" Padding="24"><StackPanel Spacing="16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"><Border Background="{DynamicResource UiAccentSoft}" CornerRadius="10" Padding="12"><PathIcon Data="{StaticResource RecordIcon}" Foreground="{DynamicResource UiAccent}" Width="22" Height="22"/></Border><StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center"><TextBlock Text="录制当前终端" FontSize="16" FontWeight="SemiBold"/><TextBlock Classes="caption" Text="{Binding ActiveSession.Name, StringFormat='当前会话 · {0}'}"/></StackPanel></Grid>
            <TextBlock Classes="caption" Text="保存终端输出、颜色和尺寸变化，生成可独立回放的录制文件。"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="开始录制" Classes="primary" Click="OnRecord" IsVisible="{Binding !IsRecordingCurrent}"/><Button Content="停止并保存" Classes="primary" Click="OnStopRecord" IsVisible="{Binding IsRecordingCurrent}"/></StackPanel>
            <Border Background="{DynamicResource UiInset}" CornerRadius="8" Padding="12"><TextBlock Text="{Binding RecordingStatus}" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" FontSize="12"/></Border>
          </StackPanel></Border>
          <Border Classes="card" Padding="24"><StackPanel Spacing="12"><TextBlock Text="回放已有录制" FontSize="16" FontWeight="SemiBold"/><TextBlock Classes="caption" Text="打开 .threc 文件，通过暂停、倍速与时间轴，定位你想看的片段。"/><Button Content="打开录制文件" Click="OnPlayback" HorizontalAlignment="Left"/><TextBlock Classes="caption" Text="回放在独立的只读终端中展示。"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <Grid Grid.Column="1" Grid.Row="1" ColumnDefinitions="*,Auto" Margin="24,12,24,12"><TextBlock Text="规则与任务会在关闭窗口时自动保存" Classes="caption" VerticalAlignment="Center"/><Button Grid.Column="1" Content="保存更改" Classes="primary" Command="{Binding SaveProjectToolsCommand}" VerticalAlignment="Center"/></Grid>
  </Grid>
</Window>
