<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:TerminalHub.App.Localization"
        x:Class="TerminalHub.App.Views.PublishProfileWindow"
        Title="{loc:Text M0772}"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource UiSurface}">
  <StackPanel Margin="20" Spacing="8">
    <TextBlock Text="{loc:Text M0773}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource UiInk}"/>
    <TextBlock Text="{loc:Text M0774}"
               Foreground="{DynamicResource UiMuted}" FontSize="11" TextWrapping="Wrap"/>

    <TextBlock Text="{loc:Text M0775}" Foreground="{DynamicResource UiMuted}" FontSize="11"/>
    <TextBox x:Name="NameBox" Watermark="{loc:Text M0776}"
             Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiInk}"
             CornerRadius="6" Padding="8,4" FontSize="12"/>

    <TextBlock Text="{loc:Text M0777}" Foreground="{DynamicResource UiMuted}" FontSize="11"/>
    <TextBox x:Name="RootBox" Watermark="{loc:Text M0778}"
             Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiInk}"
             CornerRadius="6" Padding="8,4" FontSize="12"/>

    <TextBlock Text="{loc:Text M0779}" Foreground="{DynamicResource UiMuted}" FontSize="11"/>
    <ComboBox Classes="localized" x:Name="RidBox" SelectedIndex="0" HorizontalAlignment="Stretch"
              Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" CornerRadius="6" Padding="8,4">
      <ComboBoxItem Tag="" Content="{loc:Text HostLanguage}"/>
      <ComboBoxItem Tag="linux-x64">linux-x64</ComboBoxItem>
      <ComboBoxItem Tag="win-x64">win-x64</ComboBoxItem>
    </ComboBox>

    <TextBlock Text="{loc:Text M0780}" Foreground="{DynamicResource UiMuted}" FontSize="11"/>
    <TextBox x:Name="NoteBox" Watermark="{loc:Text M0781}"
             Background="{DynamicResource UiRaised}" BorderBrush="{DynamicResource UiBorder}" Foreground="{DynamicResource UiInk}"
             CornerRadius="6" Padding="8,4" FontSize="12"/>

    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource UiBad}" FontSize="11" IsVisible="False"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Content="{loc:Text M0782}" Click="OnCancelClick" Padding="14,6" CornerRadius="8"/>
      <Button Content="{loc:Text M0387}" Click="OnSaveClick" Padding="14,6" CornerRadius="8"
              Background="{DynamicResource UiAccent}" Foreground="{DynamicResource UiOnAccent}"/>
    </StackPanel>
  </StackPanel>
</Window>
