<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>TerminalHub.App</RootNamespace>
    <AssemblyName>TerminalHub</AssemblyName>
    <Version>0.4.1</Version>
    <ApplicationIcon>Assets\terminal-hub-icon.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Content Include="..\..\docs\plugins\index.html" Link="docs\plugins\index.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\plugins\development-tutorial.html" Link="docs\plugins\development-tutorial.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\plugins\development-tutorial.en.html" Link="docs\plugins\development-tutorial.en.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.2" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TerminalHub.Core\TerminalHub.Core.csproj" />
    <ProjectReference Include="..\TerminalHub.Pty\TerminalHub.Pty.csproj" />
    <ProjectReference Include="..\TerminalHub.Extensibility\TerminalHub.Extensibility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <BundledPlugin Include="WorkspaceNotes;ScreenClips;CommandWatch;TerminalBroadcast;Snippets;ProjectNavigator;GitWorkbench" />
    <!-- Build plugin resources separately: transitive content would publish seven plugin.json files to the same path. -->
    <ProjectReference Include="@(BundledPlugin->'..\..\plugins\%(Identity)\%(Identity).csproj')" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile;IncludeNativeLibrariesForSelfExtract" />
  </ItemGroup>
  <Target Name="BundleOfficialPlugins" AfterTargets="Build">
    <Copy SourceFiles="@(BundledPlugin->'..\..\plugins\%(Identity)\bin\$(Configuration)\net8.0\TerminalHub.Official.%(Identity).dll')" DestinationFiles="@(BundledPlugin->'$(TargetDir)official-plugins\%(Identity)\TerminalHub.Official.%(Identity).dll')" />
    <Copy SourceFiles="@(BundledPlugin->'..\..\plugins\%(Identity)\bin\$(Configuration)\net8.0\TerminalHub.Official.%(Identity).deps.json')" DestinationFiles="@(BundledPlugin->'$(TargetDir)official-plugins\%(Identity)\TerminalHub.Official.%(Identity).deps.json')" />
    <Copy SourceFiles="@(BundledPlugin->'..\..\plugins\%(Identity)\plugin.json')" DestinationFiles="@(BundledPlugin->'$(TargetDir)official-plugins\%(Identity)\plugin.json')" />
  </Target>
  <Target Name="PublishOfficialPlugins" AfterTargets="Publish">
    <ItemGroup><OfficialPublishPayload Include="$(TargetDir)official-plugins\**\*" /></ItemGroup>
    <Copy SourceFiles="@(OfficialPublishPayload)" DestinationFolder="$(PublishDir)official-plugins\%(RecursiveDir)" />
  </Target>

</Project>
